@@ -545,6 +545,55 @@ fn raw_boundary(p: &Paragraph, offset: usize) -> u32 {
 
 /// 8-unit 마커를 넣거나 빼며 모든 raw UTF-16 참조 축을 함께 옮긴다.
 /// 첫 글자 서식의 0 anchor는 그대로 둔다. 표시 문자 인덱스는 변하지 않는다.
+#[cfg(test)]
+mod hwpcraft_link_end_tests {
+    use super::HyperlinkTarget;
+    use crate::document_core::DocumentCore;
+    use crate::model::control::{Control, FieldType};
+
+    fn links(core: &DocumentCore) -> Vec<(usize, usize)> {
+        let p = &core.document().sections[0].paragraphs[0];
+        p.field_ranges
+            .iter()
+            .filter(|r| {
+                matches!(p.controls.get(r.control_idx),
+                    Some(Control::Field(f)) if f.field_type == FieldType::Hyperlink)
+            })
+            .map(|r| (r.start_char_idx, r.end_char_idx))
+            .collect()
+    }
+
+    /// Text typed after a link that ends the paragraph goes after the link's end
+    /// slot, so a second link in the paragraph keeps its place in an HWPX save.
+    #[test]
+    fn two_links_typed_one_after_another_survive_an_hwpx_save() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        let target = HyperlinkTarget::body(0, 0);
+        core.insert_text_native(0, 0, 0, "앞 링크A").unwrap();
+        core.insert_hyperlink_native(&target, 2, 5, "https://a.example")
+            .unwrap();
+        core.insert_text_native(0, 0, 5, " 가운데 링크B").unwrap();
+        let offsets = &core.document().sections[0].paragraphs[0].char_offsets;
+        assert_eq!(offsets[5], offsets[4] + 1 + 8, "after the end slot");
+        core.insert_hyperlink_native(&target, 10, 13, "https://b.example")
+            .unwrap();
+        core.insert_text_native(0, 0, 13, " 끝").unwrap();
+        assert_eq!(links(&core), [(2, 5), (10, 13)]);
+        for bytes in [
+            core.export_hwpx_native().unwrap(),
+            core.export_hwp_native().unwrap(),
+        ] {
+            let reopened = DocumentCore::from_bytes(&bytes).unwrap();
+            assert_eq!(links(&reopened), [(2, 5), (10, 13)]);
+            assert_eq!(
+                reopened.document().sections[0].paragraphs[0].text,
+                "앞 링크A 가운데 링크B 끝"
+            );
+        }
+    }
+}
