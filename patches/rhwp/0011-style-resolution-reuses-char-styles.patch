+/// 글꼴 표가 필드 하나까지 같은가 (`Font` 에는 `PartialEq` 가 없다).
+pub(crate) fn same_font_faces(
+    a: &[Vec<crate::model::style::Font>],
+    b: &[Vec<crate::model::style::Font>],
+) -> bool {
+    use crate::model::style::Font;
+    let same_font = |a: &Font, b: &Font| {
+        a.raw_data == b.raw_data
+            && a.name == b.name
+            && a.alt_type == b.alt_type
+            && a.is_embedded == b.is_embedded
+            && a.bin_item_id_ref == b.bin_item_id_ref
+            && a.resolved_bin_data_id == b.resolved_bin_data_id
+            && a.alt_name == b.alt_name
+            && a.type_info == b.type_info
+            && a.default_name == b.default_name
+            && a.subst_font == b.subst_font
+    };
+    a.len() == b.len()
+        && a.iter()
+            .zip(b)
+            .all(|(a, b)| a.len() == b.len() && a.iter().zip(b).all(|(a, b)| same_font(a, b)))
+}
