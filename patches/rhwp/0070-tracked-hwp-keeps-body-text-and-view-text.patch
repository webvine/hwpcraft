+
+    /// [HwpCraft 0070] BodyText(결과본)와 ViewText(표시본)가 갈라진 문서(변경 추적)를
+    /// 손대지 않고 저장하면 BodyText 는 원본 내용 그대로, ViewText 는 원본 바이트 그대로
+    /// 쓴다. 구역을 고치면 그 구역의 ViewText 는 옛 내용이라 쓰지 않는다.
+    #[test]
+    fn hwp5_untouched_viewtext_section_keeps_body_text_and_view_text() {
+        use crate::document_core::DocumentCore;
+
+        let source = std::fs::read("samples/2010-01-06.hwp").expect("sample 존재");
+        let (_, body) = hwp5_doc_info_and_first_section(&source);
+        // 표시본: 첫 문단 앞에 글을 더해 RHWP 로 저장한 구역 0.
+        let mut core = DocumentCore::from_bytes(&source).expect("원본 열기");
+        core.insert_text_native(0, 0, 0, "표시본 ").expect("표시본 글 넣기");
+        let shown = core.export_hwp_native().expect("표시본 저장");
+        let (_, view) = hwp5_doc_info_and_first_section(&shown);
+        assert_ne!(view, body);
+        let view_raw = raw_deflate(&view);
+        let tracked = add_raw_streams(&source, &[("/ViewText/Section0", &view_raw)]);
+
+        let doc = parse_hwp(&tracked).expect("갈라진 문서 열기");
+        assert!(
+            doc.sections[0].paragraphs[0].text.starts_with("표시본 "),
+            "모델은 ViewText 로 읽는다"
+        );
+        let saved = crate::serializer::serialize_hwp(&doc).expect("그대로 저장");
+        let (_, saved_body) = hwp5_doc_info_and_first_section(&saved);
+        assert_eq!(saved_body, body, "BodyText 는 원본 결과본");
+        let mut cfb = cfb_reader::CfbReader::open(&saved).expect("저장본 CFB");
+        assert_eq!(
+            cfb.read_stream_raw("/ViewText/Section0")
+                .expect("저장본 ViewText"),
+            view_raw,
+            "ViewText 는 원본 바이트"
+        );
+        let reopened = parse_hwp(&saved).expect("저장본 다시 열기");
+        assert_eq!(
+            reopened.sections[0].paragraphs[0].text,
+            doc.sections[0].paragraphs[0].text
+        );
+
+        // 고친 구역: 모델로 다시 만든 BodyText 만 쓰고 옛 ViewText 는 뺀다.
+        let mut core = DocumentCore::from_bytes(&tracked).expect("갈라진 문서 열기");
+        core.insert_text_native(0, 0, 0, "고침 ").expect("고치기");
+        let edited = core.export_hwp_native().expect("고친 뒤 저장");
+        let mut cfb = cfb_reader::CfbReader::open(&edited).expect("고친 저장본 CFB");
+        assert!(cfb.read_stream_raw("/ViewText/Section0").is_err());
+        let reopened = parse_hwp(&edited).expect("고친 저장본 다시 열기");
+        assert!(reopened.sections[0].paragraphs[0]
+            .text
+            .starts_with("고침 표시본 "));
+    }
 }
diff --git a/src/serializer/cfb_writer.rs b/src/serializer/cfb_writer.rs
index 721a6ce..3b6a4c9 100644
--- a/src/serializer/cfb_writer.rs
+++ b/src/serializer/cfb_writer.rs
@@ -219,6 +219,24 @@ fn serialize_hwp_inner(
     let mut content_loss = ContentLossReport::new(SerializedFormat::Hwp);
     let mut extra_streams = doc.extra_streams.clone();
     extra_streams.retain(|(path, _)| path != crate::model::hyperlink_format::HWP_STREAM);
+    // [HwpCraft 0070] 원본 ViewText(변경 추적 등)는 그 구역을 원본 바이트로 다시 쓸 때만
+    // 함께 쓴다. 고친 구역의 BodyText 는 모델로 다시 만들어져 옛 ViewText 와 맞지 않고,
+    // 구역을 가른 경우에는 번호가 어긋난다.
+    let unchanged: Vec<bool> = doc
+        .sections
+        .iter()
+        .map(|section| section.raw_provenance_permits_reuse())
+        .collect();
+    let same_sections = section_bytes_list.len() == doc.sections.len();
+    extra_streams.retain(|(path, _)| {
+        let Some(index) = path
+            .strip_prefix("/ViewText/Section")
+            .and_then(|n| n.parse::<usize>().ok())
+        else {
+            return true;
+        };
+        same_sections && unchanged.get(index).copied().unwrap_or(false)
+    });
     if let Some(bytes) = crate::model::hyperlink_format::encode(doc) {
         extra_streams.push((crate::model::hyperlink_format::HWP_STREAM.into(), bytes));
     }
