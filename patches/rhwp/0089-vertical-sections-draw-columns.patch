+//! [HwpCraft 0089] 세로쓰기 구역의 본문 그리기.
+//!
+//! 세로 구역은 돌린 흐름 용지(`SectionDef::flow_page_def`)로 줄을 나누고 쪽을 나눈다
+//! (HwpCraft 0088). 쪽에 든 문단의 줄 범위를 차례로 받아, 줄 하나를 본문 오른쪽 끝에서
+//! 왼쪽으로 쌓이는 열 하나로 그린다. 열 안에서 글자는 위에서 아래로 놓이고, 글자마다
+//! [`vertical_char_advance`] 만큼 내려간다 — 줄 나눔이 쓰는 길이와 같다. 세워 그리는 글자
+//! (한글·한자, 영문 세움의 영문·숫자)는 열 가운데에, 눕혀 그리는 글자(영문 눕힘의 영문·숫자,
+//! 괄호·줄표 등)는 90도 돌려 그린다(세로 형태 문자가 있으면 그 문자). 표·그림·각주 같은
+//! 개체는 아직 그리지 않는다(README 한계).
+
+use super::super::composer::ComposedParagraph;
+use super::super::hwpunit_to_px;
+use super::super::page_layout::{LayoutRect, PageLayoutInfo};
+use super::super::pagination::{PageContent, PageItem};
+use super::super::render_tree::*;
+use super::super::style_resolver::ResolvedStyleSet;
+use super::text_measurement::{
+    is_cjk_char, is_vertical_rotate_char, vertical_char_advance, vertical_substitute_char,
+};
+use super::LayoutEngine;
+use crate::model::paragraph::Paragraph;
+
+/// 세로 구역 쪽의 열 하나: 어느 문단의 몇째 줄이고, 쪽 위에서 어디에 놓이는가.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub(crate) struct VerticalColumn {
+    pub para_index: usize,
+    pub line_index: usize,
+    /// 열 왼쪽 x 와 너비(줄 높이), 열 위 y 와 길이(본문 높이).
+    pub x: f64,
+    pub width: f64,
+    pub top: f64,
+    pub length: f64,
+    /// 이 열의 글자 범위(문단 글자 위치), 끝은 다음 열의 시작.
+    pub char_start: usize,
+    pub char_end: usize,
+    /// 문단의 마지막 줄인가(문단 끝 자리가 이 열에 있다).
+    pub last_line: bool,
+}
+
+/// 세로 구역 한 쪽의 열들: 쪽 항목의 줄 범위를 본문 오른쪽 끝부터 왼쪽으로 쌓는다.
+pub(crate) fn vertical_page_columns(
+    page_content: &PageContent,
+    paragraphs: &[Paragraph],
+    composed: &[ComposedParagraph],
+    body: &LayoutRect,
+    dpi: f64,
+) -> Vec<VerticalColumn> {
+    let mut columns = Vec::new();
+    let mut x_right = body.x + body.width;
+    for column in &page_content.column_contents {
+        for item in &column.items {
+            let (para_index, start_line, end_line) = match item {
+                PageItem::FullParagraph { para_index } => (*para_index, 0, usize::MAX),
+                PageItem::PartialParagraph {
+                    para_index,
+                    start_line,
+                    end_line,
+                } => (*para_index, *start_line, *end_line),
+                _ => continue,
+            };
+            let (Some(para), Some(comp)) = (paragraphs.get(para_index), composed.get(para_index))
+            else {
+                continue;
+            };
+            let text_len = para.text.chars().count();
+            let end_line = end_line.min(comp.lines.len());
+            for line_index in start_line..end_line {
+                let line = &comp.lines[line_index];
+                let width = hwpunit_to_px(line.line_height, dpi);
+                let last_line = line_index + 1 == comp.lines.len();
+                let char_end = if last_line {
+                    text_len
+                } else {
+                    comp.lines[line_index + 1].char_start.min(text_len)
+                };
+                columns.push(VerticalColumn {
+                    para_index,
+                    line_index,
+                    x: x_right - width,
+                    width,
+                    top: body.y,
+                    length: body.height,
+                    char_start: line.char_start,
+                    char_end,
+                    last_line,
+                });
+                x_right -= width + hwpunit_to_px(line.line_spacing, dpi);
+            }
+        }
+    }
+    columns
+}
+
+/// 세로 열에서 글자 하나를 어떻게 그리는가: (그릴 글자, 회전 각, 글자 상자 너비).
+pub(crate) fn vertical_glyph(ch: char, font_size: f64, text_direction: u8) -> (char, f64, f64) {
+    let rotate = is_vertical_rotate_char(ch)
+        || (text_direction == 1 && !is_cjk_char(ch) && !ch.is_whitespace());
+    if rotate {
+        match vertical_substitute_char(ch) {
+            Some(sub) => (sub, 0.0, font_size),
+            None => (ch, 90.0, font_size),
+        }
+    } else if is_cjk_char(ch) {
+        (ch, 0.0, font_size)
+    } else {
+        (ch, 0.0, font_size * 0.5)
+    }
+}
+
+impl LayoutEngine {
+    /// 세로 구역 한 쪽의 본문: 쪽 항목의 줄 범위를 오른쪽에서 왼쪽으로 열로 그린다.
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn build_vertical_columns(
+        &self,
+        tree: &mut PageLayoutContext,
+        body_node: &mut RenderNode,
+        page_content: &PageContent,
+        paragraphs: &[Paragraph],
+        composed: &[ComposedParagraph],
+        styles: &ResolvedStyleSet,
+        layout: &PageLayoutInfo,
+    ) {
+        let direction = self.text_direction.get();
+        let section_index = page_content.section_index;
+        let columns = vertical_page_columns(
+            page_content,
+            paragraphs,
+            composed,
+            &layout.body_area,
+            self.dpi,
+        );
+        for col in columns {
+            let comp = &composed[col.para_index];
+            let line = &comp.lines[col.line_index];
+            let text_len = paragraphs[col.para_index].text.chars().count();
+            let centre = col.x + col.width / 2.0;
+            let line_id = tree.next_id();
+            let mut text_line =
+                TextLineNode::with_para(col.width, col.width * 0.85, section_index, col.para_index);
+            text_line.line_index = Some(col.line_index as u32);
+            let mut line_node = RenderNode::new(
+                line_id,
+                RenderNodeType::TextLine(text_line),
+                BoundingBox::new(col.x, col.top, col.width, col.length),
+            );
+            let mut y = col.top;
+            let mut char_index = line.char_start;
+            for run in &line.runs {
+                let style = run.text_style(styles);
+                let border_fill_id = styles
+                    .char_styles
+                    .get(run.char_style_id as usize)
+                    .map(|cs| cs.border_fill_id)
+                    .unwrap_or(0);
+                for ch in run.text.chars() {
+                    let advance = vertical_char_advance(ch, &style, direction);
+                    let (glyph, rotation, glyph_width) =
+                        vertical_glyph(ch, style.font_size, direction);
+                    if !ch.is_whitespace() && !ch.is_control() {
+                        let run_id = tree.next_id();
+                        line_node.children.push(RenderNode::new(
+                            run_id,
+                            RenderNodeType::TextRun(TextRunNode {
+                                text: glyph.to_string(),
+                                style: style.clone(),
+                                char_shape_id: Some(run.char_style_id),
+                                para_shape_id: Some(comp.para_style_id),
+                                section_index: Some(section_index),
+                                para_index: Some(col.para_index),
+                                char_start: Some(char_index),
+                                cell_context: None,
+                                is_para_end: char_index + 1 == text_len,
+                                is_line_break_end: false,
+                                rotation,
+                                is_vertical: true,
+                                char_overlap: None,
+                                border_fill_id,
+                                baseline: advance * 0.85,
+                                field_marker: FieldMarkerType::None,
+                                layout_positions: None,
+                                display_text: None,
+                            }),
+                            BoundingBox::new(centre - glyph_width / 2.0, y, glyph_width, advance),
+                        ));
+                    }
+                    y += advance;
+                    char_index += 1;
+                }
+            }
+            body_node.children.push(line_node);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::document_core::DocumentCore;
+    use crate::model::control::Control;
+    use crate::renderer::render_tree::{RenderNode, RenderNodeType};
+
+    fn vertical(text: &str) -> DocumentCore {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        let mut doc = core.document().clone();
+        doc.sections[0].raw_stream = None;
+        doc.sections[0].section_def.text_direction = 1;
+        for control in doc.sections[0]
+            .paragraphs
+            .iter_mut()
+            .flat_map(|p| p.controls.iter_mut())
+        {
+            if let Control::SectionDef(sd) = control {
+                sd.text_direction = 1;
+            }
+        }
+        core.set_document(doc);
+        core.insert_text_native(0, 0, 0, text).unwrap();
+        core
+    }
+
+    /// 세로 구역의 글자는 오른쪽 위에서 아래로, 열이 차면 왼쪽 열로 그린다(HwpCraft 0089).
+    #[test]
+    fn vertical_text_is_drawn_down_columns_from_the_right() {
+        let core = vertical(&"가".repeat(60));
+        let tree = core.build_page_render_tree(0).unwrap();
+        let mut runs = Vec::new();
+        fn walk(node: &RenderNode, out: &mut Vec<(usize, f64, f64)>) {
+            if let RenderNodeType::TextRun(run) = &node.node_type {
+                if run.is_vertical {
+                    out.push((run.char_start.unwrap_or(0), node.bbox.x, node.bbox.y));
+                }
+            }
+            for child in &node.children {
+                walk(child, out);
+            }
+        }
+        walk(&tree.root, &mut runs);
+        runs.sort_by_key(|r| r.0);
+        assert_eq!(runs.len(), 60);
+        // 첫 열: 같은 x, 아래로.
+        assert!(runs[..58]
+            .windows(2)
+            .all(|w| w[0].1 == w[1].1 && w[0].2 < w[1].2));
+        // 둘째 열은 왼쪽, 다시 맨 위부터.
+        assert!(runs[58].1 < runs[0].1);
+        assert_eq!(runs[58].2, runs[0].2);
+    }
+}
