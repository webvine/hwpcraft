+#[cfg(test)]
+mod save_scoped_mutation_tests {
+    use super::DocumentCore;
+
+    /// A model change undone before the next layout keeps snapshot and typeset reuse on;
+    /// `document_mut` turns both off until the next full rebuild.
+    #[test]
+    fn a_save_scoped_change_keeps_reuse_on() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().expect("blank");
+        let _ = core.page_count();
+        let tag = core.document().sections[0].paragraphs[0].line_segs[0].tag;
+        core.document_mut_keeping_layout().sections[0].paragraphs[0].line_segs[0].tag |=
+            0x8000_0000;
+        core.document_mut_keeping_layout().sections[0].paragraphs[0].line_segs[0].tag = tag;
+        assert!(!core.untracked_model_edit);
+        assert!(core.typeset_marks.iter().all(|m| !m.untracked));
+        let _ = core.document_mut();
+        assert!(core.untracked_model_edit);
+    }
+}
