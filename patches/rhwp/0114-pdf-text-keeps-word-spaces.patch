+/// [HwpCraft 0114] 인쇄 등가 profile 은 빈칸 자리에 칠하지 않는 U+0020 을 남겨 PDF 에서
+/// 복사·검색한 글의 띄어쓰기를 지킨다(usvg 가 버리지 않도록 칠하지 않는 밑줄을 단다).
+/// 편집 화면 profile 은 종전대로 빈칸을 쓰지 않는다.
+#[test]
+fn print_profile_keeps_word_spaces_as_unpainted_text() {
+    let draw = |profile| {
+        let mut renderer = SvgRenderer::new();
+        renderer.profile = profile;
+        renderer.begin_page(800.0, 600.0);
+        renderer.draw_text(
+            "가 나",
+            10.0,
+            20.0,
+            &TextStyle {
+                font_size: 16.0,
+                ..Default::default()
+            },
+        );
+        renderer.output().to_string()
+    };
+    let print = draw(crate::paint::RenderProfile::Print);
+    let spaces: Vec<&str> = print
+        .lines()
+        .filter(|l| l.contains("xml:space=\"preserve\"> </text>"))
+        .collect();
+    assert_eq!(spaces.len(), 1, "{print}");
+    assert!(
+        spaces[0].contains("fill=\"none\"") && spaces[0].contains("text-decoration=\"underline\""),
+        "{}",
+        spaces[0]
+    );
+    let screen = draw(crate::paint::RenderProfile::Screen);
+    assert!(!screen.contains("xml:space"), "{screen}");
+    // 보이는 글자는 두 profile 이 같다.
+    let glyphs = |svg: &str| {
+        svg.lines()
+            .filter(|l| l.starts_with("<text") && !l.contains("xml:space"))
+            .map(str::to_owned)
+            .collect::<Vec<_>>()
+    };
+    assert_eq!(glyphs(&print), glyphs(&screen));
+}
