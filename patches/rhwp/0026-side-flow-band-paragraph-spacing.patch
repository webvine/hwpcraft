+    /// 간격만큼 내려가 배제 띠를 지난다(간격 있는 문단의 문단 첫 글자 장식).
+    #[test]
+    fn side_flow_band_spans_paragraph_spacing() {
+        use crate::model::shape::{
+            CommonObjAttr, HorzAlign, HorzRelTo, RectangleShape, ShapeObject, TextFlow, TextWrap,
+            VertAlign, VertRelTo,
+        };
+
+        const DPI: f64 = 96.0;
+        const COLUMN_WIDTH: i32 = 15_000;
+        const AFTER: i32 = 600;
+        let mut styles = styles(&[12.0]);
+        styles.para_styles[0].spacing_after = crate::renderer::hwpunit_to_px(AFTER, DPI);
+        styles.para_styles[0].spacing_before = crate::renderer::hwpunit_to_px(300, DPI);
+        let rect = RectangleShape {
+            common: CommonObjAttr {
+                width: 3_000,
+                // Taller than one row plus the spacing, so the band reaches paragraph 2.
+                height: 3_000,
+                text_wrap: TextWrap::Square,
+                text_flow: TextFlow::BothSides,
+                vert_rel_to: VertRelTo::Para,
+                vert_align: VertAlign::Top,
+                horz_rel_to: HorzRelTo::Para,
+                horz_align: HorzAlign::Left,
+                ..Default::default()
+            },
+            ..Default::default()
+        };
+        let char_shapes = || {
+            vec![CharShapeRef {
+                start_pos: 0,
+                char_shape_id: 0,
+            }]
+        };
+        let mut host = paragraph("x", char_shapes());
+        host.controls
+            .push(Control::Shape(Box::new(ShapeObject::Rectangle(rect))));
+        let next = paragraph("y", char_shapes());
+
+        let band = layout_picture_band(
+            &[host, next],
+            0,
+            crate::renderer::hwpunit_to_px(COLUMN_WIDTH, DPI),
+            &styles,
+            DPI,
+            (0.0, 0.0),
+        )
+        .expect("a band across two spaced paragraphs");
+        assert_eq!(band.paragraph_range, 0..2);
+        let host_row = &band.line_segs[0][0];
+        let next_row = &band.line_segs[1][0];
+        assert_eq!(host_row.vertical_pos, 0, "the host's own spacing before is outside the band");
+        let host_bottom = host_row.vertical_pos + host_row.line_height + host_row.line_spacing;
+        let gap = next_row.vertical_pos - host_bottom;
+        let expected = AFTER + crate::renderer::px_to_hwpunit(styles.para_styles[0].spacing_before, DPI);
+        assert!((gap - expected).abs() <= 1, "gap {gap}, expected {expected}");
+        assert_eq!(next_row.column_start, 3_000);
+    }
