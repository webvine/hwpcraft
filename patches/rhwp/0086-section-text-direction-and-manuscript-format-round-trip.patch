+#[cfg(test)]
+mod section_direction_round_trip_tests {
+    use crate::document_core::DocumentCore;
+    use crate::model::control::Control;
+    use crate::model::document::{SectionDef, SECTION_WONGGOJI_FORMAT};
+
+    fn manuscript_vertical(sd: &mut SectionDef) {
+        sd.text_direction = 2;
+        sd.flags |= SECTION_WONGGOJI_FORMAT;
+        sd.line_grid = 3000;
+        sd.char_grid = 2126;
+    }
+
+    /// 세로쓰기(영문 세움)와 원고지 정서법이 HWP·HWPX 저장과 HWPX→HWP 변환을 지난다
+    /// (HwpCraft 패치 0086).
+    #[test]
+    fn vertical_and_manuscript_sections_survive_hwp_and_hwpx() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        let mut doc = core.document().clone();
+        // 편집한 구역은 원본 레코드 대신 모델에서 쓴다.
+        doc.sections[0].raw_stream = None;
+        manuscript_vertical(&mut doc.sections[0].section_def);
+        for control in doc.sections[0]
+            .paragraphs
+            .iter_mut()
+            .flat_map(|p| p.controls.iter_mut())
+        {
+            if let Control::SectionDef(sd) = control {
+                manuscript_vertical(sd);
+            }
+        }
+        core.set_document(doc);
+        let hwp = DocumentCore::from_bytes(&core.export_hwp_native().unwrap()).unwrap();
+        let hwpx = DocumentCore::from_bytes(&core.export_hwpx_native().unwrap()).unwrap();
+        let converted = DocumentCore::from_bytes(&hwpx.export_hwp_native().unwrap()).unwrap();
+        for (label, back) in [("hwp", &hwp), ("hwpx", &hwpx), ("hwpx to hwp", &converted)] {
+            let sd = &back.document().sections[0].section_def;
+            assert_eq!(
+                (
+                    sd.text_direction,
+                    sd.flags & SECTION_WONGGOJI_FORMAT != 0,
+                    sd.line_grid,
+                    sd.char_grid
+                ),
+                (2, true, 3000, 2126),
+                "{label}"
+            );
+        }
+    }
+}
