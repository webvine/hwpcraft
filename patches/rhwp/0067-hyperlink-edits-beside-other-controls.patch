+#[cfg(test)]
+mod hwpcraft_link_beside_controls_tests {
+    use super::HyperlinkTarget;
+    use crate::document_core::DocumentCore;
+    use crate::model::control::{Control, FieldType};
+
+    fn links(core: &DocumentCore) -> Vec<(usize, usize, String)> {
+        let p = &core.document().sections[0].paragraphs[0];
+        p.field_ranges
+            .iter()
+            .filter_map(|r| match p.controls.get(r.control_idx) {
+                Some(Control::Field(f)) if f.field_type == FieldType::Hyperlink => {
+                    Some((r.start_char_idx, r.end_char_idx, f.command.clone()))
+                }
+                _ => None,
+            })
+            .collect()
+    }
+
+    fn others(core: &DocumentCore) -> usize {
+        let p = &core.document().sections[0].paragraphs[0];
+        p.controls
+            .iter()
+            .filter(|c| matches!(c, Control::Bookmark(_) | Control::Footnote(_)))
+            .count()
+    }
+
+    /// "책갈피·각주 앞 링크 뒤": a bookmark and a footnote before the link, outside
+    /// its range. Address, text and removal edits work there and survive saves.
+    fn sample() -> (DocumentCore, HyperlinkTarget, u32) {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        let target = HyperlinkTarget::body(0, 0);
+        core.insert_text_native(0, 0, 0, "앞 링크 뒤").unwrap();
+        core.add_bookmark_native(0, 0, 0, "처음").unwrap();
+        core.insert_footnote_native(0, 0, 1).unwrap();
+        let id = core
+            .insert_hyperlink_native(&target, 2, 4, "https://a.example")
+            .unwrap();
+        (core, target, id)
+    }
+
+    #[test]
+    fn links_beside_a_bookmark_and_a_footnote_are_edited_and_saved() {
+        let (mut core, target, id) = sample();
+        assert_eq!(others(&core), 2);
+        assert!(core
+            .update_hyperlink_native(&target, id, "https://b.example")
+            .unwrap());
+        assert!(core
+            .replace_hyperlink_text_native(&target, id, "새 링크")
+            .unwrap());
+        let expected = links(&core);
+        assert_eq!(expected.len(), 1);
+        assert_eq!((expected[0].0, expected[0].1), (2, 6));
+        assert!(expected[0].2.contains("b.example"));
+        for bytes in [
+            core.export_hwpx_native().unwrap(),
+            core.export_hwp_native().unwrap(),
+        ] {
+            let reopened = DocumentCore::from_bytes(&bytes).unwrap();
+            assert_eq!(links(&reopened), expected);
+            assert_eq!(others(&reopened), 2);
+            assert_eq!(
+                reopened.document().sections[0].paragraphs[0].text,
+                core.document().sections[0].paragraphs[0].text
+            );
+        }
+        core.remove_hyperlink_native(&target, id).unwrap();
+        assert!(links(&core).is_empty());
+        assert_eq!(others(&core), 2);
+        let reopened = DocumentCore::from_bytes(&core.export_hwpx_native().unwrap()).unwrap();
+        assert!(links(&reopened).is_empty());
+        assert_eq!(others(&reopened), 2);
+    }
+
+    /// A bookmark on another link's start: renaming the first link is refused
+    /// rather than leaving the shared gap's order undefined; its address still
+    /// changes, and the second link keeps its range through saves.
+    #[test]
+    fn a_control_on_another_link_boundary_refuses_renaming() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        let target = HyperlinkTarget::body(0, 0);
+        core.insert_text_native(0, 0, 0, "링크A 와 링크B").unwrap();
+        let first = core
+            .insert_hyperlink_native(&target, 0, 3, "https://a.example")
+            .unwrap();
+        core.insert_hyperlink_native(&target, 6, 9, "https://b.example")
+            .unwrap();
+        core.add_bookmark_native(0, 0, 6, "둘째").unwrap();
+        let before = links(&core);
+        assert!(core
+            .replace_hyperlink_text_native(&target, first, "첫 링크")
+            .is_err());
+        assert!(core
+            .update_hyperlink_native(&target, first, "https://c.example")
+            .unwrap());
+        let reopened = DocumentCore::from_bytes(&core.export_hwpx_native().unwrap()).unwrap();
+        let after: Vec<_> = links(&reopened).into_iter().map(|l| (l.0, l.1)).collect();
+        assert_eq!(
+            after,
+            before.into_iter().map(|l| (l.0, l.1)).collect::<Vec<_>>()
+        );
+    }
+
+    /// A control on the link's boundary or inside it is still refused: the gap
+    /// holding both would have no defined order.
+    #[test]
+    fn a_control_on_the_link_range_still_refuses_text_edits() {
+        let (mut core, target, id) = sample();
+        core.insert_footnote_native(0, 0, 3).unwrap();
+        assert!(core
+            .replace_hyperlink_text_native(&target, id, "다른")
+            .is_err());
+        assert!(core
+            .update_hyperlink_native(&target, id, "https://c.example")
+            .unwrap());
+    }
+}
