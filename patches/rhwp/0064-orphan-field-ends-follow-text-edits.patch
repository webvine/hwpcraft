+
+
+/// The end marker of a field that began in an earlier paragraph (a multi-paragraph
+/// 누름틀 or memo) follows text edits in its paragraph like a field range end.
+fn orphan_paragraph() -> Paragraph {
+    let text = "가나다라마";
+    Paragraph {
+        text: text.to_string(),
+        char_count: 5 + 8 + 1,
+        char_offsets: vec![0, 1, 2, 11, 12],
+        char_shapes: vec![CharShapeRef {
+            start_pos: 0,
+            char_shape_id: 1,
+        }],
+        orphan_field_ends: vec![OrphanFieldEnd {
+            char_idx: 3,
+            begin_id_ref: 7,
+            field_id: 7,
+            begin_ctrl_id: 0,
+        }],
+        has_para_text: true,
+        ..Default::default()
+    }
+}
+
+#[test]
+fn orphan_field_end_follows_inserted_and_deleted_text() {
+    let mut para = orphan_paragraph();
+    para.insert_text_at(1, "XY");
+    assert_eq!(para.orphan_field_ends[0].char_idx, 5, "text before the end moves it");
+    para.insert_text_at(5, "Z");
+    assert_eq!(para.orphan_field_ends[0].char_idx, 6, "text typed at the end joins the field");
+    para.insert_text_at(7, "W");
+    assert_eq!(para.orphan_field_ends[0].char_idx, 6, "text after the end leaves it");
+    para.delete_text_at(0, 2);
+    assert_eq!(para.orphan_field_ends[0].char_idx, 4);
+    para.delete_text_at(3, 3);
+    assert_eq!(para.orphan_field_ends[0].char_idx, 3, "a deleted end stays at the cut");
+}
+
+#[test]
+fn orphan_field_end_moves_with_split_and_merge() {
+    let mut para = orphan_paragraph();
+    let tail = para.split_at(2);
+    assert!(para.orphan_field_ends.is_empty());
+    assert_eq!(tail.orphan_field_ends.len(), 1);
+    assert_eq!(tail.orphan_field_ends[0].char_idx, 1);
+    assert_eq!(tail.orphan_field_ends[0].field_id, 7);
+
+    let mut para = orphan_paragraph();
+    let tail = para.split_at(4);
+    assert_eq!(para.orphan_field_ends[0].char_idx, 3, "an end before the split stays");
+    assert!(tail.orphan_field_ends.is_empty());
+    let len = para.merge_from(&tail);
+    assert_eq!(len, 4);
+    assert_eq!(para.orphan_field_ends.len(), 1);
+    assert_eq!(para.orphan_field_ends[0].char_idx, 3);
+
+    let mut head = Paragraph {
+        text: "앞".to_string(),
+        char_count: 2,
+        char_offsets: vec![0],
+        has_para_text: true,
+        ..Default::default()
+    };
+    head.merge_from(&orphan_paragraph());
+    assert_eq!(head.orphan_field_ends[0].char_idx, 4, "merged after one character");
+}
