+/// 덧말의 기준 글자와 덧말 글자 모양: 컨트롤 자리의 글자 모양, 덧말은 크기 비율
+/// (`szRatio`, 기본 50 %)만큼 줄인다.
+fn ruby_text_styles(
+    para: &Paragraph,
+    control_index: usize,
+    ruby: &crate::model::control::Ruby,
+    styles: &ResolvedStyleSet,
+) -> (TextStyle, TextStyle) {
+    let position = para
+        .control_utf16_positions()
+        .get(control_index)
+        .copied()
+        .unwrap_or(0);
+    let char_shape = crate::renderer::composer::find_active_char_shape(&para.char_shapes, position);
+    let lang = ruby
+        .main_text
+        .chars()
+        .next()
+        .map(crate::renderer::style_resolver::detect_lang_category)
+        .unwrap_or(0);
+    let main = resolved_to_text_style(styles, char_shape, lang);
+    let mut annotation = main.clone();
+    let ratio = if ruby.sz_ratio == 0 { 50 } else { ruby.sz_ratio.min(100) };
+    annotation.font_size = main.font_size * f64::from(ratio) / 100.0;
+    (main, annotation)
 }
 
