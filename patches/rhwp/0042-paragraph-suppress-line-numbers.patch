+#[cfg(test)]
+mod hwpcraft_suppress_line_numbers_tests {
+    use crate::document_core::DocumentCore;
+
+    /// [HwpCraft 0042] 문단의 줄 번호 건너뜀은 HWPX 로 저장하고 다시 열어도 남는다.
+    #[test]
+    fn suppressed_line_numbers_survive_an_hwpx_round_trip() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        let mut doc = core.document().clone();
+        let id = doc.sections[0].paragraphs[0].para_shape_id as usize;
+        doc.doc_info.para_shapes[id].suppress_line_numbers = true;
+        doc.doc_info.para_shapes[id].raw_data = None;
+        core.set_document(doc);
+        let bytes = core.export_hwpx_native().unwrap();
+        let back = DocumentCore::from_bytes(&bytes).unwrap();
+        let id = back.document().sections[0].paragraphs[0].para_shape_id as usize;
+        assert!(back.document().doc_info.para_shapes[id].suppress_line_numbers);
+        // Others stay off.
+        let others = back
+            .document()
+            .doc_info
+            .para_shapes
+            .iter()
+            .enumerate()
+            .filter(|(i, ps)| *i != id && ps.suppress_line_numbers)
+            .count();
+        assert_eq!(others, 0);
+    }
+}
