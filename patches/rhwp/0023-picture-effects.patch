+            margin = margin.max(radius * 1.5);
+            body.push_str(&format!(
+                "<feMorphology in=\"SourceAlpha\" operator=\"dilate\" radius=\"{:.3}\" result=\"fx-g0\"/>\
+                 <feGaussianBlur in=\"fx-g0\" stdDeviation=\"{:.3}\" result=\"fx-g1\"/>\
+                 <feFlood flood-color=\"{}\" flood-opacity=\"{:.3}\"/>\
+                 <feComposite in2=\"fx-g1\" operator=\"in\" result=\"fx-glow\"/>",
+                radius / 2.0,
+                radius / 4.0,
+                effect_color_hex(glow.color.as_ref()),
+                effect_opacity(glow.alpha.as_deref())
+            ));
+            under.push("fx-glow");
+        }
+    }
+    if let Some(shadow) = &effects.shadow {
+        let blur = effect_hu_px(shadow.radius.as_deref());
+        let distance = effect_hu_px(shadow.distance.as_deref());
+        let angle = effect_number(shadow.direction.as_deref(), 0.0).to_radians();
+        let (dx, dy) = (distance * angle.cos(), distance * angle.sin());
+        let color = effect_color_hex(shadow.color.as_ref());
+        let opacity = effect_opacity(shadow.alpha.as_deref());
+        if shadow.style.as_deref() == Some("INSIDE") {
+            body.push_str(&format!(
+                "<feComponentTransfer in=\"SourceAlpha\" result=\"fx-inv\"><feFuncA type=\"table\" tableValues=\"1 0\"/></feComponentTransfer>\
+                 <feGaussianBlur in=\"fx-inv\" stdDeviation=\"{:.3}\"/>\
+                 <feOffset dx=\"{dx:.3}\" dy=\"{dy:.3}\" result=\"fx-is0\"/>\
+                 <feFlood flood-color=\"{color}\" flood-opacity=\"{opacity:.3}\"/>\
+                 <feComposite in2=\"fx-is0\" operator=\"in\"/>\
+                 <feComposite in2=\"SourceAlpha\" operator=\"in\" result=\"fx-ishadow\"/>",
+                blur / 2.0
+            ));
+            over.push("fx-ishadow");
+        } else {
+            margin = margin.max(blur * 1.5 + distance);
+            body.push_str(&format!(
+                "<feGaussianBlur in=\"SourceAlpha\" stdDeviation=\"{:.3}\"/>\
+                 <feOffset dx=\"{dx:.3}\" dy=\"{dy:.3}\" result=\"fx-s0\"/>\
+                 <feFlood flood-color=\"{color}\" flood-opacity=\"{opacity:.3}\"/>\
+                 <feComposite in2=\"fx-s0\" operator=\"in\" result=\"fx-shadow\"/>",
+                blur / 2.0
+            ));
+            under.insert(0, "fx-shadow");
+        }
+    }
+    body.push_str("<feMerge>");
+    for node in under.iter().chain(std::iter::once(&object)).chain(over.iter()) {
+        body.push_str(&format!("<feMergeNode in=\"{node}\"/>"));
+    }
+    body.push_str("</feMerge>");
+    let margin = margin + 1.0;
+    let def = format!(
+        "<filter id=\"{id}\" filterUnits=\"userSpaceOnUse\" x=\"{:.3}\" y=\"{:.3}\" width=\"{:.3}\" height=\"{:.3}\" color-interpolation-filters=\"sRGB\">{body}</filter>\n",
+        frame.x - margin,
+        frame.y - margin,
+        frame.width + margin * 2.0,
+        frame.height + margin * 2.0
+    );
+    Some((id, def))
+}
+
+/// 반사: 그림 아래쪽 끝을 축으로 뒤집은 사본을 거리만큼 띄우고, 위에서 아래로
+/// 시작·끝 투명도 사이를 그라디언트 마스크로 옅게 한다. `pos` 의 끝 값은 비율(0~1) 또는
+/// 백분율(1 초과)로 읽는다.
+fn picture_reflection_svg(
+    defs: &mut Vec<String>,
+    sequence: usize,
+    frame: &super::render_tree::BoundingBox,
+    reflection: &crate::model::image::PictureReflection,
+    picture: &str,
+) -> String {
+    let distance = effect_hu_px(reflection.distance.as_deref());
+    let blur = effect_hu_px(reflection.radius.as_deref());
+    let fraction = |value: Option<&String>, default: f64| {
+        let v = effect_number(value.map(String::as_str), default);
+        if v > 1.0 { v / 100.0 } else { v }.clamp(0.0, 1.0)
+    };
+    let (start_alpha, end_alpha) = reflection.alpha.as_ref().map_or((0.5, 1.0), |a| {
+        (fraction(a.start.as_ref(), 0.5), fraction(a.end.as_ref(), 1.0))
+    });
+    let (start_pos, end_pos) = reflection.pos.as_ref().map_or((0.0, 1.0), |p| {
+        (fraction(p.start.as_ref(), 0.0), fraction(p.end.as_ref(), 1.0))
+    });
+    let axis = frame.y + frame.height + distance / 2.0;
+    let top = frame.y + frame.height + distance;
+    let mask_id = format!("rhwp-picrefl-{sequence}");
+    defs.push(format!(
+        "<linearGradient id=\"{mask_id}-g\" gradientUnits=\"userSpaceOnUse\" x1=\"0\" y1=\"{:.3}\" x2=\"0\" y2=\"{:.3}\">\
+         <stop offset=\"0\" stop-color=\"#fff\" stop-opacity=\"{:.3}\"/>\
+         <stop offset=\"1\" stop-color=\"#fff\" stop-opacity=\"{:.3}\"/></linearGradient>\
+         <mask id=\"{mask_id}\" maskUnits=\"userSpaceOnUse\" x=\"{:.3}\" y=\"{:.3}\" width=\"{:.3}\" height=\"{:.3}\">\
+         <rect x=\"{:.3}\" y=\"{:.3}\" width=\"{:.3}\" height=\"{:.3}\" fill=\"url(#{mask_id}-g)\"/></mask>\n",
+        top + frame.height * start_pos,
+        top + frame.height * end_pos.max(start_pos + 0.001),
+        1.0 - start_alpha,
+        1.0 - end_alpha,
+        frame.x - 1.0,
+        top,
+        frame.width + 2.0,
+        frame.height * end_pos,
+        frame.x - 1.0,
+        top,
+        frame.width + 2.0,
+        frame.height * end_pos
+    ));
+    let mut out = format!("<g mask=\"url(#{mask_id})\">\n");
+    if blur > 0.0 {
+        defs.push(format!(
+            "<filter id=\"{mask_id}-b\"><feGaussianBlur stdDeviation=\"{:.3}\"/></filter>\n",
+            blur / 2.0
+        ));
+        out.push_str(&format!("<g filter=\"url(#{mask_id}-b)\">\n"));
+    }
+    out.push_str(&format!(
+        "<g transform=\"translate(0 {:.3}) scale(1 -1)\">\n",
+        axis * 2.0
+    ));
+    out.push_str(picture);
+    out.push_str("</g>\n");
+    if blur > 0.0 {
+        out.push_str("</g>\n");
+    }
+    out.push_str("</g>\n");
+    out
+}
