+/// HWPUNIT 문자열 값을 SVG px 로. 읽지 못하면 0.
+fn effect_hu_px(value: Option<&str>) -> f64 {
+    let hu = value.and_then(|v| v.trim().parse::<f64>().ok()).unwrap_or(0.0);
+    if hu.is_finite() {
+        (hu * super::DEFAULT_DPI / 7200.0).max(0.0)
+    } else {
+        0.0
+    }
