+#[cfg(test)]
+mod source_format_tests {
+    use crate::document_core::DocumentCore;
+    use crate::parser::FileFormat;
+
+    /// A core made only to serialize an HWPX document's model keeps that source
+    /// format: its HWPX carries no `rhwp-hwp5-origin` marker.
+    #[test]
+    fn a_serializing_core_keeps_the_source_format_it_is_given() {
+        let marker = b"rhwp-hwp5-origin";
+        let has_marker = |bytes: &[u8]| bytes.windows(marker.len()).any(|w| w == marker);
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        assert_eq!(core.source_format(), FileFormat::Hwp);
+        assert!(has_marker(&core.export_hwpx_native().unwrap()));
+        core.set_source_format(FileFormat::Hwpx);
+        assert_eq!(core.source_format(), FileFormat::Hwpx);
+        assert!(!has_marker(&core.export_hwpx_native().unwrap()));
+    }
+}
