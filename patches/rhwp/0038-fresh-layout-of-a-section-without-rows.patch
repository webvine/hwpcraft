+#[cfg(test)]
+mod fresh_flow_tests {
+    use crate::document_core::DocumentCore;
+
+    /// A section written without any line cache (a new document saved as HWPX) is
+    /// laid out as one flow: every paragraph, empty ones too, gets rows that start
+    /// after the previous paragraph, as in the live layout.
+    #[test]
+    fn a_section_without_stored_rows_flows_like_the_live_layout() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        core.insert_text_native(0, 0, 0, &"긴 문단입니다 ".repeat(20))
+            .unwrap();
+        let len = core.document().sections[0].paragraphs[0]
+            .text
+            .chars()
+            .count();
+        core.split_paragraph_native(0, 0, len, None).unwrap();
+        core.split_paragraph_native(0, 1, 0, None).unwrap();
+        core.insert_text_native(0, 2, 0, "끝 문단").unwrap();
+        let rows = |core: &DocumentCore| -> Vec<Vec<i32>> {
+            core.document().sections[0]
+                .paragraphs
+                .iter()
+                .map(|p| p.line_segs.iter().map(|l| l.vertical_pos).collect())
+                .collect()
+        };
+        let live = rows(&core);
+        assert!(live[0].len() > 1 && live.iter().all(|r| !r.is_empty()));
+        let mut doc = core.document().clone();
+        for p in &mut doc.sections[0].paragraphs {
+            p.line_segs.clear();
+        }
+        core.set_document(doc);
+        core.validation_report = DocumentCore::validate_linesegs(&core.document, true);
+        core.reflow_linesegs_on_demand();
+        assert_eq!(rows(&core), live);
+    }
+}
