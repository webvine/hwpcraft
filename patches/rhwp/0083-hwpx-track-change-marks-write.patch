+/// `trackChange@id` 다. 범위가 문단 나눔을 덮으면 닫는 표지에, 나눔에서 시작하면 여는
+/// 표지에 `paraend="1"` 을 달고 글 끝에 둔다 (`parser::hwpx::section` 의 읽기와 짝).
+/// 같은 자리에서는 닫는 표지가 먼저다. 표지 짝의 `Id` 는 문서 안에서 1부터 차례로 준다.
+fn track_mark_xml(para: &Paragraph, ctx: &mut SerializeContext) -> Vec<(u32, String)> {
+    let break_pos = para.char_count.saturating_sub(1);
+    let mut marks: Vec<(u32, u8, String)> = Vec::new();
+    for tag in &para.range_tags {
+        let name = match tag.tag >> 24 {
+            16 => "insert",
+            17 => "delete",
+            _ => continue,
+        };
+        let tc = tag.tag & 0x00FF_FFFF;
+        let begin_at_break = para.char_count > 0 && tag.start >= break_pos;
+        let end_at_break = para.char_count > 0 && tag.end >= para.char_count;
+        let begin = tag.start.min(break_pos);
+        let end = if end_at_break { break_pos } else { tag.end };
+        ctx.track_mark_id += 1;
+        let id = ctx.track_mark_id;
+        marks.push((
+            begin,
+            1,
+            format!(
+                r#"<hp:{name}Begin paraend="{}" TcId="{tc}" Id="{id}"/>"#,
+                u8::from(begin_at_break)
+            ),
+        ));
+        marks.push((
+            end,
+            0,
+            format!(
+                r#"<hp:{name}End paraend="{}" TcId="{tc}" Id="{id}"/>"#,
+                u8::from(end_at_break)
+            ),
+        ));
+    }
+    marks.sort_by_key(|(pos, order, _)| (*pos, *order));
+    marks.into_iter().map(|(pos, _, xml)| (pos, xml)).collect()
