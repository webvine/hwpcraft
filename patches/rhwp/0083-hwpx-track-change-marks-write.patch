+/// [HwpCraft 0083] HWP5 형식 변경 추적 레코드(TRACK_CHANGE 96 · TRACK_CHANGE_AUTHOR 97,
+/// `parser::hwpx::header::read_track_changes` 와 같은 배치)로 OWPML `trackChanges`·
+/// `trackChangeAuthors` 블록을 만든다. id 는 레코드 순번(1부터)으로, 본문 표지의 `TcId`
+/// 와 범위 태그 데이터가 그 번호다. 날짜는 HWP5 레코드처럼 지역 시각으로 쓴다(시간대
+/// 표시 없음). 알 수 없는 종류는 스키마 철자 그대로 `UnKown`. 레코드가 없으면 None.
+fn track_changes_xml_from_records(doc_info: &crate::model::document::DocInfo) -> Option<String> {
+    use crate::parser::hwpx::header::{HWPTAG_TRACK_CHANGE, HWPTAG_TRACK_CHANGE_AUTHOR};
+    let records = |tag| {
+        doc_info
+            .extra_records
+            .iter()
+            .filter(move |r| r.tag_id == tag)
+            .map(|r| r.data.as_slice())
+    };
+    let word = |data: &[u8], at: usize| {
+        data.get(at..at + 2)
+            .map_or(0, |b| u16::from_le_bytes([b[0], b[1]]))
+    };
+    let changes: Vec<&[u8]> = records(HWPTAG_TRACK_CHANGE).collect();
+    let authors: Vec<&[u8]> = records(HWPTAG_TRACK_CHANGE_AUTHOR).collect();
+    if changes.is_empty() && authors.is_empty() {
+        return None;
+    }
+    let mut xml = format!(r#"<hh:trackChanges itemCnt="{}">"#, changes.len());
+    for (i, data) in changes.iter().enumerate() {
+        let kind = data
+            .get(..4)
+            .map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]));
+        let kind = match kind {
+            0x10 => "Insert",
+            0x11 => "Delete",
+            0x12 => "CharShape",
+            0x13 => "ParaShape",
+            _ => "UnKown",
+        };
+        xml.push_str(&format!(
+            r#"<hh:trackChange type="{kind}" date="{:04}-{:02}-{:02}T{:02}:{:02}:00" authorID="{}" hide="0" id="{}"/>"#,
+            word(data, 4),
+            word(data, 6),
+            word(data, 8),
+            word(data, 10),
+            word(data, 12),
+            word(data, 14),
+            i + 1
+        ));
+    }
+    xml.push_str("</hh:trackChanges>");
+    xml.push_str(&format!(r#"<hh:trackChangeAuthors itemCnt="{}">"#, authors.len()));
+    for (i, data) in authors.iter().enumerate() {
+        let len = usize::from(word(data, 0));
+        let units: Vec<u16> = (0..len).map(|k| word(data, 4 + 2 * k)).collect();
+        let name = String::from_utf16_lossy(&units);
+        let tail = 4 + 2 * len;
+        let mark = word(data, tail) != 0;
+        let color = data
+            .get(tail + 2..tail + 6)
+            .map_or(0, |b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]));
+        // HWP COLORREF 0x00BBGGRR → #RRGGBB
+        let rgb = ((color & 0xFF) << 16) | (color & 0xFF00) | ((color >> 16) & 0xFF);
+        xml.push_str(&format!(
+            r##"<hh:trackChangeAuthor name="{}" mark="{}" color="#{rgb:06X}" id="{}"/>"##,
+            crate::serializer::hwpx::utils::xml_escape(&name),
+            u8::from(mark),
+            i + 1
+        ));
+    }
+    xml.push_str("</hh:trackChangeAuthors>");
+    Some(xml)
+}
