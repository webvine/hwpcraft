@@ -0,0 +1,183 @@
+//! [HwpCraft 0082/0083] HWPX 변경 추적: 본문 표지(OWPML `hp:insertBegin`/`insertEnd`/
+//! `deleteBegin`/`deleteEnd`, `TrackChangeTag`)와 헤더 `hh:trackChanges`·
+//! `hh:trackChangeAuthors` 를 읽어 HWP5 와 같은 범위 태그(16 삽입 · 17 삭제)와 DocInfo
+//! 레코드(96 · 97)로 싣고, 저장할 때 다시 쓴다. 변경 추적이 든 HWPX 실표본이 없어
+//! 명세(ParaList·Header XML schema)대로 표지를 넣은 합성 문서로 시험한다.
+
+use std::io::{Cursor, Read, Write};
+
+use crate::document_core::DocumentCore;
+use crate::model::document::Document;
+use crate::parser::hwpx::header::{HWPTAG_TRACK_CHANGE, HWPTAG_TRACK_CHANGE_AUTHOR};
+use crate::parser::hwpx::parse_hwpx;
+use crate::serializer::hwpx::serialize_hwpx;
+
+const TRACK: &str = concat!(
+    r#"<hh:trackChanges itemCnt="2">"#,
+    r#"<hh:trackChange type="Insert" date="2026-11-01T09:30:00Z" authorID="1" hide="0" id="1"/>"#,
+    r#"<hh:trackChange type="Delete" date="2026-11-01T09:31:00Z" authorID="1" hide="0" id="2"/>"#,
+    r#"</hh:trackChanges>"#,
+    r#"<hh:trackChangeAuthors itemCnt="1">"#,
+    r##"<hh:trackChangeAuthor name="검토자" mark="1" color="#FF0000" id="1"/>"##,
+    r#"</hh:trackChangeAuthors>"#,
+);
+
+/// HWPX 패키지의 XML 항목을 `edit` 로 고쳐 다시 묶는다.
+fn rewrite(bytes: &[u8], edit: impl Fn(&str, String) -> String) -> Vec<u8> {
+    let mut archive = zip::ZipArchive::new(Cursor::new(bytes)).expect("zip open");
+    let mut out = Cursor::new(Vec::<u8>::new());
+    let mut writer = zip::ZipWriter::new(&mut out);
+    for i in 0..archive.len() {
+        let mut entry = archive.by_index(i).expect("entry");
+        let name = entry.name().to_string();
+        let mut data = Vec::new();
+        entry.read_to_end(&mut data).expect("read entry");
+        if name.ends_with(".xml") {
+            data = edit(&name, String::from_utf8(data).expect("utf-8 xml")).into_bytes();
+        }
+        let method = if name == "mimetype" {
+            zip::CompressionMethod::Stored
+        } else {
+            zip::CompressionMethod::Deflated
+        };
+        let options = zip::write::SimpleFileOptions::default().compression_method(method);
+        writer.start_file(name, options).expect("start_file");
+        writer.write_all(&data).expect("write entry");
+    }
+    writer.finish().expect("finish");
+    out.into_inner()
+}
+
+fn entry(bytes: &[u8], name: &str) -> String {
+    let mut archive = zip::ZipArchive::new(Cursor::new(bytes)).expect("zip open");
+    let mut text = String::new();
+    archive
+        .by_name(name)
+        .expect("entry")
+        .read_to_string(&mut text)
+        .expect("read");
+    text
+}
+
+/// "가나다라 마바사아 자차카타": "마바" 삽입(변경 1), "자차카타"와 문단 나눔 삭제(변경 2).
+fn tracked_hwpx() -> Vec<u8> {
+    let mut core = DocumentCore::new_empty();
+    core.create_blank_document_native().expect("blank");
+    core.insert_text_native(0, 0, 0, "가나다라 마바사아 자차카타")
+        .expect("text");
+    let plain = core.export_hwpx_native().expect("hwpx");
+    rewrite(&plain, |name, xml| match name {
+        "Contents/header.xml" => {
+            assert!(xml.contains("</hh:refList>"), "refList");
+            xml.replacen("</hh:refList>", &format!("{TRACK}</hh:refList>"), 1)
+        }
+        "Contents/section0.xml" => {
+            assert!(xml.contains("가나다라 마바사아 자차카타"), "본문 글");
+            xml.replacen(
+                "가나다라 마바사아 자차카타",
+                concat!(
+                    r#"가나다라 <hp:insertBegin paraend="0" TcId="1" Id="1"/>마바"#,
+                    r#"<hp:insertEnd paraend="0" TcId="1" Id="1"/>사아 "#,
+                    r#"<hp:deleteBegin paraend="0" TcId="2" Id="2"/>자차카타"#,
+                    r#"<hp:deleteEnd paraend="1" TcId="2" Id="2"/>"#,
+                ),
+                1,
+            )
+        }
+        _ => xml,
+    })
+}
+
+/// 본문 첫 문단의 변경 추적 범위: (종류, 데이터, 시작 글자, 끝 글자, 나눔까지 덮는가).
+fn tracked_ranges(doc: &Document) -> Vec<(u32, u32, usize, usize, bool)> {
+    let para = &doc.sections[0].paragraphs[0];
+    let char_at = |pos: u32| {
+        para.char_offsets
+            .iter()
+            .position(|&o| o >= pos)
+            .unwrap_or(para.text.chars().count())
+    };
+    para.range_tags
+        .iter()
+        .filter(|t| matches!(t.tag >> 24, 16 | 17))
+        .map(|t| {
+            (
+                t.tag >> 24,
+                t.tag & 0x00FF_FFFF,
+                char_at(t.start),
+                char_at(t.end),
+                t.end >= para.char_count,
+            )
+        })
+        .collect()
+}
+
+fn records(doc: &Document, tag: u16) -> Vec<Vec<u8>> {
+    doc.doc_info
+        .extra_records
+        .iter()
+        .filter(|r| r.tag_id == tag)
+        .map(|r| r.data.clone())
+        .collect()
+}
+
+const EXPECTED: [(u32, u32, usize, usize, bool); 2] =
+    [(16, 1, 5, 7, false), (17, 2, 10, 14, true)];
+
+#[test]
+fn hwpx_track_change_marks_and_records_are_read() {
+    let doc = parse_hwpx(&tracked_hwpx()).expect("parse");
+    assert_eq!(doc.sections[0].paragraphs[0].text, "가나다라 마바사아 자차카타");
+    assert_eq!(tracked_ranges(&doc), EXPECTED);
+
+    let changes = records(&doc, HWPTAG_TRACK_CHANGE);
+    assert_eq!(changes.len(), 2);
+    let word = |data: &[u8], at: usize| u16::from_le_bytes([data[at], data[at + 1]]);
+    // 종류 · 년 · 월 · 일 · 시 · 분 · 작성자 번호
+    assert_eq!(&changes[0][..4], &0x10u32.to_le_bytes());
+    assert_eq!(&changes[1][..4], &0x11u32.to_le_bytes());
+    assert_eq!(
+        (1..=6).map(|i| word(&changes[1], 2 + 2 * i)).collect::<Vec<_>>(),
+        [2026, 11, 1, 9, 31, 1]
+    );
+    let authors = records(&doc, HWPTAG_TRACK_CHANGE_AUTHOR);
+    assert_eq!(authors.len(), 1);
+    let name: Vec<u16> = (0..usize::from(word(&authors[0], 0)))
+        .map(|k| word(&authors[0], 4 + 2 * k))
+        .collect();
+    assert_eq!(String::from_utf16_lossy(&name), "검토자");
+}
+
+#[test]
+fn hwpx_track_changes_survive_hwpx_and_hwp_saves() {
+    let doc = parse_hwpx(&tracked_hwpx()).expect("parse");
+
+    // HWPX: 헤더 블록은 원문 그대로, 본문 표지는 범위 태그에서 다시 쓴다.
+    let saved = serialize_hwpx(&doc).expect("hwpx save");
+    assert!(entry(&saved, "Contents/header.xml").contains(TRACK));
+    let section = entry(&saved, "Contents/section0.xml");
+    assert!(section.contains("<hp:insertBegin"), "{section}");
+    assert!(section.contains(r#"<hp:deleteEnd paraend="1""#), "{section}");
+    let back = parse_hwpx(&saved).expect("reparse");
+    assert_eq!(tracked_ranges(&back), EXPECTED);
+    assert_eq!(
+        records(&back, HWPTAG_TRACK_CHANGE),
+        records(&doc, HWPTAG_TRACK_CHANGE)
+    );
+
+    // 원문 블록이 없으면(HWP 에서 온 문서) 레코드에서 헤더 블록을 만든다.
+    let mut from_records = doc.clone();
+    from_records.doc_info.track_changes_xml = None;
+    let saved = serialize_hwpx(&from_records).expect("hwpx from records");
+    let back = parse_hwpx(&saved).expect("reparse from records");
+    assert_eq!(tracked_ranges(&back), EXPECTED);
+    for tag in [HWPTAG_TRACK_CHANGE, HWPTAG_TRACK_CHANGE_AUTHOR] {
+        assert_eq!(records(&back, tag), records(&doc, tag), "tag {tag}");
+    }
+
+    // HWP: 범위 태그는 PARA_RANGE_TAG, 레코드는 DocInfo 에 실린다.
+    let hwp = crate::serializer::serialize_hwp(&doc).expect("hwp save");
+    let back = crate::parser::parse_hwp(&hwp).expect("hwp reparse");
+    assert_eq!(tracked_ranges(&back), EXPECTED);
+    assert_eq!(records(&back, HWPTAG_TRACK_CHANGE).len(), 2);
+}
