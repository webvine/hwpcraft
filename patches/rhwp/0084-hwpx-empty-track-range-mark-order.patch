+#[test]
+fn a_paragraph_break_insert_survives_hwpx() {
+    let mut doc = parse_hwpx(&tracked_hwpx()).expect("parse");
+    let para = &mut doc.sections[0].paragraphs[0];
+    para.range_tags.push(crate::model::paragraph::RangeTag {
+        start: para.char_count - 1,
+        end: para.char_count,
+        tag: (16 << 24) | 1,
+    });
+    let back = parse_hwpx(&serialize_hwpx(&doc).expect("save")).expect("reparse");
+    let mut expected = EXPECTED.to_vec();
+    expected.push((16, 1, 14, 14, true));
+    expected.sort();
+    let mut got = tracked_ranges(&back);
+    got.sort();
+    assert_eq!(got, expected);
+}
