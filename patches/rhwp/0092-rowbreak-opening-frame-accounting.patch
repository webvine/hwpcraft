+    /// 셀 순서는 `row_stored_rewind_unit_indices` 와 같다.
+    pub(crate) fn row_stored_rewind_unit_boundaries(
+        &self,
+        table: &crate::model::table::Table,
+        row: usize,
+        styles: &ResolvedStyleSet,
+    ) -> Vec<Vec<usize>> {
+        let mut cells: Vec<&crate::model::table::Cell> = table
+            .cells
+            .iter()
+            .filter(|cell| cell.row as usize == row && cell.row_span == 1)
+            .collect();
+        cells.sort_by_key(|cell| cell.col);
+        cells
+            .iter()
+            .map(|cell| {
+                let units = self.cell_units(cell, table, styles);
+                (1..units.len())
+                    .filter(|&end| Self::unit_starts_stored_rewind(cell, &units, end))
+                    .collect()
+            })
+            .collect()
+    }
+
+    fn unit_starts_stored_rewind(
+        cell: &crate::model::table::Cell,
+        units: &[CellUnit],
+        end: usize,
+    ) -> bool {
+        let (Some(closing), Some(next)) = (
+            end.checked_sub(1).and_then(|i| units.get(i)),
+            units.get(end),
+        ) else {
+            return false;
+        };
+        let closing_seg = closing
+            .vis_end
+            .checked_sub(1)
+            .and_then(|li| cell.paragraphs.get(closing.para_idx)?.line_segs.get(li));
+        let next_seg = cell
+            .paragraphs
+            .get(next.para_idx)
+            .and_then(|para| para.line_segs.get(next.vis_start));
+        let synthetic = |seg: &crate::model::paragraph::LineSeg| {
+            seg.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+        };
+        matches!((closing_seg, next_seg), (Some(closing), Some(next))
+            if !synthetic(closing)
+                && !synthetic(next)
+                && closing.vertical_pos > 0
+                && next.vertical_pos < closing.vertical_pos)
+    }
+
+    /// 행 컷이 어느 셀에서든 저장 되감김 바로 앞에서 끝나는가. 컷 뒤 첫 줄의 저장 vpos 가
+    /// 컷의 마지막 줄보다 앞서면(문단 안이든 문단 경계든) 한글이 거기서 쪽을 끊었다.
+    pub(crate) fn row_cut_ends_at_stored_rewind(
+        &self,
+        table: &crate::model::table::Table,
+        row: usize,
+        end_cut: &[usize],
+        styles: &ResolvedStyleSet,
+    ) -> bool {
+        let mut cells: Vec<&crate::model::table::Cell> = table
+            .cells
+            .iter()
+            .filter(|cell| cell.row as usize == row && cell.row_span == 1)
+            .collect();
+        cells.sort_by_key(|cell| cell.col);
+        cells.iter().zip(end_cut).any(|(cell, &end)| {
+            let units = self.cell_units(cell, table, styles);
+            Self::unit_starts_stored_rewind(cell, &units, end)
+        })
+    }
+
+    /// 행 컷이 저장 사다리로 닫는 잉크 상자 높이(px)와 그 뒤 전진(px).
