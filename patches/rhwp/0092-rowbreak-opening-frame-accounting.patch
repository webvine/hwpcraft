diff --git a/src/renderer/typeset.rs b/src/renderer/typeset.rs
index 4c301e2..6750b6a 100644
--- a/src/renderer/typeset.rs
+++ b/src/renderer/typeset.rs
@@ -8400,4 +8400,89 @@ mod tests {
             "답변 셀은 저장 되감김 앞 2줄에서 끝나야 한다"
         );
     }
+
+    /// 편람 구역 10 질의응답 표(빈 host 다행 RowBreak)의 첫 조각은 앞 표 아래 앞 문단
+    /// 줄간격을 두고 시작해 선언 상자 안에서 끝난다. 한글 2024 PDF(.hwp·.hwpx 같음):
+    /// 질문 5 735.0~886.8px, 질문 7 692.8~866.6px, 질문 9 692.3~875.4px, 질문 11 은 앞 표
+    /// 하단 7.5px 아래 시작해 866.3px 에서 끝난다.
+    #[test]
+    fn handbook_q_and_a_fragments_keep_the_previous_line_spacing() {
+        use crate::renderer::render_tree::{RenderNode, RenderNodeType};
+
+        fn collect(node: &RenderNode, body: &mut f64, tables: &mut Vec<(usize, f64, f64)>) {
+            match &node.node_type {
+                RenderNodeType::Body { .. } => *body = node.bbox.y + node.bbox.height,
+                RenderNodeType::Table(table) => {
+                    if let Some(para) = table.para_index {
+                        tables.push((para, node.bbox.y, node.bbox.y + node.bbox.height));
+                    }
+                    return;
+                }
+                _ => {}
+            }
+            for child in &node.children {
+                collect(child, body, tables);
+            }
+        }
+
+        for ext in ["hwp", "hwpx"] {
+            let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+                .join(format!("samples/2025 행정업무운영 편람(최종).{ext}"));
+            let Ok(bytes) = std::fs::read(&path) else {
+                eprintln!("skip: {} 없음", path.display());
+                continue;
+            };
+            let core =
+                crate::document_core::DocumentCore::from_bytes(&bytes).expect("parse handbook");
+            let section_start: usize = core.pagination[..10].iter().map(|pr| pr.pages.len()).sum();
+            // (문단, 한글 상단, 한글 하단) — 상단은 앞 표 하단 + 앞 문단 줄간격.
+            for (para, top, bottom) in [
+                (12, 735.0, 886.8),
+                (14, 692.8, 866.6),
+                (23, 472.0, 866.3),
+                (35, 692.3, 875.4),
+            ] {
+                let local = core.pagination[10]
+                    .pages
+                    .iter()
+                    .position(|page| {
+                        page.column_contents.iter().any(|column| {
+                            column.items.iter().any(|item| {
+                                matches!(item, PageItem::PartialTable {
+                                    para_index,
+                                    is_continuation: false,
+                                    ..
+                                } if *para_index == para)
+                            })
+                        })
+                    })
+                    .unwrap_or_else(|| panic!("{ext} pi={para} 첫 조각 쪽"));
+                let tree = core
+                    .build_page_render_tree((section_start + local) as u32)
+                    .expect("render tree");
+                let mut body_bottom = 0.0;
+                let mut tables = Vec::new();
+                collect(&tree.root, &mut body_bottom, &mut tables);
+                let (_, y, end) = tables
+                    .iter()
+                    .copied()
+                    .find(|t| t.0 == para)
+                    .unwrap_or_else(|| panic!("{ext} pi={para} 표 노드: {tables:?}"));
+                assert!(
+                    (y - top).abs() <= 1.0,
+                    "{ext} pi={para} 상단 {y:.1}px (한글 {top}px)"
+                );
+                assert!(
+                    end <= body_bottom + 0.5,
+                    "{ext} pi={para} 첫 조각 하단 {end:.1} 이 본문 하단 {body_bottom:.1} 을 넘는다"
+                );
+                if ext == "hwp" {
+                    assert!(
+                        (end - bottom).abs() <= 1.0,
+                        "{ext} pi={para} 하단 {end:.1}px (한글 {bottom}px)"
+                    );
+                }
+            }
+        }
+    }
 }
