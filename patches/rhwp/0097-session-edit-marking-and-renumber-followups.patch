+#[cfg(test)]
+mod hwpcraft_set_document_marks_tests {
+    use super::DocumentCore;
+
+    fn edited(core: &DocumentCore) -> Vec<usize> {
+        core.document().sections[0]
+            .paragraphs
+            .iter()
+            .enumerate()
+            .filter_map(|(i, p)| p.edited_in_session.then_some(i))
+            .collect()
+    }
+
+    /// A copy handed back without some paragraphs marks the paragraphs the removal
+    /// joined: the one after a removed middle paragraph, and the last one left when
+    /// the trailing ones were removed.
+    #[test]
+    fn removed_paragraphs_mark_where_they_were() {
+        let mut core =
+            DocumentCore::from_bytes(include_bytes!("../../../samples/20250130-hongbo.hwp"))
+                .expect("open");
+        core.insert_text_native(0, 0, 0, "x").expect("insert");
+        let mut doc = core.document().clone();
+        doc.sections[0].paragraphs.remove(9);
+        core.set_document(doc);
+        assert_eq!(edited(&core), [0, 9]);
+
+        let mut doc = core.document().clone();
+        let keep = doc.sections[0].paragraphs.len() - 2;
+        doc.sections[0].paragraphs.truncate(keep);
+        core.set_document(doc);
+        assert_eq!(edited(&core), [0, 9, keep - 1]);
+    }
+
+    /// A section that starts on an odd page and so skips a number is renumbered right
+    /// when the section before it gains a page.
+    #[test]
+    fn an_odd_start_section_follows_a_page_gained_before_it() {
+        let mut core = DocumentCore::from_bytes(include_bytes!(
+            "../../../samples/hwp-multi-001.hwp"
+        ))
+        .expect("open");
+        let mut doc = core.document().clone();
+        doc.sections[1].section_def.page_num_type = 1;
+        core.set_document(doc);
+        let before = core.page_count();
+        let mut splits = 0;
+        while core.page_count() == before && splits < 200 {
+            core.split_paragraph_native(0, 0, 0, None).expect("split");
+            splits += 1;
+        }
+        let mut fresh = DocumentCore::new_empty();
+        fresh.set_document(core.document().clone());
+        assert_eq!(core.dump_page_items(None), fresh.dump_page_items(None));
+    }
+}
