diff --git a/src/serializer/control/tests.rs b/src/serializer/control/tests.rs
index d6ca637..c54590e 100644
--- a/src/serializer/control/tests.rs
+++ b/src/serializer/control/tests.rs
@@ -6,6 +6,39 @@ use crate::model::shape::{GroupShape, RectangleShape};
 use crate::parser::body_text::parse_body_text_section;
 use crate::serializer::body_text::serialize_section;
 
+/// HWP5 FOOTNOTE_SHAPE: the separator length is one four-byte field, then the space
+/// above the line. Hangul reads `FF FF 52 03` as 0x0352FFFF (a column-wide line), so
+/// a 5 cm line (−1) from HWPX with `aboveLine` 850 must not put 850 into the length.
+#[test]
+fn note_separator_length_is_one_four_byte_field() {
+    use crate::model::footnote::FootnoteShape;
+    use crate::parser::body_text::parse_footnote_shape_record;
+    let from_hwpx = FootnoteShape {
+        separator_length: -1,
+        separator_margin_top: 850,
+        note_spacing: 567,
+        ..Default::default()
+    };
+    let bytes = serialize_footnote_shape(&from_hwpx);
+    assert_eq!(bytes.len(), 28);
+    assert_eq!(bytes[12..16], (-1i32).to_le_bytes());
+    assert_eq!(bytes[16..18], 850i16.to_le_bytes());
+    assert_eq!(bytes[18..20], 567i16.to_le_bytes());
+    let back = parse_footnote_shape_record(&bytes);
+    assert_eq!(back.separator_length, -1);
+    assert_eq!(back.separator_above_margin_hu(), 850);
+    // What an HWP5 file holds reads as one length and writes the same bytes back.
+    for length in [-1i32, 0x0352_FFFF, 14_692_344, 5_669, 0] {
+        let mut record = vec![0u8; 28];
+        record[12..16].copy_from_slice(&length.to_le_bytes());
+        record[16..18].copy_from_slice(&852i16.to_le_bytes());
+        let shape = parse_footnote_shape_record(&record);
+        assert_eq!(shape.separator_length, length);
+        assert_eq!(shape.separator_above_margin_hu(), 852);
+        assert_eq!(serialize_footnote_shape(&shape), record, "{length:#x}");
+    }
+}
