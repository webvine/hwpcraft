+/// 나눔 정렬은 0 — 열 위부터 놓는다.
+fn vertical_align_lead(
+    line: &ComposedLine,
+    styles: &ResolvedStyleSet,
+    text_direction: u8,
+    para_style_id: u16,
+    length: f64,
+) -> f64 {
+    let alignment = styles
+        .para_styles
+        .get(para_style_id as usize)
+        .map(|s| s.alignment)
+        .unwrap_or_default();
+    let factor = match alignment {
+        Alignment::Center => 0.5,
+        Alignment::Right => 1.0,
+        _ => return 0.0,
+    };
+    let offsets = vertical_line_offsets(line, styles, text_direction);
+    let chars: Vec<char> = line.runs.iter().flat_map(|r| r.text.chars()).collect();
+    let mut end = chars.len();
+    while end > 0 && chars[end - 1].is_whitespace() {
+        end -= 1;
+    }
+    let used = offsets.get(end).copied().unwrap_or(0.0);
+    ((length - used) * factor).max(0.0)
+}
