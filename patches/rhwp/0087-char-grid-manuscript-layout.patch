+            if let crate::renderer::render_tree::RenderNodeType::TextRun(run) = &node.node_type {
+                out.push((run.text.clone(), run.style.char_grid.is_some()));
+            }
+            for child in &node.children {
+                walk(child, out);
+            }
+        }
+        walk(&tree.root, &mut runs);
+        let gridded = |needle: &str| {
+            runs.iter()
+                .filter(|(text, _)| text.contains(needle))
+                .map(|(_, grid)| *grid)
+                .collect::<Vec<_>>()
+        };
+        assert_eq!(gridded("본"), [true], "{runs:?}");
+        assert_eq!(gridded("머"), [false], "{runs:?}");
+    }
+
+    /// 칸마다 가운데에 그리고, 반각 둘은 한 칸을 나눠 쓴다.
+    #[test]
+    fn char_grid_positions_centre_each_cell() {
+        let style = crate::renderer::TextStyle {
+            font_size: 13.0,
+            char_grid: Some(crate::renderer::CharGridCell {
+                cell_px: 30.0,
+                pairs: true,
+            }),
+            ..Default::default()
+        };
+        let positions = crate::renderer::layout::compute_char_positions("가A1", &style);
+        assert_eq!(positions.len(), 4);
+        assert!(positions[0] > 0.0 && positions[0] < 15.0, "{positions:?}");
+        assert!(
+            positions[1] > 30.0 && positions[2] > positions[1],
+            "{positions:?}"
+        );
+        assert!(positions[2] < 60.0, "{positions:?}");
+        assert_eq!(positions[3], 60.0);
+    }
+}
