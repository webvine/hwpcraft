+/// [HwpCraft 0087] 글자 격자(원고지) 구역의 본문 문단을 칸 수로 나눈다.
+///
+/// 한 줄은 상자 폭을 칸 너비로 나눈 칸 수만큼 글자를 담는다. 글자마다 한 칸이고, 원고지
+/// 정서법이면 이어진 반각 영문·숫자 두 자가 한 칸이다. 칸이 다 찬 줄 뒤의 공백 하나는 그
+/// 줄에 매달린다. 한글 2024 실측(원고지 정서법, 20칸): `원고지에 글을 씁니다. Hello
+/// 2026년 10월, …` 이 25·21·3 글자로 나뉜다. 줄 높이는 줄 격자, 글자는 줄 아래쪽의 정사각
+/// 칸 가운데에 오도록 기준선을 둔다(원고지 용지가 칸 위에 띠를 두는 배치).
+pub(crate) fn reflow_line_segs_on_char_grid(
+    para: &mut Paragraph,
+    paragraph_box: &ParagraphBox,
+    grid: CharGrid,
+    styles: &ResolvedStyleSet,
+    dpi: f64,
+) {
+    let columns = usize::try_from(paragraph_box.width_hwp() / grid.cell_hwp.max(1))
+        .unwrap_or(0)
+        .max(1);
+    let chars: Vec<char> = para.text.chars().collect();
+    let half = |c: char| c.is_ascii_alphanumeric();
+    let mut starts = vec![0usize];
+    let mut cells = 0usize;
+    let mut i = 0usize;
+    while i < chars.len() {
+        if cells == columns {
+            if chars[i] == ' ' {
+                i += 1;
+            }
+            if i < chars.len() {
+                starts.push(i);
+            }
+            cells = 0;
+            continue;
+        }
+        let pair = grid.pairs && half(chars[i]) && chars.get(i + 1).copied().is_some_and(half);
+        cells += 1;
+        i += if pair { 2 } else { 1 };
+    }
+    let font_size = paragraph_font_size_px(para, styles).unwrap_or(12.0);
+    let text_height = font_size_to_line_height(font_size, dpi);
+    let pitch = grid.pitch_hwp.max(text_height);
+    // 줄 아래쪽 정사각 칸의 가운데에 글자 상자(기준선 위 0.85, 아래 0.15)의 가운데를 둔다.
+    let square = grid.cell_hwp.min(pitch);
+    let centre = f64::from(pitch) - f64::from(square) / 2.0;
+    let baseline = (centre + 0.35 * f64::from(text_height)).round() as i32;
+    let orig = para.line_segs.first().cloned();
+    let tag = orig
+        .as_ref()
+        .map(|line| line.tag)
+        .filter(|&tag| tag != 0)
+        .unwrap_or(LineSeg::TAG_SINGLE_SEGMENT_LINE | LineSeg::TAG_IMPLEMENTATION_PROPERTY);
+    let mut vpos = orig.as_ref().map_or(0, |line| line.vertical_pos);
+    let horizontal = paragraph_box.effective();
+    let segs = starts
+        .iter()
+        .enumerate()
+        .map(|(index, &start)| {
+            let seg = LineSeg {
+                text_start: if index == 0 {
+                    0
+                } else {
+                    char_index_to_utf16_offset(para, start)
+                },
+                vertical_pos: vpos,
+                line_height: pitch,
+                text_height,
+                baseline_distance: baseline.min(pitch),
+                line_spacing: 0,
+                column_start: horizontal.start,
+                segment_width: paragraph_box.width_hwp(),
+                tag,
+                ..Default::default()
+            };
+            vpos += pitch;
+            seg
+        })
+        .collect();
+    para.layout_only_fill_lines = 0;
+    para.replace_line_segs(segs);
+}
