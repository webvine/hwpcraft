--- a/src/document_core/commands/document.rs
+++ b/src/document_core/commands/document.rs
@@ -4391,3 +4391,28 @@ mod hwpcraft_session_edit_scope_tests {
         assert!(!untouched.section_layout_profile(0).session_edited());
     }
 }
+
+#[cfg(test)]
+mod hwpcraft_section_renumber_tests {
+    use super::DocumentCore;
+
+    /// An earlier section that gains a page renumbers the sections after it, which the
+    /// edit leaves untouched (they kept the page numbers they were laid out with).
+    #[test]
+    fn a_section_that_gains_a_page_renumbers_the_next_sections() {
+        let mut core = DocumentCore::from_bytes(include_bytes!(
+            "../../../samples/hwp-multi-001.hwp"
+        ))
+        .expect("open");
+        let before = core.page_count();
+        let mut splits = 0;
+        while core.page_count() == before && splits < 200 {
+            core.split_paragraph_native(0, 0, 0, None).expect("split");
+            splits += 1;
+        }
+        assert!(core.page_count() > before);
+        let mut fresh = DocumentCore::new_empty();
+        fresh.set_document(core.document().clone());
+        assert_eq!(core.dump_page_items(None), fresh.dump_page_items(None));
+    }
+}
