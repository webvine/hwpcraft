+#[cfg(test)]
+mod tac_object_line_layout_tests {
+    //! 글자처럼 취급한 그림·도형이 있는 줄의 높이는 개체의 점유 높이(개체 + 위아래 바깥 여백)와
+    //! 글자 중 큰 값이고, 기준선은 그 줄 높이의 0.85 다 — 한글이 저장한 줄이 그 값이다. 저장
+    //! 줄이 없는 문단(줄 정보 없이 쓴 HWPX)의 조판과 렌더, 저장 줄이 있는 문단의 렌더가 모두
+    //! 같은 줄을 쓴다. 기대값은 한글 저장 줄(`LineSeg`)에서 온다.
+    use super::*;
+    use crate::renderer::render_tree::{RenderNode, RenderNodeType};
+
+    const HWP5: &str = "samples/HWP5-nopassword-123456.hwp";
+
+    fn px(hu: i32) -> f64 {
+        hu as f64 * 96.0 / 7200.0
+    }
+
+    fn open(path: &str, keep_rows: bool) -> DocumentCore {
+        let data = std::fs::read(path).unwrap_or_else(|e| panic!("sample {path}: {e}"));
+        DocumentCore::from_bytes_prepared(&data, None, |doc| {
+            if !keep_rows {
+                for section in &mut doc.sections {
+                    for para in &mut section.paragraphs {
+                        para.line_segs.clear();
+                    }
+                }
+            }
+            Ok(())
+        })
+        .unwrap()
+    }
+
+    /// Typeset height of body paragraph `para` of section 0 (sum of its line heights, px).
+    fn typeset_height(core: &DocumentCore, para: usize) -> f64 {
+        let pages = core.dump_page_items_json(None);
+        pages
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter(|page| page["section"].as_u64() == Some(0))
+            .flat_map(|page| page["columns"].as_array().into_iter().flatten())
+            .flat_map(|col| col["items"].as_array().into_iter().flatten())
+            .find(|item| {
+                item["kind"] == "fullParagraph" && item["paraIndex"].as_u64() == Some(para as u64)
+            })
+            .and_then(|item| item["height"]["lineHeightSum"].as_f64())
+            .unwrap_or_else(|| panic!("paragraph {para} is not laid out whole"))
+    }
+
+    /// Drawn body lines of paragraph `para` of section 0: (top, height, baseline) px.
+    fn drawn_lines(core: &DocumentCore, para: usize) -> Vec<(f64, f64, f64)> {
+        fn walk(node: &RenderNode, para: usize, out: &mut Vec<(f64, f64, f64)>) {
+            if let RenderNodeType::TextLine(line) = &node.node_type {
+                if line.section_index == Some(0)
+                    && line.para_index == Some(para)
+                    && line.caption_owner.is_none()
+                {
+                    out.push((node.bbox.y, line.line_height, line.baseline));
+                }
+            }
+            // A text box draws its own paragraphs; they are not lines of the body paragraph.
+            if matches!(node.node_type, RenderNodeType::TextBox) {
+                return;
+            }
+            for child in &node.children {
+                walk(child, para, out);
+            }
+        }
+        for page in 0..core.page_count() {
+            let tree = core.build_page_render_tree(page).unwrap();
+            let mut out = Vec::new();
+            walk(&tree.root, para, &mut out);
+            if !out.is_empty() {
+                return out;
+            }
+        }
+        panic!("paragraph {para} is not drawn");
+    }
+
+    #[test]
+    fn a_rowless_paragraph_lays_text_and_an_inline_shape_out_as_hangul_stored_it() {
+        // p12..22: a tab, a number and a treat-as-character rectangle taller than the text.
+        let stored = open(HWP5, true);
+        let fresh = open(HWP5, false);
+        for para in 12..=22 {
+            let rows = &stored.document.sections[0].paragraphs[para].line_segs;
+            let hangul: f64 = rows.iter().map(|s| px(s.line_height)).sum();
+            let ours = typeset_height(&fresh, para);
+            assert!(
+                (ours - hangul).abs() < 0.5,
+                "p{para}: typeset {ours:.1} px, Hangul stored {hangul:.1} px"
+            );
+            let lines = drawn_lines(&fresh, para);
+            assert_eq!(lines.len(), rows.len(), "p{para}: {lines:?}");
+            let (_, height, baseline) = lines[0];
+            assert!(
+                (height - px(rows[0].line_height)).abs() < 0.5
+                    && (baseline - px(rows[0].baseline_distance)).abs() < 0.5,
+                "p{para}: drawn line {height:.1}/{baseline:.1} px, Hangul {:.1}/{:.1} px",
+                px(rows[0].line_height),
+                px(rows[0].baseline_distance)
+            );
+        }
+    }
+
+    #[test]
+    fn a_rowless_inline_picture_line_holds_the_picture_and_its_outer_margins() {
+        // p14: a 22308-unit picture with 852-unit outer margins; Hangul's line is 24012.
+        let path = "samples/hwp3-sample11-hwpx.hwpx";
+        let stored = open(path, true);
+        let rows = &stored.document.sections[0].paragraphs[14].line_segs;
+        assert_eq!(rows[0].line_height, 24012, "the sample's Hangul line");
+        let ours = typeset_height(&open(path, false), 14);
+        assert!(
+            (ours - px(24012)).abs() < 0.5,
+            "typeset {ours:.1} px, Hangul {:.1} px",
+            px(24012)
+        );
+    }
+
+    #[test]
+    fn a_stored_line_holding_text_and_a_taller_inline_shape_is_drawn_at_its_stored_height() {
+        let core = open(HWP5, true);
+        for para in 12..=22 {
+            let row = &core.document.sections[0].paragraphs[para].line_segs[0];
+            let (_, height, baseline) = drawn_lines(&core, para)[0];
+            assert!(
+                (height - px(row.line_height)).abs() < 0.5
+                    && (baseline - px(row.baseline_distance)).abs() < 0.5,
+                "p{para}: drawn {height:.1}/{baseline:.1} px, stored {:.1}/{:.1} px",
+                px(row.line_height),
+                px(row.baseline_distance)
+            );
+        }
+    }
+
+    #[test]
+    fn the_lines_after_an_inserted_inline_shape_are_drawn_below_it() {
+        let text = "글자처럼 취급한 개체 주변 본문 흐름 확인용 문장입니다. ".repeat(8);
+        for kind in ["rectangle", "textbox"] {
+            let mut core = DocumentCore::new_empty();
+            core.create_blank_document_native().unwrap();
+            core.insert_text_native(0, 0, 0, &text).unwrap();
+            core.create_shape_control_native(
+                0,
+                0,
+                10,
+                11339,
+                7654,
+                0,
+                0,
+                true,
+                "TopAndBottom",
+                kind,
+                false,
+                false,
+                &[],
+            )
+            .unwrap();
+            let lines = drawn_lines(&core, 0);
+            assert!(lines.len() >= 3, "{kind}: {lines:?}");
+            let (top, _, _) = lines[0];
+            for (i, (y, _, _)) in lines.iter().enumerate().skip(1) {
+                assert!(
+                    *y >= top + px(7654) - 0.5,
+                    "{kind}: line {i} at {y:.1} px is drawn inside the shape ({top:.1} + {:.1})",
+                    px(7654)
+                );
+            }
+        }
+    }
+}
