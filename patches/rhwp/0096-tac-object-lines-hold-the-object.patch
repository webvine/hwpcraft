+/// (HWP5-nopassword-123456.hwp 12문단: 글자 + 도형 2328 → 줄 2328/2328/1979).
+pub(super) fn supports_tac_object_frame_controls(para: &Paragraph) -> bool {
+    let mut tac_objects = 0usize;
+    for control in &para.controls {
