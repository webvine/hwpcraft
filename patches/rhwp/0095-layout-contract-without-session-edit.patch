@@ -4605,3 +4605,40 @@ mod hwpcraft_kept_section_carry_tests {
         }
     }
 }
+
+#[cfg(test)]
+mod hwpcraft_layout_contract_tests {
+    use super::DocumentCore;
+
+    fn pages(core: &DocumentCore) -> Vec<String> {
+        (0..core.page_count())
+            .map(|page| core.render_page_svg_native(page).expect("svg"))
+            .collect()
+    }
+
+    /// The first edit leaves the layout contract as it was, so an undo back to the
+    /// opened state rebuilds only the edited section (it rebuilt every section).
+    #[test]
+    fn undo_to_the_opened_state_rebuilds_only_the_edited_section() {
+        let mut core = DocumentCore::from_bytes(include_bytes!(
+            "../../../samples/hwp-multi-001.hwp"
+        ))
+        .expect("open");
+        let opened = pages(&core);
+        let id = core.save_snapshot_native();
+        let last = core.document().sections.len() - 1;
+        core.insert_text_native(last, 0, 0, "x").expect("insert");
+        let (_, doc, _, stamps) = core
+            .snapshot_store
+            .iter()
+            .find(|(sid, ..)| *sid == id)
+            .cloned()
+            .expect("snapshot");
+        let changed = core
+            .snapshot_changed_sections(&doc, &stamps)
+            .expect("unchanged sections are reused");
+        assert_eq!(changed.iter().filter(|changed| **changed).count(), 1);
+        core.restore_snapshot_native(id).expect("restore");
+        assert_eq!(pages(&core), opened);
+    }
+}
