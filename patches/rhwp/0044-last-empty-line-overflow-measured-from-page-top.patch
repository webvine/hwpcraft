diff --git a/src/document_core/commands/document.rs b/src/document_core/commands/document.rs
index 96f6a9f..8ee35f0 100644
--- a/src/document_core/commands/document.rs
+++ b/src/document_core/commands/document.rs
@@ -4221,6 +4221,37 @@ mod fresh_flow_tests {
         core.reflow_linesegs_on_demand();
         assert_eq!(rows(&core), live);
     }
+
+    /// A last empty line that fits the body stays on its page on later pages too.
+    /// The fresh layout of a section without rows does not rewind vpos at page
+    /// boundaries, so measured from 0 that line read as past the body and the
+    /// layout added a blank page.
+    #[test]
+    fn a_fresh_layout_keeps_a_last_empty_line_that_fits_on_a_later_page() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        // Landscape A4 holds 25 rows of 10 pt at 160% (1,600 HU) in its 41,104 HU
+        // body. The 26th, empty row ends at 41,000 HU: inside the body, but within
+        // the 4 px layout safety margin.
+        let mut doc = core.document().clone();
+        doc.sections[0].section_def.page_def.landscape = true;
+        core.set_document(doc);
+        for i in 0..50 {
+            let text = format!("줄 {i}");
+            core.insert_text_native(0, i, 0, &text).unwrap();
+            core.split_paragraph_native(0, i, text.chars().count(), None)
+                .unwrap();
+        }
+        assert_eq!(core.page_count(), 2);
+        let mut doc = core.document().clone();
+        for p in &mut doc.sections[0].paragraphs {
+            p.line_segs.clear();
+        }
+        core.set_document(doc);
+        core.validation_report = DocumentCore::validate_linesegs(&core.document, true);
+        core.reflow_linesegs_on_demand();
+        assert_eq!(core.page_count(), 2);
+    }
 }
 
