+#[cfg(test)]
+mod hwpcraft_session_edit_scope_tests {
+    use super::DocumentCore;
+
+    fn pages(core: &DocumentCore) -> Vec<String> {
+        (0..core.page_count())
+            .map(|page| core.render_page_svg_native(page).expect("svg"))
+            .collect()
+    }
+
+    /// An edit lays out the pages before it as they were opened. One edited section
+    /// used to turn the stored-geometry rules off for the whole document: typing at
+    /// the end of this press release moved the head tables of page 1 by 8–14 px.
+    #[test]
+    fn an_edit_keeps_the_pages_before_it_as_opened() {
+        let mut core =
+            DocumentCore::from_bytes(include_bytes!("../../../samples/20250130-hongbo.hwp"))
+                .expect("open");
+        let opened = pages(&core);
+        let last = core.document().sections[0].paragraphs.len() - 1;
+        let end = core.document().sections[0].paragraphs[last]
+            .text
+            .chars()
+            .count();
+        core.insert_text_native(0, last, end, "x").expect("insert");
+        core.delete_text_native(0, last, end, 1).expect("delete");
+        assert!(core.document().layout_profile().session_edited());
+        assert_eq!(pages(&core), opened);
+        let profile = core.document().section_layout_profile(0);
+        assert!(!profile.at_paragraph(0).session_edited());
+        assert!(profile.at_paragraph(last).session_edited());
+
+        // A paragraph near the top: the rules apply from there on.
+        core.insert_text_native(0, 7, 0, "가").expect("insert");
+        let profile = core.document().section_layout_profile(0);
+        assert!(!profile.at_paragraph(6).session_edited());
+        assert!(profile.at_paragraph(7).session_edited());
+    }
+
+    /// A caller that changes a paragraph through `document_mut` and lays it out again
+    /// with `relayout_paragraph_native`, or hands back a changed copy with
+    /// `set_document`, marks it as the edit commands mark theirs, so the session-edit
+    /// rules cover it after an edit further down.
+    #[test]
+    fn paragraphs_changed_through_the_model_are_marked() {
+        let mut core =
+            DocumentCore::from_bytes(include_bytes!("../../../samples/20250130-hongbo.hwp"))
+                .expect("open");
+        let last = core.document().sections[0].paragraphs.len() - 1;
+        core.insert_text_native(0, last, 0, "x").expect("insert");
+        let shape = core.document().sections[0].paragraphs[7].para_shape_id;
+        core.document_mut().sections[0].paragraphs[9].para_shape_id = shape;
+        core.relayout_paragraph_native(0, 9, None).expect("relayout");
+        let edited = |core: &DocumentCore| -> Vec<usize> {
+            core.document().sections[0]
+                .paragraphs
+                .iter()
+                .enumerate()
+                .filter_map(|(i, p)| p.edited_in_session.then_some(i))
+                .collect()
+        };
+        assert_eq!(edited(&core), [9, last]);
+        let profile = core.document().section_layout_profile(0);
+        assert!(!profile.at_paragraph(8).session_edited());
+        assert!(profile.at_paragraph(9).session_edited());
+
+        let mut doc = core.document().clone();
+        doc.sections[0].paragraphs[3].para_shape_id = shape;
+        core.set_document(doc);
+        assert_eq!(edited(&core), [3, 9, last]);
+    }
+
+    /// A copy of the edited model lays out like the live core, and a section the edit
+    /// did not touch keeps the stored rules.
+    #[test]
+    fn a_copy_of_an_edited_model_keeps_the_edit_start() {
+        let mut core =
+            DocumentCore::from_bytes(include_bytes!("../../../samples/20250130-hongbo.hwp"))
+                .expect("open");
+        let last = core.document().sections[0].paragraphs.len() - 1;
+        core.insert_text_native(0, last, 0, "x").expect("insert");
+        let mut copy = DocumentCore::new_empty();
+        copy.set_document(core.document().clone());
+        assert_eq!(pages(&copy), pages(&core));
+        let mut untouched = core.document().clone();
+        untouched.sections[0].raw_stream = Some(Vec::new());
+        assert!(!untouched.section_layout_profile(0).session_edited());
+    }
+}
