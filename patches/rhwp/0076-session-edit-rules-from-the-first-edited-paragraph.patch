+    /// [HwpCraft] [`Self::layout_profile`] for laying out section `section_index`.
+    ///
+    /// The session-edit rules (`session_edited`) exist because an edit leaves stored
+    /// coordinates stale. Before this, one edited section turned them off for the whole
+    /// document, so typing one character anywhere moved unedited earlier pages (a page
+    /// head table by 8–14 px in about a third of the HWP samples) and a saved HWP opened
+    /// as it did before the edit. They now apply only to an edited section, from its
+    /// first body paragraph an edit laid out again (`Paragraph::edited_in_session`,
+    /// [`LayoutCompatibilityProfile::at_paragraph`]). An edited section without such a
+    /// paragraph (an edit that laid no paragraph out again, or one undone) keeps the
+    /// rules throughout, as before.
+    pub fn section_layout_profile(
+        &self,
+        section_index: usize,
+    ) -> crate::model::provenance::LayoutCompatibilityProfile {
+        let profile = self.layout_profile();
+        if !profile.session_edited() {
+            return profile;
+        }
+        let Some(section) = self.sections.get(section_index) else {
+            return profile;
+        };
+        if section.raw_provenance.is_none() || section.raw_stream.is_some() {
+            return profile.with_session_edited(false);
+        }
+        let start = section
+            .paragraphs
+            .iter()
+            .position(|p| p.edited_in_session)
+            .unwrap_or(0);
+        profile.with_session_edit_start(start)
+    }
