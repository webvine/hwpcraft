+/// [HwpCraft] A paragraph's text, shapes, rows and controls, with the paragraphs inside
+/// its tables, boxes, captions and notes: what tells a changed paragraph apart.
+fn paragraph_fingerprint(para: &Paragraph) -> u64 {
+    use std::hash::{Hash, Hasher};
+    fn list(paragraphs: &[Paragraph], h: &mut impl Hasher) {
+        paragraphs.len().hash(h);
+        for p in paragraphs {
+            one(p, h);
+        }
+    }
+    fn shape(s: &ShapeObject, h: &mut impl Hasher) {
+        let c = s.common();
+        (c.width, c.height, c.horizontal_offset, c.vertical_offset).hash(h);
+        if let ShapeObject::Group(g) = s {
+            for child in &g.children {
+                shape(child, h);
+            }
+        }
+        if let Some(d) = s.drawing() {
+            if let Some(t) = &d.text_box {
+                list(&t.paragraphs, h);
+            }
+            if let Some(c) = &d.caption {
+                list(&c.paragraphs, h);
+            }
+        }
+    }
+    fn one(p: &Paragraph, h: &mut impl Hasher) {
+        p.text.hash(h);
+        (p.para_shape_id, p.style_id).hash(h);
+        for r in &p.char_shapes {
+            (r.start_pos, r.char_shape_id).hash(h);
+        }
+        for l in &p.line_segs {
+            (
+                l.text_start,
+                l.vertical_pos,
+                l.line_height,
+                l.text_height,
+                l.baseline_distance,
+                l.line_spacing,
+                l.column_start,
+                l.segment_width,
+                l.tag,
+            )
+                .hash(h);
+        }
+        for c in &p.controls {
+            std::mem::discriminant(c).hash(h);
+            match c {
+                Control::Table(t) => {
+                    let m = &t.common;
+                    (m.width, m.height, m.horizontal_offset, m.vertical_offset).hash(h);
+                    (t.row_count, t.col_count, t.cells.len()).hash(h);
+                    for cell in &t.cells {
+                        (cell.width, cell.height).hash(h);
+                        list(&cell.paragraphs, h);
+                    }
+                    if let Some(c) = &t.caption {
+                        list(&c.paragraphs, h);
+                    }
+                }
+                Control::Picture(pic) => {
+                    let m = &pic.common;
+                    (m.width, m.height, m.horizontal_offset, m.vertical_offset).hash(h);
+                    if let Some(c) = &pic.caption {
+                        list(&c.paragraphs, h);
+                    }
+                }
+                Control::Shape(s) => shape(s, h),
+                Control::Footnote(n) => list(&n.paragraphs, h),
+                Control::Endnote(n) => list(&n.paragraphs, h),
+                Control::Header(n) => list(&n.paragraphs, h),
+                Control::Footer(n) => list(&n.paragraphs, h),
+                _ => {}
+            }
+        }
+    }
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    one(para, &mut h);
+    h.finish()
+}
