+/// [HwpCraft] A caller that changed a copy of the document and hands it back
+/// (`set_document`) says nothing about what it changed. In each section of the same
+/// loaded document that the session edits, the paragraphs between the first and the
+/// last one that differ are marked `edited_in_session`, as the edit commands mark the
+/// paragraphs they lay out again. A fresh core holds no loaded document to compare.
+fn mark_paragraphs_changed_in_session(old: &Document, new: &mut Document) {
+    if old.sections.len() != new.sections.len() {
+        return;
+    }
+    for (before, after) in old.sections.iter().zip(new.sections.iter_mut()) {
+        if before.raw_provenance.is_none()
+            || after.raw_provenance.is_none()
+            || after.raw_stream.is_some()
+        {
+            continue;
+        }
+        let a: Vec<u64> = before.paragraphs.iter().map(paragraph_fingerprint).collect();
+        let b: Vec<u64> = after.paragraphs.iter().map(paragraph_fingerprint).collect();
+        let prefix = a.iter().zip(&b).take_while(|(x, y)| x == y).count();
+        let room = a.len().min(b.len()) - prefix;
+        let suffix = a
+            .iter()
+            .rev()
+            .zip(b.iter().rev())
+            .take(room)
+            .take_while(|(x, y)| x == y)
+            .count();
+        if prefix == a.len() && prefix == b.len() {
+            continue;
+        }
+        // Removed paragraphs leave their neighbours meeting at `prefix`.
+        let end = (b.len() - suffix).max(prefix + 1).min(b.len());
+        for para in &mut after.paragraphs[prefix.min(b.len())..end] {
+            para.edited_in_session = true;
+        }
+    }
+}
