+#[cfg(test)]
+mod hwpcraft_reflow_on_demand_tests {
+    use super::DocumentCore;
+
+    /// Lines reflowed after loading are measured again: the opened pages equal a
+    /// full rebuild of the same document (a table after them kept its old height).
+    #[test]
+    fn reflowed_lines_are_measured_again() {
+        let mut core = DocumentCore::from_bytes(include_bytes!(
+            "../../../samples/80168_regulatory_analysis.hwp"
+        ))
+        .expect("open");
+        assert!(core.reflow_linesegs_on_demand() > 0);
+        let opened = core.dump_page_items(None);
+        core.rebuild_derived_state();
+        assert_eq!(opened, core.dump_page_items(None));
+    }
+}
