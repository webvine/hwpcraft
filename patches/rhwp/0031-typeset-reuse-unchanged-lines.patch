+/// [HwpCraft 0031] 구역의 직전 조판 원본(머리말·쪽 번호 이월 같은 후처리 전)과 그 입력 서명.
+pub(crate) struct TypesetReuse {
+    key: u64,
+    /// 문단마다 조판이 읽는 줄 배치·분류의 서명. `None` = 판정하지 않는 문단(개체 등).
+    signatures: Vec<Option<u64>>,
+    raw: PaginationResult,
+    /// 이 원본으로 만든 `pagination[idx]` 의 조판 세대 번호. 쪽 목록을 다른 경로가
+    /// 갈아끼웠으면(준비 코어 교체·지연 조판) 구역의 세대가 0 이라 재사용하지 않는다.
+    produced: u64,
+}
+
+/// [HwpCraft 0031] 조판 세대 번호. 0 은 "재사용 원본에서 만든 쪽 목록이 아님" 이다.
+fn next_typeset_generation() -> u64 {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    static NEXT: AtomicU64 = AtomicU64::new(1);
+    NEXT.fetch_add(1, Ordering::Relaxed)
+}
+
+/// [HwpCraft 0031] 구역이 직전 조판 뒤에 바뀐 횟수(`stamps`)와 그중 문단 하나를 다시
+/// 조판한 횟수(`recomposed`). 둘이 같아야 바뀐 것이 표시된 문단뿐이다. 문단이 끼거나
+/// 빠졌거나(`structural`) `document_mut` 뒤(`untracked`)에는 다음 전체 조판까지 재사용하지
+/// 않는다. `generation` 은 지금 `pagination[idx]` 를 만든 조판의 세대 번호다(0 = 모름).
+/// `pagination` 을 조판 밖에서 갈아끼우는 코드는 `generation` 을 0 으로 만든다.
+#[derive(Debug, Default, Clone, Copy)]
+pub(crate) struct TypesetMarks {
+    stamps: u32,
+    recomposed: u32,
+    structural: u32,
+    pub(crate) untracked: bool,
+    pub(crate) generation: u64,
+}
+
+/// [HwpCraft 0031] 구역 조판의 문단 밖 입력. 문서에 미주가 있을 때 미주를 구역 밖으로
+/// 미루거나 모으는 구역(여러 구역 문서의 마지막 구역, 문서 끝 미주)은 `None` 이라 재사용하지
+/// 않는다. 미주가 없으면 미루거나 모을 것이 없어 그런 구역도 재사용한다.
+#[allow(clippy::too_many_arguments)]
+fn typeset_reuse_key(
+    idx: usize,
+    section_count: usize,
+    endnotes: bool,
+    section: &Section,
+    column_def: &ColumnDef,
+    profile: crate::model::provenance::LayoutCompatibilityProfile,
+    flow_spacing_before: bool,
+    page_tolerance: bool,
+    force_breaks: Option<&std::collections::HashSet<usize>>,
+    normalization: Option<u64>,
+    paragraphs: usize,
+    doc_info_stamp: u64,
+    para_styles: usize,
+    char_styles: usize,
+) -> Option<u64> {
+    use std::hash::{Hash, Hasher};
+    let doc_end_endnotes = matches!(
+        section.section_def.endnote_shape.placement,
+        crate::model::footnote::FootnotePlacement::EachColumn
+    );
+    if endnotes && section_count > 1 && (idx + 1 == section_count || doc_end_endnotes) {
+        return None;
+    }
+    let mut breaks: Vec<usize> = force_breaks.into_iter().flatten().copied().collect();
+    breaks.sort_unstable();
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    (
+        idx,
+        section_count,
+        endnotes,
+        paragraphs,
+        doc_info_stamp,
+        para_styles,
+        char_styles,
+    )
+        .hash(&mut h);
+    (flow_spacing_before, page_tolerance, normalization, breaks).hash(&mut h);
+    format!(
+        "{:?}|{:?}|{}|{:?}|{:?}|{:?}",
+        section.section_def.page_def,
+        column_def,
+        section.section_def.hide_empty_line,
+        profile,
+        section.section_def.footnote_shape,
+        section.section_def.endnote_shape
+    )
+    .hash(&mut h);
+    Some(h.finish())
+}
+
+/// [HwpCraft 0031] 조판이 문단에서 읽는 것의 서명: 문단 모양·스타일·나누기 종류, 글자
+/// 시작 위치를 뺀 줄 정보, 글이 비었는지·공백뿐인지 같은 분류, 줄마다 글자·탭·줄바꿈
+/// 분류. 크기가 없는 인라인 컨트롤(필드·책갈피·하이퍼링크·색인 표시)과 구역·단 정의(내용까지
+/// 서명)만 있는 문단만 판정하고, 그 밖의 컨트롤(표·그림·도형·각주·미주·머리말 등)이 있으면 `None`.
+fn typeset_paragraph_signature(
+    para: &Paragraph,
+    composed: Option<&ComposedParagraph>,
+) -> Option<u64> {
+    use std::hash::{Hash, Hasher};
+    let composed = composed?;
+    let inline_only = para.controls.iter().all(|c| {
+        matches!(
+            c,
+            Control::Field(_)
+                | Control::Bookmark(_)
+                | Control::Hyperlink(_)
+                | Control::IndexMark(_)
+                | Control::SectionDef(_)
+                | Control::ColumnDef(_)
+        )
+    });
+    if !inline_only || !composed.tac_controls.is_empty() {
+        return None;
+    }
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    (para.para_shape_id, para.style_id).hash(&mut h);
+    std::mem::discriminant(&para.column_type).hash(&mut h);
+    para.line_segs.len().hash(&mut h);
+    for s in &para.line_segs {
+        (
+            s.vertical_pos,
+            s.line_height,
+            s.text_height,
+            s.baseline_distance,
+            s.line_spacing,
+            s.column_start,
+            s.segment_width,
+            s.tag,
+        )
+            .hash(&mut h);
+    }
+    for c in &para.controls {
+        std::mem::discriminant(c).hash(&mut h);
+        // 단 수·간격 같은 정의 내용이 바뀌면 조판이 달라진다.
+        if matches!(c, Control::SectionDef(_) | Control::ColumnDef(_)) {
+            format!("{c:?}").hash(&mut h);
+        }
+    }
+    let text = &para.text;
+    (
+        text.is_empty(),
+        text.trim().is_empty(),
+        text.chars().all(char::is_whitespace),
+        text.replace(|c: char| c.is_control(), "").trim().is_empty(),
+        text.trim_start().starts_with('문'),
+    )
+        .hash(&mut h);
+    (composed.para_style_id, composed.lines.len()).hash(&mut h);
+    composed
+        .numbering_text
+        .as_ref()
+        .map(|(text, _)| text.as_str())
+        .hash(&mut h);
+    for line in &composed.lines {
+        let chars = || line.runs.iter().flat_map(|run| run.text.chars());
+        (
+            line.has_line_break,
+            chars().any(|c| c == '\t'),
+            line.runs.iter().all(|run| run.text.trim().is_empty()),
+            chars().any(|c| c > '\u{001F}' && c != '\u{FFFC}'),
+            chars().next().is_some() || line.has_line_break,
+            line.line_height,
+            line.baseline_distance,
+            line.segment_width,
+            line.column_start,
+            line.line_spacing,
+        )
+            .hash(&mut h);
+    }
+    Some(h.finish())
+}
