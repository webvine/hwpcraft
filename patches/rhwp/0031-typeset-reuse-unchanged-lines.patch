+
+    /// One section of `count` paragraphs, 1 to 25 short words long.
+    fn report(count: usize) -> DocumentCore {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        for i in 0..count {
+            let text = "가나다라 마바사 ".repeat(i % 5 * 6 + 1);
+            core.insert_text_native(0, i, 0, &text).unwrap();
+            if i + 1 < count {
+                core.split_paragraph_native(0, i, text.chars().count(), None)
+                    .unwrap();
+            }
+        }
+        core
+    }
+
+    fn mark_kept(core: &mut DocumentCore) {
+        let kept = core.typeset_reuse[0].as_mut().expect("kept typesetting");
+        kept.raw.pre_emitted_host_heights.insert(MARK, 1.0);
+    }
+
+    fn reused(core: &DocumentCore) -> bool {
+        core.pagination[0]
+            .pre_emitted_host_heights
+            .contains_key(&MARK)
+    }
+
+    fn pages(core: &DocumentCore) -> String {
+        format!(
+            "{:?}",
+            core.pagination[0]
+                .pages
+                .iter()
+                .map(|p| &p.column_contents)
+                .collect::<Vec<_>>()
+        )
+    }
+
+    fn fresh_pages(core: &DocumentCore) -> String {
+        let mut fresh = DocumentCore::new_empty();
+        fresh.create_blank_document_native().unwrap();
+        fresh.set_document(core.document().clone());
+        pages(&fresh)
+    }
+
+    /// Like `mark_kept` / `reused`, for section `idx`.
+    fn mark_kept_in(core: &mut DocumentCore, idx: usize) {
+        let kept = core.typeset_reuse[idx].as_mut().expect("kept typesetting");
+        kept.raw.pre_emitted_host_heights.insert(MARK, 1.0);
+    }
+
+    fn reused_in(core: &DocumentCore, idx: usize) -> bool {
+        core.pagination[idx]
+            .pre_emitted_host_heights
+            .contains_key(&MARK)
+    }
+
+    fn all_pages(core: &DocumentCore) -> String {
+        format!(
+            "{:?}",
+            core.pagination
+                .iter()
+                .map(|r| r
+                    .pages
+                    .iter()
+                    .map(|p| &p.column_contents)
+                    .collect::<Vec<_>>())
+                .collect::<Vec<_>>()
+        )
+    }
+
+    #[test]
+    fn sections_of_a_document_without_endnotes_are_reused_until_one_is_added() {
+        // Two sections, endnotes at the end of the document (Hangul's default placement).
+        let mut core = report(20);
+        let mut doc = core.document().clone();
+        let second = doc.sections[0].clone();
+        doc.sections.push(second);
+        for section in &mut doc.sections {
+            section.section_def.endnote_shape.placement =
+                crate::model::footnote::FootnotePlacement::EachColumn;
+        }
+        core.set_document(doc);
+        let fresh = |core: &DocumentCore| {
+            let mut fresh = DocumentCore::new_empty();
+            fresh.create_blank_document_native().unwrap();
+            fresh.set_document(core.document().clone());
+            all_pages(&fresh)
+        };
+        for idx in [0, 1] {
+            mark_kept_in(&mut core, idx);
+            core.insert_text_native(idx, 5, 0, "가").unwrap();
+            assert!(
+                reused_in(&core, idx),
+                "section {idx} without endnotes reuses"
+            );
+            assert_eq!(all_pages(&core), fresh(&core));
+        }
+        // An endnote anywhere: the sections that defer or collect endnotes typeset again.
+        core.insert_endnote_native(0, 3, 0).unwrap();
+        // (A new endnote does not yet reach the last section's collected endnotes in RHWP
+        // itself, with or without reuse: start again from the document as it now is.)
+        let doc = core.document().clone();
+        core.set_document(doc);
+        for idx in [0, 1] {
+            if let Some(Some(kept)) = core.typeset_reuse.get_mut(idx) {
+                kept.raw.pre_emitted_host_heights.insert(MARK, 1.0);
+            }
+            core.insert_text_native(idx, 10, 0, "가").unwrap();
+            assert!(
+                !reused_in(&core, idx),
+                "section {idx} with an endnote typesets again"
+            );
+            assert_eq!(all_pages(&core), fresh(&core));
+        }
+    }
+
+    #[test]
+    fn a_split_and_a_merge_in_one_batch_typeset_the_section_again() {
+        let mut core = report(40);
+        assert!(core.page_count() >= 2, "several pages");
+        // Typing that keeps every line reuses the kept typesetting.
+        mark_kept(&mut core);
+        core.insert_text_native(0, 5, 0, "가").unwrap();
+        assert!(reused(&core), "typing in a one-line paragraph reuses it");
+        assert_eq!(pages(&core), fresh_pages(&core));
+        // The first paragraph holds the section and column definitions: reused as well.
+        mark_kept(&mut core);
+        core.insert_text_native(0, 0, 0, "가").unwrap();
+        assert!(reused(&core), "typing in the first paragraph reuses it");
+        assert_eq!(pages(&core), fresh_pages(&core));
+        // A changed column definition there is typeset again.
+        mark_kept(&mut core);
+        for control in &mut core.document.sections[0].paragraphs[0].controls {
+            if let crate::model::control::Control::ColumnDef(def) = control {
+                def.column_count = 2;
+                def.spacing = 1134;
+            }
+        }
+        core.stamp_section_changed(0);
+        core.recompose_paragraph(0, 0);
+        core.paginate();
+        assert!(
+            !reused(&core),
+            "a new column definition typesets the section again"
+        );
+        assert_eq!(pages(&core), fresh_pages(&core));
+        // A split at one place and a merge at another keep the paragraph count.
+        mark_kept(&mut core);
+        core.begin_batch_native().unwrap();
+        core.split_paragraph_native(0, 5, 4, None).unwrap();
+        core.merge_paragraph_native(0, 20).unwrap();
+        assert_eq!(core.typeset_marks[0].structural, 2);
+        core.end_batch_native().unwrap();
+        assert!(
+            !reused(&core),
+            "a structural change typesets the section again"
+        );
+        assert_eq!(pages(&core), fresh_pages(&core));
+        // Pages put in by another path (generation 0) are not reused either.
+        mark_kept(&mut core);
+        core.typeset_marks[0].generation = 0;
+        core.insert_text_native(0, 11, 0, "가").unwrap();
+        assert!(
+            !reused(&core),
+            "a page list from elsewhere is typeset again"
+        );
+        assert_eq!(pages(&core), fresh_pages(&core));
+    }
+}
