+/// 임의 쪽 바탕쪽(확장 플래그 0x04)이 적용될 구역 안 쪽 순서(1부터). HWPX `pageNumber`만
+/// 담고, HWP5 바탕쪽 목록 머리에는 그 자리가 없다.
+fn optional_master_page_number(
+    master_page: &crate::model::header_footer::MasterPage,
+) -> Option<usize> {
+    if master_page.ext_flags & 0x04 == 0 {
+        return None;
+    }
+    master_page
+        .hwpx_page_number
+        .filter(|&n| n > 0)
+        .map(usize::from)
