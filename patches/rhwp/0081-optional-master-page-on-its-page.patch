+#[cfg(test)]
+mod optional_master_page_tests {
+    use crate::document_core::DocumentCore;
+    use crate::model::header_footer::{HeaderFooterApply, MasterPage};
+
+    /// 임의 쪽 바탕쪽은 pageNumber 번째 쪽에만 쓰고, 마지막 쪽에는 쓰지 않는다(HwpCraft 패치 0081).
+    #[test]
+    fn an_optional_master_page_goes_on_its_numbered_page() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        core.insert_page_break_native(0, 0, 0).unwrap();
+        core.insert_page_break_native(0, 1, 0).unwrap();
+        let mut doc = core.document().clone();
+        doc.sections[0].section_def.master_pages = vec![
+            MasterPage {
+                apply_to: HeaderFooterApply::Both,
+                ..Default::default()
+            },
+            MasterPage {
+                apply_to: HeaderFooterApply::Both,
+                is_extension: true,
+                overlap: true,
+                replace_base: true,
+                ext_flags: 0x07,
+                hwpx_page_number: Some(2),
+                ..Default::default()
+            },
+        ];
+        core.set_document(doc);
+        let refs: Vec<Option<usize>> = core.pagination[0]
+            .pages
+            .iter()
+            .map(|p| p.active_master_page.as_ref().map(|m| m.master_page_index))
+            .collect();
+        assert_eq!(refs, [Some(0), Some(1), Some(0)]);
+    }
+}
