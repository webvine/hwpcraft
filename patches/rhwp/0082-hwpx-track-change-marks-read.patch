+/// [HwpCraft 0082] 변경 추적 표지를 글자 축을 소비하지 않는 sentinel 로 적는다.
+fn track_part(e: &quick_xml::events::BytesStart) -> String {
+    let name = e.name();
+    let local = local_name(name.as_ref());
+    let kind = if local.starts_with(b"insert") { 'I' } else { 'D' };
+    let edge = if local.ends_with(b"Begin") { 'B' } else { 'E' };
+    let attr = |key: &[u8]| {
+        e.attributes()
+            .flatten()
+            .find(|a| a.key.as_ref().as_bytes() == key)
+            .map(|a| attr_str(&a))
+            .unwrap_or_default()
+    };
+    let paraend = matches!(attr(b"paraend").as_str(), "1" | "true");
+    format!(
+        "{TRACK_PART_PREFIX}{kind}{edge}{},{},{}",
+        attr(b"TcId").trim().parse::<u32>().unwrap_or(0),
+        attr(b"Id").trim().parse::<u32>().unwrap_or(0),
+        u8::from(paraend)
+    )
+}
