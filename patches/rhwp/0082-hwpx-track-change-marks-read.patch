+/// [HwpCraft 0082] HWP5 DocInfo 변경 추적 레코드 태그 (HWPTAG_BEGIN + 80 / + 81).
+pub(crate) const HWPTAG_TRACK_CHANGE: u16 = tags::HWPTAG_BEGIN + 80;
+pub(crate) const HWPTAG_TRACK_CHANGE_AUTHOR: u16 = tags::HWPTAG_BEGIN + 81;
+
+/// [HwpCraft 0082] `<hh:trackChanges>`·`<hh:trackChangeAuthors>` (refList 자식, OWPML
+/// Header XML schema `TrackChange`·`TrackChangeAuthor`)를 원문 그대로 보존하고, 같은
+/// 내용을 HWP5 형식 레코드로 싣는다. 레코드 형식은 한글 2024 HWP 실측과 같다:
+/// TRACK_CHANGE 26바이트 = u32 종류(0x10 삽입 · 0x11 삭제 · 0x12 글자 모양 · 0x13 문단
+/// 모양) + u16 년·월·일·시·분 + u16 작성자 번호(1부터) + 0 열 바이트,
+/// TRACK_CHANGE_AUTHOR = u16 이름 길이 + 0 두 바이트 + UTF-16 이름 + u16 표시(mark) +
+/// u32 색 + 0 두 바이트. 본문 표지의 `TcId` 가 `trackChange@id` 이므로 레코드는 id-1
+/// 자리에 둔다(빈 번호는 종류 0 레코드로 채움). 실표본이 없어 명세로만 맞췄다.
+fn read_track_changes(xml: &str, doc_info: &mut DocInfo) {
+    let blocks: Vec<String> = ["hh:trackChanges", "hh:trackChangeAuthors"]
+        .iter()
+        .filter_map(|tag| extract_block(xml, tag))
+        .collect();
+    if blocks.is_empty() {
+        return;
+    }
+    let block = blocks.concat();
+    let mut changes: Vec<(u32, Vec<u8>)> = Vec::new();
+    let mut authors: Vec<(u32, String, bool, u32)> = Vec::new();
+    let mut reader = Reader::from_str(&block);
+    let mut buf = Vec::new();
+    loop {
+        match reader.read_event_into(&mut buf) {
+            Ok(Event::Start(ref e)) | Ok(Event::Empty(ref e)) => {
+                let attr = |name: &[u8]| {
+                    e.attributes()
+                        .flatten()
+                        .find(|a| a.key.as_ref().as_bytes() == name)
+                        .map(|a| attr_str(&a))
+                        .unwrap_or_default()
+                };
+                let number = |name: &[u8]| attr(name).trim().parse::<u32>().unwrap_or(0);
+                match local_name(e.name().as_ref()) {
+                    b"trackChange" => {
+                        let kind: u32 = match attr(b"type").as_str() {
+                            "Insert" => 0x10,
+                            "Delete" => 0x11,
+                            "CharShape" => 0x12,
+                            "ParaShape" => 0x13,
+                            _ => 0,
+                        };
+                        // xs:dateTime: 2026-11-01T00:05:00Z → 년·월·일·시·분.
+                        let date = attr(b"date");
+                        let fields: Vec<u16> = date
+                            .split(|c: char| !c.is_ascii_digit())
+                            .filter(|s| !s.is_empty())
+                            .take(5)
+                            .map(|s| s.parse().unwrap_or(0))
+                            .collect();
+                        let mut data = Vec::with_capacity(26);
+                        data.extend_from_slice(&kind.to_le_bytes());
+                        for i in 0..5 {
+                            data.extend_from_slice(&fields.get(i).copied().unwrap_or(0).to_le_bytes());
+                        }
+                        // 작성자 번호는 아래에서 순번으로 바꾼다 — 우선 authorID 를 둔다.
+                        data.extend_from_slice(&(number(b"authorID") as u16).to_le_bytes());
+                        data.extend_from_slice(&[0u8; 10]);
+                        changes.push((number(b"id"), data));
+                    }
+                    b"trackChangeAuthor" => {
+                        let mark = matches!(attr(b"mark").as_str(), "1" | "true");
+                        let color = u32::from_str_radix(attr(b"color").trim_start_matches('#'), 16)
+                            .map(|rgb| {
+                                // #RRGGBB → HWP COLORREF 0x00BBGGRR
+                                ((rgb & 0xFF) << 16) | (rgb & 0xFF00) | ((rgb >> 16) & 0xFF)
+                            })
+                            .unwrap_or(0);
+                        authors.push((number(b"id"), attr(b"name"), mark, color));
+                    }
+                    _ => {}
+                }
+            }
+            Ok(Event::Eof) | Err(_) => break,
+            _ => {}
+        }
+        buf.clear();
+    }
+    authors.sort_by_key(|a| a.0);
+    changes.sort_by_key(|c| c.0);
+    for (_, name, mark, color) in &authors {
+        let units: Vec<u16> = name.encode_utf16().collect();
+        let mut data = Vec::with_capacity(12 + units.len() * 2);
+        data.extend_from_slice(&(units.len() as u16).to_le_bytes());
+        data.extend_from_slice(&[0, 0]);
+        for unit in units {
+            data.extend_from_slice(&unit.to_le_bytes());
+        }
+        data.extend_from_slice(&u16::from(*mark).to_le_bytes());
+        data.extend_from_slice(&color.to_le_bytes());
+        data.extend_from_slice(&[0, 0]);
+        doc_info.extra_records.push(RawRecord {
+            tag_id: HWPTAG_TRACK_CHANGE_AUTHOR,
+            level: 1,
+            data,
+        });
+    }
+    let mut next_id = changes.first().map_or(1, |c| c.0.min(1));
+    for (id, mut data) in changes {
+        // 빈 번호는 종류 0 레코드로 채워 `TcId - 1` 자리가 맞게 한다.
+        while next_id < id {
+            let mut filler = vec![0u8; 26];
+            filler[..4].copy_from_slice(&0u32.to_le_bytes());
+            doc_info.extra_records.push(RawRecord {
+                tag_id: HWPTAG_TRACK_CHANGE,
+                level: 1,
+                data: filler,
+            });
+            next_id += 1;
+        }
+        let author_id = u32::from(u16::from_le_bytes([data[14], data[15]]));
+        let author = authors
+            .iter()
+            .position(|a| a.0 == author_id)
+            .map_or(0, |i| i + 1) as u16;
+        data[14..16].copy_from_slice(&author.to_le_bytes());
+        doc_info.extra_records.push(RawRecord {
+            tag_id: HWPTAG_TRACK_CHANGE,
+            level: 1,
+            data,
+        });
+        next_id = id + 1;
+    }
+    doc_info.track_changes_xml = Some(block);
+}
