+/// [HwpCraft 0082] 변경 추적 표지 sentinel 접두어. 뒤에 `I|D`, `B|E`, `TcId,Id,paraend`.
+const TRACK_PART_PREFIX: &str = "\u{0007}T";
+
+/// [HwpCraft 0082] OWPML `TrackChangeTag` 요소(`hp:insertBegin` 등)인가.
+fn is_track_mark(local: &[u8]) -> bool {
+    matches!(
+        local,
+        b"insertBegin" | b"insertEnd" | b"deleteBegin" | b"deleteEnd"
+    )
+}
