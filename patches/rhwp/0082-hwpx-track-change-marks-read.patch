+/// `<tag ...>...</tag>` 또는 자기닫힘 `<tag .../>` 블록을 원문 그대로 꺼낸다.
+fn extract_block(xml: &str, tag: &str) -> Option<String> {
+    let open = format!("<{tag}");
+    let start = xml
+        .match_indices(&open)
+        .map(|(i, _)| i)
+        .find(|&i| matches!(xml.as_bytes().get(i + open.len()), Some(b' ' | b'>' | b'/')))?;
+    let tail = &xml[start..];
+    let first_close = tail.find('>')?;
+    if tail.as_bytes()[first_close - 1] == b'/' {
+        return Some(tail[..=first_close].to_string());
+    }
+    let close = format!("</{tag}>");
+    let end = tail.find(&close)? + close.len();
+    Some(tail[..end].to_string())
+}
