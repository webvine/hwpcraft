+/// [HwpCraft 0082] 한 문단의 변경 추적 표지(위치, sentinel)를 HWP5 와 같은 범위 태그로
+/// 바꾼다: 삽입 16 · 삭제 17, 데이터는 `TcId`(= `trackChange@id`, HWP5 의 1부터 번호).
+/// `paraend` 표지는 문단 나눔 자리다 — 여는 표지면 범위가 나눔에서 시작하고 닫는
+/// 표지면 나눔까지 덮는다(HWP5 실측: 문단 나눔 삽입은 `(글 끝, char_count)`). 문단 안에서
+/// 짝이 없는 여는 표지는 나눔까지, 닫는 표지는 문단 처음부터 덮는다(여러 문단 범위).
+fn hwpx_track_range_tags(
+    marks: &[(u32, String)],
+    char_count: u32,
+) -> Vec<crate::model::paragraph::RangeTag> {
+    let break_pos = char_count.saturating_sub(1);
+    let mut open: Vec<(char, u32, u32, u32)> = Vec::new();
+    let mut out = Vec::new();
+    let tag = |kind: char, tc: u32| {
+        (if kind == 'I' { 16u32 } else { 17u32 } << 24) | (tc & 0x00FF_FFFF)
+    };
+    for (pos, part) in marks {
+        let body = &part[TRACK_PART_PREFIX.len()..];
+        let mut chars = body.chars();
+        let (Some(kind), Some(edge)) = (chars.next(), chars.next()) else {
+            continue;
+        };
+        let nums: Vec<u32> = chars
+            .as_str()
+            .split(',')
+            .map(|s| s.parse().unwrap_or(0))
+            .collect();
+        let (tc, id, paraend) = (
+            nums.first().copied().unwrap_or(0),
+            nums.get(1).copied().unwrap_or(0),
+            nums.get(2).copied().unwrap_or(0) == 1,
+        );
+        if edge == 'B' {
+            open.push((kind, tc, id, if paraend { break_pos } else { *pos }));
+            continue;
+        }
+        let start = open
+            .iter()
+            .rposition(|o| o.0 == kind && (o.2 == id || o.1 == tc))
+            .map_or(0, |i| open.remove(i).3);
+        let end = if paraend { char_count } else { *pos };
+        out.push(crate::model::paragraph::RangeTag {
+            start,
+            end: end.max(start),
+            tag: tag(kind, tc),
+        });
+    }
+    for (kind, tc, _, start) in open {
+        out.push(crate::model::paragraph::RangeTag {
+            start,
+            end: char_count,
+            tag: tag(kind, tc),
+        });
+    }
+    out
+}
 
