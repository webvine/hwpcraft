+#[cfg(test)]
+mod hwpcraft_line_number_tests {
+    use crate::document_core::DocumentCore;
+
+    /// A blank document with `lines` one-line paragraphs and the given line numbering.
+    fn numbered(lines: usize, show: bool, restart: u32, count_by: u32) -> DocumentCore {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        for i in 0..lines {
+            if i > 0 {
+                core.split_paragraph_native(0, i - 1, 1, None).unwrap();
+            }
+            core.insert_text_native(0, i, 0, "가").unwrap();
+        }
+        let mut doc = core.document().clone();
+        let def = &mut doc.sections[0].section_def;
+        def.show_line_number = show;
+        def.line_number_shape = Some(vec![
+            ("restartType".into(), restart.to_string()),
+            ("countBy".into(), count_by.to_string()),
+            ("distance".into(), "1417".into()),
+            ("startNumber".into(), "1".into()),
+        ]);
+        core.set_document(doc);
+        core
+    }
+
+    /// The line numbers drawn on `page` (text runs outside any paragraph), top to bottom,
+    /// with their x.
+    fn drawn(core: &DocumentCore, page: u32) -> Vec<(u32, f64)> {
+        drawn_from(core, page, false)
+    }
+
+    fn drawn_from(core: &DocumentCore, page: u32, cached: bool) -> Vec<(u32, f64)> {
+        use crate::renderer::render_tree::{RenderNode, RenderNodeType};
+        fn walk(node: &RenderNode, out: &mut Vec<(u32, f64, f64)>) {
+            if let RenderNodeType::TextRun(run) = &node.node_type {
+                if run.para_index.is_none() {
+                    if let Ok(n) = run.text.parse() {
+                        out.push((n, node.bbox.y, node.bbox.x));
+                    }
+                }
+            }
+            for child in &node.children {
+                walk(child, out);
+            }
+        }
+        let tree = if cached {
+            core.build_page_tree_cached(page).unwrap()
+        } else {
+            core.build_page_render_tree(page).unwrap()
+        };
+        let mut out = Vec::new();
+        walk(&tree.root, &mut out);
+        out.sort_by(|a, b| a.1.total_cmp(&b.1));
+        out.into_iter().map(|(n, _, x)| (n, x)).collect()
+    }
+
+    fn numbers(core: &DocumentCore, page: u32) -> Vec<u32> {
+        drawn(core, page).into_iter().map(|(n, _)| n).collect()
+    }
+
+    #[test]
+    fn a_later_section_follows_a_line_added_before_it() {
+        // Two one-page sections numbered on: section 2 continues section 1.
+        let mut core = numbered(3, true, 3, 1);
+        let mut doc = core.document().clone();
+        let second = doc.sections[0].clone();
+        doc.sections.push(second);
+        core.set_document(doc);
+        assert_eq!(core.page_count(), 2);
+        let cached = |core: &DocumentCore| -> Vec<u32> {
+            drawn_from(core, 1, true)
+                .into_iter()
+                .map(|(n, _)| n)
+                .collect()
+        };
+        assert_eq!(cached(&core), vec![4, 5, 6]);
+        // A line added in section 1 renumbers section 2's kept page.
+        core.split_paragraph_native(0, 0, 1, None).unwrap();
+        assert_eq!(cached(&core), vec![5, 6, 7]);
+    }
+
+    #[test]
+    fn line_numbers_are_drawn_only_when_shown_and_follow_count_and_restart() {
+        // Off: the page is drawn exactly as without the setting.
+        let off = numbered(60, false, 0, 1);
+        let plain = numbered(60, false, 0, 1);
+        assert_eq!(
+            off.render_page_svg_native(0).unwrap(),
+            plain.render_page_svg_native(0).unwrap()
+        );
+        assert!(numbers(&off, 0).is_empty());
+        // On, every line, numbered on: page 2 continues page 1.
+        let on = numbered(60, true, 3, 1);
+        assert!(on.pagination[0].pages.len() >= 2, "two pages");
+        let first = numbers(&on, 0);
+        assert_eq!(first[0], 1);
+        assert_eq!(first, (1..=first.len() as u32).collect::<Vec<_>>());
+        let second = numbers(&on, 1);
+        assert_eq!(second[0], first.len() as u32 + 1);
+        // Restart per page (1): page 2 starts at 1 again.
+        let per_page = numbered(60, true, 1, 1);
+        assert_eq!(numbers(&per_page, 1)[0], 1);
+        // Every fifth line only.
+        let fifth = numbered(60, true, 3, 5);
+        let shown = numbers(&fifth, 0);
+        assert!(
+            !shown.is_empty() && shown.iter().all(|n| n % 5 == 0),
+            "{shown:?}"
+        );
+        // The numbers end 5 mm (`distance` 1417) left of the body.
+        let body_left = on.pagination[0].pages[0].layout.body_area.x;
+        let (_, x) = drawn(&on, 0)[0];
+        assert!(x < body_left - 15.0, "{x} vs {body_left}");
+    }
+}
