+/// [HwpCraft 0037] 줄 번호: 본문 단의 줄(표·글상자·묶음·각주·머리말/꼬리말 밖)마다
+/// `numbers` 의 (문단, 줄) 번호가 `count_by` 의 배수이면 그 줄이 놓인 단의 왼쪽에서
+/// `distance` 만큼 띄워 오른쪽 맞춤으로, 줄의 기준선에 맞춰 그린다. 글꼴은 첫 글자
+/// 모양(바탕글)이다. 한글 화면과 대조하지 못한 배치다.
+pub(crate) fn draw_line_numbers(
+    tree: &mut PageRenderTree,
+    layout: &PageLayoutInfo,
+    numbers: &std::collections::HashMap<(usize, usize), u32>,
+    count_by: u32,
+    distance: f64,
+    styles: &ResolvedStyleSet,
+) {
+    type Line = (Option<u16>, BoundingBox, f64, usize, usize);
+    fn walk(node: &RenderNode, column: Option<u16>, inside_body: bool, out: &mut Vec<Line>) {
+        match &node.node_type {
+            RenderNodeType::Table(_)
+            | RenderNodeType::TableCell(_)
+            | RenderNodeType::TextBox
+            | RenderNodeType::Group(_)
+            | RenderNodeType::FootnoteArea
+            | RenderNodeType::Header
+            | RenderNodeType::Footer
+            | RenderNodeType::MasterPage => return,
+            RenderNodeType::TextLine(line) => {
+                if inside_body {
+                    if let (Some(para), Some(index)) = (line.para_index, line.line_index) {
+                        out.push((column, node.bbox, line.baseline, para, index as usize));
+                    }
+                }
+                return;
+            }
+            _ => {}
+        }
+        let column = match node.node_type {
+            RenderNodeType::Column(c) => Some(c),
+            _ => column,
+        };
+        let inside = inside_body || matches!(node.node_type, RenderNodeType::Body { .. });
+        for child in &node.children {
+            walk(child, column, inside, out);
+        }
+    }
+    let mut lines = Vec::new();
+    walk(&tree.root, None, false, &mut lines);
+    let count_by = count_by.max(1);
+    let base = styles.char_styles.first();
+    let font_size = base
+        .map(|style| style.font_size)
+        .filter(|size| *size > 0.0)
+        .unwrap_or(10.0 * layout.dpi / 72.0);
+    let style = TextStyle {
+        font_family: base
+            .and_then(|style| style.font_families.first())
+            .filter(|family| !family.is_empty())
+            .cloned()
+            .unwrap_or_else(|| "바탕".to_string()),
+        font_size,
+        color: base.map(|style| style.text_color).unwrap_or(0x000000),
+        ..Default::default()
+    };
+    let mut drawn = std::collections::HashSet::new();
+    for (column, bbox, baseline, para, index) in lines {
+        let Some(&number) = numbers.get(&(para, index)) else {
+            continue;
+        };
+        if number % count_by != 0 || !drawn.insert((para, index)) {
+            continue;
+        }
+        let text = number.to_string();
+        let width = estimate_text_width(&text, &style);
+        let left = column
+            .and_then(|c| layout.column_areas.get(c as usize))
+            .map_or(layout.body_area.x, |area| area.x);
+        let x = left - distance - width;
+        let y = bbox.y + baseline;
+        let line_id = tree.next_id();
+        let mut line_node = RenderNode::new(
+            line_id,
+            RenderNodeType::TextLine(TextLineNode::new(font_size * 1.2, font_size)),
+            BoundingBox::new(x, y - font_size, width, font_size * 1.2),
+        );
+        let run_id = tree.next_id();
+        line_node.children.push(RenderNode::new(
+            run_id,
+            RenderNodeType::TextRun(TextRunNode {
+                text,
+                style: style.clone(),
+                char_shape_id: None,
+                para_shape_id: None,
+                section_index: None,
+                para_index: None,
+                char_start: None,
+                cell_context: None,
+                is_para_end: true,
+                is_line_break_end: false,
+                rotation: 0.0,
+                is_vertical: false,
+                char_overlap: None,
+                border_fill_id: 0,
+                baseline: font_size,
+                field_marker: FieldMarkerType::None,
+                layout_positions: None,
+                display_text: None,
+            }),
+            BoundingBox::new(x, y - font_size, width, font_size),
+        ));
+        tree.root.children.push(line_node);
+    }
+}
