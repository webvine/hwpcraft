+    /// [HwpCraft 0037] 한 쪽의 본문 줄 (문단, 줄) 순서. 쪽 항목 순서대로, 빈 줄 감추기로
+    /// 감춘 문단과 미주 문단은 뺀다. 줄 수는 그 문단의 조판 줄 수다.
+    fn page_body_lines(&self, sec_idx: usize, page: &PageContent) -> Vec<(usize, usize)> {
+        use crate::renderer::pagination::PageItem;
+        let paragraph_count = self
+            .document
+            .sections
+            .get(sec_idx)
+            .map_or(0, |s| s.paragraphs.len());
+        let hidden = self.pagination.get(sec_idx).map(|p| &p.hidden_empty_paras);
+        let lines_of = |pi: usize| {
+            self.composed
+                .get(sec_idx)
+                .and_then(|c| c.get(pi))
+                .map(|c| c.lines.len())
+                .filter(|n| *n > 0)
+                .unwrap_or(1)
+        };
+        let mut out = Vec::new();
+        for column in &page.column_contents {
+            for item in &column.items {
+                let (pi, range) = match item {
+                    PageItem::FullParagraph { para_index } => {
+                        (*para_index, 0..lines_of(*para_index))
+                    }
+                    PageItem::PartialParagraph {
+                        para_index,
+                        start_line,
+                        end_line,
+                    } => (*para_index, *start_line..*end_line),
+                    _ => continue,
+                };
+                if pi >= paragraph_count || hidden.is_some_and(|h| h.contains(&pi)) {
+                    continue;
+                }
+                out.extend(range.map(|li| (pi, li)));
+            }
+        }
+        out
+    }
+
+    /// [HwpCraft 0037] 이 쪽의 줄 번호: (문단, 줄) → 번호, 번호 간격, 본문과의 거리(px).
+    /// restartType 은 한글 자동화 표(LineNumberRestart)의 뜻으로 읽는다: 1 쪽마다,
+    /// 2 구역마다, 그 밖(0 기본, 3 이어서)은 앞 구역의 번호에 이어 매긴다.
+    fn page_line_numbers(
+        &self,
+        sec_idx: usize,
+        page: &PageContent,
+    ) -> Option<(std::collections::HashMap<(usize, usize), u32>, u32, f64)> {
+        let setting = |def: &crate::model::document::SectionDef, key: &str| -> u32 {
+            def.line_number_shape
+                .as_ref()
+                .and_then(|attrs| attrs.iter().find(|(k, _)| k == key))
+                .and_then(|(_, v)| v.parse().ok())
+                .unwrap_or(0)
+        };
+        let def = &self.document.sections.get(sec_idx)?.section_def;
+        if !def.show_line_number {
+            return None;
+        }
+        // The number of this page's first line: walk the numbered sections and pages before.
+        let mut next: Option<u32> = None;
+        let mut first = None;
+        'sections: for (si, section) in self.document.sections.iter().enumerate().take(sec_idx + 1)
+        {
+            let sd = &section.section_def;
+            if !sd.show_line_number {
+                continue;
+            }
+            let start = setting(sd, "startNumber").max(1);
+            let restart = setting(sd, "restartType");
+            if restart == 2 || next.is_none() {
+                next = Some(start);
+            }
+            for p in self
+                .pagination
+                .get(si)
+                .map(|r| r.pages.as_slice())
+                .unwrap_or(&[])
+            {
+                if restart == 1 {
+                    next = Some(start);
+                }
+                if si == sec_idx && p.page_index == page.page_index {
+                    first = next;
+                    break 'sections;
+                }
+                let lines = self.page_body_lines(si, p).len() as u32;
+                next = next.map(|n| n.saturating_add(lines));
+            }
+        }
+        let mut number = first.or(next)?;
+        let mut numbers = std::collections::HashMap::new();
+        for key in self.page_body_lines(sec_idx, page) {
+            numbers.insert(key, number);
+            number = number.saturating_add(1);
+        }
+        let count_by = setting(def, "countBy").max(1);
+        let distance = crate::renderer::hwpunit_to_px(setting(def, "distance") as i32, self.dpi);
+        Some((numbers, count_by, distance))
+    }
