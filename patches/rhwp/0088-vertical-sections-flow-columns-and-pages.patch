+    pub fn is_vertical(&self) -> bool {
+        self.text_direction != 0
+    }
+
+    /// [HwpCraft 0088] 본문 흐름의 용지. 가로 구역은 용지 그대로이고, 세로 구역은 줄(열)이
+    /// 본문 높이만큼 길고 쪽이 본문 폭만큼 열을 담도록 돌린 용지다: 논리 폭 = 실제 높이,
+    /// 논리 왼쪽·오른쪽 여백 = 실제 위(머리말 포함)·아래(꼬리말 포함), 논리 위·아래 = 실제
+    /// 오른쪽·왼쪽(제본 여백 포함). 머리말·꼬리말·바탕쪽·쪽 테두리는 실제 용지에 그린다.
+    pub fn flow_page_def(&self) -> PageDef {
+        let pd = &self.page_def;
+        if !self.is_vertical() {
+            return pd.clone();
+        }
+        let (width, height) = if pd.landscape {
+            (pd.height, pd.width)
+        } else {
+            (pd.width, pd.height)
+        };
+        PageDef {
+            width: height,
+            height: width,
+            margin_left: pd.margin_top.saturating_add(pd.margin_header),
+            margin_right: pd.margin_bottom.saturating_add(pd.margin_footer),
+            margin_top: pd.margin_right,
+            margin_bottom: pd.margin_left.saturating_add(pd.margin_gutter),
+            margin_header: 0,
+            margin_footer: 0,
+            margin_gutter: 0,
+            landscape: false,
+            binding: Default::default(),
+            ..pd.clone()
+        }
+    }
