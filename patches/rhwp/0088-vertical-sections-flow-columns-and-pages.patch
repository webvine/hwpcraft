+        let core = vertical(&"가".repeat(3000), 1);
+        let sd = &core.document().sections[0].section_def;
+        let pd = &sd.page_def;
+        let body_height =
+            pd.height - pd.margin_top - pd.margin_header - pd.margin_bottom - pd.margin_footer;
+        let body_width = pd.width - pd.margin_left - pd.margin_right - pd.margin_gutter;
