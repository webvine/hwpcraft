+    let font_size = paragraph_font_size_px(para, styles).unwrap_or(12.0);
+    // 한글 2024 실측: 세로 열 간격은 가로 줄 간격의 0.85 배(A4 기본 쪽, 10pt·160%: 가로 41줄,
