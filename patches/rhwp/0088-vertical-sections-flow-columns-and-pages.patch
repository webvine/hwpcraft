+/// 가로 줄과 같은 글꼴·문단 줄 간격 규칙을 따른다.
+pub(crate) fn reflow_line_segs_vertical(
+    para: &mut Paragraph,
+    paragraph_box: &ParagraphBox,
+    styles: &ResolvedStyleSet,
+    dpi: f64,
