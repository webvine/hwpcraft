+        let per_column = (f64::from(body_height) / 1130.0) as usize;
+        assert_eq!(per_column, 58);
+        let first = lines[1].text_start - lines[0].text_start.max(para.char_offsets[0]);
+        assert_eq!(first as usize, per_column, "{lines:?}");
+        // 한글 2024 실측: 같은 쪽에 31열(2쪽은 1,798번째 글자부터).
+        let pitch = (lines[0].line_height + lines[0].line_spacing) as u32;
+        assert_eq!(body_width / pitch, 31, "pitch {pitch}");
+        assert_eq!(core.page_count(), 2);
+        let first_page_lines: usize = core.pagination[0].pages[0]
+            .column_contents
+            .iter()
+            .flat_map(|c| &c.items)
+            .map(|item| match item {
