+/// [HwpCraft 0104] The raw text indexes (into `para.text`) of the inline objects
+/// (treated as characters) of `para`: an object sits before the character at its index.
+pub(crate) fn inline_object_text_positions(para: &Paragraph) -> Vec<usize> {
+    let positions = para.control_text_positions();
+    para.controls
+        .iter()
+        .enumerate()
+        .filter(|(_, ctrl)| is_treat_as_char_object_control(ctrl))
+        .filter_map(|(ci, _)| positions.get(ci).copied())
+        .collect()
+}
