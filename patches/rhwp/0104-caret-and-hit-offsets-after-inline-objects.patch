+    #[test]
+    fn hit_test_finds_the_caret_offsets_on_the_next_page_of_an_inline_shape_paragraph() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        core.insert_text_native(0, 0, 0, &SENTENCE.repeat(82))
+            .unwrap();
+        insert_rectangle(&mut core, 10);
+        let len = core.document().sections[0].paragraphs[0]
+            .text
+            .chars()
+            .count();
+        let last: serde_json::Value =
+            serde_json::from_str(&core.get_cursor_rect_native(0, 0, len).unwrap()).unwrap();
+        assert!(
+            number(&last, "pageIndex") >= 1.0,
+            "the paragraph reaches page 2"
+        );
+        // On page 2 the caret after each row's first character stands where that
+        // character ends (one inline object before it: caret offset = text index + 1).
+        fn first_chars(node: &RenderNode, row: Option<u32>, out: &mut Vec<(u32, f64)>) {
+            let row = match &node.node_type {
+                RenderNodeType::TextLine(line) if line.para_index == Some(0) => line.line_index,
+                _ => row,
+            };
+            if let (RenderNodeType::TextRun(run), Some(row)) = (&node.node_type, row) {
+                if run.para_index == Some(0) && !out.iter().any(|(r, _)| *r == row) {
+                    let positions = run.replay_positions_for(&run.text).into_owned();
+                    out.push((row, node.bbox.x + positions[1]));
+                }
+            }
+            for child in &node.children {
+                first_chars(child, row, out);
+            }
+        }
+        let tree = core.build_page_tree(1).unwrap();
+        let mut rows = Vec::new();
+        first_chars(&tree.root, None, &mut rows);
+        assert!(rows.len() > 1);
+        let para = &core.document().sections[0].paragraphs[0];
+        let page_two = super::row_text_start(para, rows[0].0 as usize).unwrap();
+        for (row, x) in rows {
+            let start = super::row_text_start(para, row as usize).unwrap();
+            let caret: serde_json::Value =
+                serde_json::from_str(&core.get_cursor_rect_native(0, 0, start + 2).unwrap())
+                    .unwrap();
+            assert_eq!(number(&caret, "pageIndex"), 1.0);
+            assert!(
+                (number(&caret, "x") - x).abs() < 0.5,
+                "row {row}: {caret} vs {x}"
+            );
+        }
+        assert_round_trip(&core, 1, Some(page_two..page_two + 120));
+    }
