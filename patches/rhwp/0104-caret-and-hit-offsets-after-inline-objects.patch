+/// [HwpCraft 0104] The raw text index of the first character of `para`'s stored row
+/// `line_index`.
+pub(crate) fn row_text_start(para: &Paragraph, line_index: usize) -> Option<usize> {
+    let row_start = para.line_segs.get(line_index)?.text_start;
+    Some(
+        para.char_offsets
+            .iter()
+            .position(|&start| start >= row_start)
+            .unwrap_or(para.char_offsets.len()),
+    )
+}
