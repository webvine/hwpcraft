+#[cfg(test)]
+mod hwpcraft_inline_object_hit_tests {
+    use crate::document_core::helpers::is_treat_as_char_object_control;
+    use crate::document_core::DocumentCore;
+    use crate::renderer::render_tree::{RenderNode, RenderNodeType};
+
+    const SENTENCE: &str = "글자처럼 취급한 도형이 첫 줄을 높게 만든다. ";
+
+    fn core_with_text() -> DocumentCore {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        core.insert_text_native(0, 0, 0, &SENTENCE.repeat(12))
+            .unwrap();
+        core
+    }
+
+    fn insert_rectangle(core: &mut DocumentCore, offset: usize) {
+        core.create_shape_control_native(
+            0,
+            0,
+            offset,
+            11339,
+            7654,
+            0,
+            0,
+            true,
+            "TopAndBottom",
+            "rectangle",
+            false,
+            false,
+            &[],
+        )
+        .unwrap();
+    }
+
+    fn number(json: &serde_json::Value, key: &str) -> f64 {
+        json[key]
+            .as_f64()
+            .unwrap_or_else(|| panic!("missing {key} in {json}"))
+    }
+
+    /// Clicking just right of every caret position of the paragraph in `offsets` (all of
+    /// them when `None`) finds that position again, on the rows after the inline objects
+    /// as well as on the first.
+    fn assert_round_trip(
+        core: &DocumentCore,
+        inline_objects: usize,
+        offsets: Option<std::ops::Range<usize>>,
+    ) {
+        let para = &core.document().sections[0].paragraphs[0];
+        let found = para
+            .controls
+            .iter()
+            .filter(|ctrl| is_treat_as_char_object_control(ctrl))
+            .count();
+        assert_eq!(found, inline_objects);
+        assert!(para.line_segs.len() > 3, "several rows");
+        let last = para.text.chars().count() + inline_objects;
+        let mut wrong = Vec::new();
+        for offset in offsets.unwrap_or(0..last) {
+            let rect: serde_json::Value =
+                serde_json::from_str(&core.get_cursor_rect_native(0, 0, offset).unwrap()).unwrap();
+            let hit: serde_json::Value = serde_json::from_str(
+                &core
+                    .hit_test_native(
+                        number(&rect, "pageIndex") as u32,
+                        number(&rect, "x") + 1.0,
+                        number(&rect, "y") + number(&rect, "height") / 2.0,
+                    )
+                    .unwrap(),
+            )
+            .unwrap();
+            if hit["charOffset"].as_u64() != Some(offset as u64) {
+                wrong.push((offset, hit["charOffset"].clone()));
+            }
+        }
+        assert!(wrong.is_empty(), "caret offset -> hit: {wrong:?}");
+    }
+
+    #[test]
+    fn hit_test_finds_the_caret_offsets_after_an_inline_shape() {
+        let mut core = core_with_text();
+        insert_rectangle(&mut core, 10);
+        assert_round_trip(&core, 1, None);
+    }
+
+    #[test]
+    fn hit_test_finds_the_caret_offsets_after_two_inline_shapes() {
+        let mut core = core_with_text();
+        insert_rectangle(&mut core, 10);
+        insert_rectangle(&mut core, 80);
+        let para = &core.document().sections[0].paragraphs[0];
+        let second = para.control_text_positions()[3];
+        assert!(
+            para.char_offsets[second] > para.line_segs[1].text_start,
+            "on a later row"
+        );
+        assert_round_trip(&core, 2, None);
+    }
+
+    /// Caret -> hit round trips over `offsets` of a body paragraph of a sample file.
+    fn sample_round_trip_misses(
+        file: &str,
+        section: usize,
+        para: usize,
+        offsets: std::ops::Range<usize>,
+    ) -> Vec<(usize, serde_json::Value)> {
+        let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join(file);
+        let core = DocumentCore::from_bytes(&std::fs::read(path).unwrap()).unwrap();
+        let mut wrong = Vec::new();
+        for offset in offsets {
+            let rect: serde_json::Value =
+                serde_json::from_str(&core.get_cursor_rect_native(section, para, offset).unwrap())
+                    .unwrap();
+            let hit: serde_json::Value = serde_json::from_str(
+                &core
+                    .hit_test_native(
+                        number(&rect, "pageIndex") as u32,
+                        number(&rect, "x") + 1.0,
+                        number(&rect, "y") + number(&rect, "height") / 2.0,
+                    )
+                    .unwrap(),
+            )
+            .unwrap();
+            if hit["sectionIndex"].as_u64() != Some(section as u64)
+                || hit["paragraphIndex"].as_u64() != Some(para as u64)
+                || hit["charOffset"].as_u64() != Some(offset as u64)
+            {
+                wrong.push((offset, hit));
+            }
+        }
+        wrong
+    }
+
+    /// A row holding only an inline table and a line break: the text runs of the next row
+    /// start a line break and an object short of their caret offsets.
+    #[test]
+    fn hit_test_finds_the_caret_offsets_after_a_row_of_an_inline_table() {
+        let wrong = sample_round_trip_misses("samples/issue6044/156513948.hwpx", 3, 73, 2..57);
+        assert!(wrong.is_empty(), "caret offset -> hit: {wrong:?}");
+    }
+
+    /// A paragraph with an inline rectangle that goes on to the next page: the rows there
+    /// already count the rectangle (a run boundary) and keep their offsets.
+    #[test]
+    fn hit_test_keeps_the_caret_offsets_of_rows_that_count_the_inline_object() {
+        let wrong = sample_round_trip_misses("samples/HWP5-nopassword-123456.hwp", 0, 258, 39..151);
+        assert!(wrong.is_empty(), "caret offset -> hit: {wrong:?}");
+    }
