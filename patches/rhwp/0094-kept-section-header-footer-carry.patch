+#[cfg(test)]
+mod hwpcraft_kept_section_carry_tests {
+    use super::DocumentCore;
+
+    /// Page SVGs without the generated clip ids, which count every node built.
+    fn pages(core: &DocumentCore) -> Vec<String> {
+        (0..core.page_count())
+            .map(|page| {
+                let svg = core.render_page_svg_native(page).expect("svg");
+                let mut out = String::with_capacity(svg.len());
+                let mut rest = svg.as_str();
+                while let Some(at) = rest.find("clip-") {
+                    out.push_str(&rest[..at + 5]);
+                    rest = rest[at + 5..].trim_start_matches(|c: char| c.is_ascii_digit());
+                }
+                out.push_str(rest);
+                out
+            })
+            .collect()
+    }
+
+    /// An edit in a later section keeps the headers it inherits: the earlier section,
+    /// not paginated again, used to hand on the header carry read off its own pages,
+    /// which miss the even header of a section ending on an odd page.
+    #[test]
+    fn an_edit_in_a_later_section_keeps_its_inherited_headers() {
+        let mut core = DocumentCore::from_bytes(include_bytes!(
+            "../../../samples/issue5802/hf_cross_section_inherit.hwp"
+        ))
+        .expect("open");
+        let last = core.document().sections.len() - 1;
+        let para = core.document().sections[last]
+            .paragraphs
+            .iter()
+            .position(|p| p.text.chars().count() >= 2)
+            .expect("text");
+        core.insert_text_native(last, para, 1, "가").expect("insert");
+        let mut fresh = DocumentCore::new_empty();
+        fresh.set_document(core.document().clone());
+        assert_eq!(pages(&core), pages(&fresh));
+    }
+
+    /// An undo that rebuilds only the edited section shows the other pages as they were.
+    #[test]
+    fn undo_rebuilding_one_section_restores_every_page() {
+        let mut core = DocumentCore::from_bytes(include_bytes!(
+            "../../../samples/hwpx/exam_social.hwpx"
+        ))
+        .expect("open");
+        let opened = pages(&core);
+        let id = core.save_snapshot_native();
+        let last = core.document().sections.len() - 1;
+        let para = core.document().sections[last]
+            .paragraphs
+            .iter()
+            .position(|p| p.text.chars().count() >= 2)
+            .expect("text");
+        core.insert_text_native(last, para, 1, "가").expect("insert");
+        core.restore_snapshot_native(id).expect("restore");
+        let undone = pages(&core);
+        assert_eq!(undone.len(), opened.len());
+        for (page, (a, b)) in undone.iter().zip(&opened).enumerate() {
+            assert!(a == b, "page {} differs after undo", page + 1);
+        }
+    }
+}
