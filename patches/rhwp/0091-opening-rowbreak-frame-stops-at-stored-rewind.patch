@@ -8366,4 +8366,38 @@ mod tests {
             "구역 12 p17 이 빈 쪽을 만든다 (한글 PDF에는 없음)"
         );
     }
+
+    /// 편람 구역 10 질문 5(pi=12) 표의 첫 조각은 답변 문단의 저장 되감김(2줄 뒤)에서
+    /// 끝난다. 한글 2024 PDF 283쪽은 그 2줄만 담고 상자를 본문 안(886.8px)에서 닫는다.
+    /// 파생 문단 꼬리가 3줄을 실으면 조각이 본문 하단을 넘는다.
+    #[test]
+    fn handbook_q5_opening_fragment_stops_at_stored_rewind() {
+        let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+            .join("samples/2025 행정업무운영 편람(최종).hwp");
+        let Ok(bytes) = std::fs::read(&path) else {
+            eprintln!("skip: {} 없음", path.display());
+            return;
+        };
+        let core = crate::document_core::DocumentCore::from_bytes(&bytes).expect("parse handbook");
+        let opening_cut = core.pagination[10]
+            .pages
+            .iter()
+            .flat_map(|page| &page.column_contents)
+            .flat_map(|column| &column.items)
+            .find_map(|item| match item {
+                PageItem::PartialTable {
+                    para_index: 12,
+                    is_continuation: false,
+                    end_cut,
+                    ..
+                } => Some(end_cut.clone()),
+                _ => None,
+            })
+            .expect("질문 5 표의 첫 조각");
+        assert_eq!(
+            opening_cut,
+            vec![1, 1, 2],
+            "답변 셀은 저장 되감김 앞 2줄에서 끝나야 한다"
+        );
+    }
 }
