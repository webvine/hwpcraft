+/// [HwpCraft 0050] CTRL_HEADER attr **bit 30 = 개체 보호**를 IR(`common.locked`)에 맞춘다.
+fn apply_lock_attr_bit(ctrl_data: &[u8], locked: bool) -> Vec<u8> {
+    const LOCK_ATTR_BIT: u32 = 1 << 30;
+    let mut out = ctrl_data.to_vec();
+    if out.len() >= 4 {
+        let mut attr = u32::from_le_bytes([out[0], out[1], out[2], out[3]]);
+        if locked {
+            attr |= LOCK_ATTR_BIT;
+        } else {
+            attr &= !LOCK_ATTR_BIT;
+        }
+        out[0..4].copy_from_slice(&attr.to_le_bytes());
+    }
+    out
+}
