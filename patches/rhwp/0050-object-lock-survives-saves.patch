+    /// [HwpCraft 0050] 편집으로 건 개체 보호가 HWP·HWPX 저장 뒤에도 남는다.
+    #[test]
+    fn a_lock_set_by_editing_survives_hwp_and_hwpx_saves() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().expect("blank document");
+        let created: serde_json::Value =
+            serde_json::from_str(&core.create_table_native(0, 0, 0, 1, 2).expect("table"))
+                .expect("table result");
+        let para = created["paraIdx"].as_u64().expect("paraIdx") as usize;
+        let ctrl = created["controlIdx"].as_u64().expect("controlIdx") as usize;
+        const PNG: &[u8] = &[
+            0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D, 0x49, 0x48,
+            0x44, 0x52, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01, 0x08, 0x06, 0x00, 0x00,
+            0x00, 0x1F, 0x15, 0xC4, 0x89, 0x00, 0x00, 0x00, 0x0D, 0x49, 0x44, 0x41, 0x54, 0x78,
+            0x9C, 0x63, 0xF8, 0xCF, 0xC0, 0xF0, 0x1F, 0x00, 0x05, 0x00, 0x01, 0xFF, 0x89, 0x99,
+            0x3D, 0x1D, 0x00, 0x00, 0x00, 0x00, 0x49, 0x45, 0x4E, 0x44, 0xAE, 0x42, 0x60, 0x82,
+        ];
+        let pic: serde_json::Value = serde_json::from_str(
+            &core
+                .insert_picture_native(0, 0, 0, &[], PNG, 2000, 2000, 1, 1, "png", "", None, None)
+                .expect("picture"),
+        )
+        .expect("picture result");
+        let pic_para = pic["paraIdx"].as_u64().expect("paraIdx") as usize;
+        let pic_ctrl = pic["controlIdx"].as_u64().expect("controlIdx") as usize;
+        let table_ctrl = if pic_para == para && pic_ctrl <= ctrl {
+            ctrl + 1
+        } else {
+            ctrl
+        };
+        core.set_control_lock(Some(para), Some(table_ctrl), true)
+            .expect("lock table");
+        core.set_control_lock(Some(pic_para), Some(pic_ctrl), true)
+            .expect("lock picture");
+        let locks = |core: &DocumentCore| {
+            let mut out = Vec::new();
+            for p in &core.document.sections[0].paragraphs {
+                for c in &p.controls {
+                    match c {
+                        Control::Table(t) => out.push(("table", t.common.locked)),
+                        Control::Picture(p) => out.push(("picture", p.common.locked)),
+                        _ => {}
+                    }
+                }
+            }
+            out
+        };
+        let mut want = locks(&core);
+        want.sort();
+        assert_eq!(want, vec![("picture", true), ("table", true)]);
+        for (name, bytes) in [
+            ("hwp", core.export_hwp_native().expect("hwp")),
+            ("hwpx", core.export_hwpx_native().expect("hwpx")),
+        ] {
+            let back = DocumentCore::from_bytes(&bytes).expect("reopen");
+            let mut got = locks(&back);
+            got.sort();
+            assert_eq!(got, want, "{name}");
+        }
+    }
