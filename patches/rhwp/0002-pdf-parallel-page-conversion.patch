+/// 쪽들을 여러 스레드에서 변환하고 결과를 쪽 순서대로 돌려준다.
+///
+/// 쪽 변환은 서로 독립이고 대체 글꼴 색인은 처리 순서와 무관하게 usvg 기본 순서와 같은
+/// 답을 내므로, 쪽별 chunk 와 최종 PDF 바이트는 순차 변환과 같다. 경고는 쪽 순서대로
+/// 출력하고, 오류는 순차 변환이 먼저 만났을 가장 앞 쪽의 것을 돌려준다.
+#[cfg(not(target_arch = "wasm32"))]
+fn convert_pages_parallel(
+    svg_pages: &[String],
+    export_options: &PdfExportOptions,
+    options: &usvg::Options<'_>,
+    threads: usize,
+) -> Result<Vec<PdfPageData>, String> {
+    use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+    type Slot = std::sync::Mutex<Option<(Result<Option<PdfPageData>, String>, Vec<String>)>>;
+    let next = AtomicUsize::new(0);
+    let failed = AtomicBool::new(false);
+    let slots: Vec<Slot> = (0..svg_pages.len())
+        .map(|_| std::sync::Mutex::new(None))
+        .collect();
+    std::thread::scope(|scope| {
+        for _ in 0..threads {
+            scope.spawn(|| {
+                let mut to_chunk = svg2pdf_to_chunk;
+                loop {
+                    // 쪽 번호는 오름차순으로 나눠 가지므로, 실패가 알려진 뒤에 새로 집는
+                    // 쪽은 모두 그 실패보다 뒤다. 앞쪽은 이미 누군가 처리하고 있다.
+                    if failed.load(Ordering::Acquire) {
+                        break;
+                    }
+                    let page_index = next.fetch_add(1, Ordering::AcqRel);
+                    let Some(svg) = svg_pages.get(page_index) else {
+                        break;
+                    };
+                    let mut warnings = Vec::new();
+                    let result = convert_svg_page(
+                        page_index,
+                        svg,
+                        export_options,
+                        options,
+                        &mut to_chunk,
+                        &mut warnings,
+                    );
+                    if result.is_err() {
+                        failed.store(true, Ordering::Release);
+                    }
+                    if let Ok(mut slot) = slots[page_index].lock() {
+                        *slot = Some((result, warnings));
+                    }
+                }
+            });
+        }
+    });
+    let mut page_datas = Vec::with_capacity(svg_pages.len());
+    for slot in slots {
+        let Some((result, warnings)) = slot.into_inner().ok().flatten() else {
+            // 앞쪽 실패 뒤에 건너뛴 쪽: 그 실패는 이미 아래에서 반환됐다.
+            break;
+        };
+        for warning in warnings {
+            eprintln!("{warning}");
+        }
+        if let Some(page) = result? {
+            page_datas.push(page);
+        }
+    }
+    Ok(page_datas)
 }
 
