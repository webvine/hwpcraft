+/// 쪽 변환 스레드 수: `RHWP_PDF_THREADS`(1 이상), 없으면 min(코어 수, 8), 쪽 수 이하.
+///
+/// 쪽마다 usvg 트리와 svg2pdf 작업 버퍼가 동시에 살아 있으므로(381쪽 문서에서 쪽당
+/// 약 94MB) 기본 상한을 8로 둔다. 1이면 기존 순차 경로와 같다.
+#[cfg(not(target_arch = "wasm32"))]
+fn pdf_page_threads(pages: usize) -> usize {
+    let requested = std::env::var("RHWP_PDF_THREADS")
+        .ok()
+        .and_then(|value| value.trim().parse::<usize>().ok())
+        .filter(|threads| *threads >= 1);
+    let default = || {
+        std::thread::available_parallelism()
+            .map(std::num::NonZeroUsize::get)
+            .unwrap_or(1)
+            .min(8)
+    };
+    requested.unwrap_or_else(default).min(pages.max(1))
+}
