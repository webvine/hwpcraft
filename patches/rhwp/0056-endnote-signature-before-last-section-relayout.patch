+/// [HwpCraft 0056] 구역의 문서 끝 미주 서명: 미주가 놓인 자리(문단, 컨트롤, 표 셀 안이면 그
+/// 경로), 번호와 장식, 본문 문단(글자·글자 모양·문단 모양·컨트롤 수), 구역의 미주 모양.
+/// 미주가 문서 끝에 모이지 않거나 하나도 없으면 `None`. 둘째 값은 미주 본문에 개체(수식·그림·
+/// 표 등)가 있는가: 개체의 내용은 서명에 넣지 않으므로, 그런 구역이 바뀌면 늘 다시 조판한다.
+fn document_end_endnote_signature(
+    section: &crate::model::document::Section,
+) -> (Option<u64>, bool) {
+    use std::hash::{Hash, Hasher};
+    fn walk(
+        paragraphs: &[crate::model::paragraph::Paragraph],
+        path: &mut Vec<usize>,
+        hasher: &mut std::collections::hash_map::DefaultHasher,
+        any: &mut bool,
+        with_objects: &mut bool,
+    ) {
+        if path.len() > 256 {
+            return;
+        }
+        for (pi, para) in paragraphs.iter().enumerate() {
+            for (ci, ctrl) in para.controls.iter().enumerate() {
+                match ctrl {
+                    Control::Endnote(note) => {
+                        *any = true;
+                        (&*path, pi, ci).hash(hasher);
+                        (note.number, note.before_decoration_letter).hash(hasher);
+                        (note.after_decoration_letter, note.number_shape).hash(hasher);
+                        for p in &note.paragraphs {
+                            // 미주 번호(자동 번호)·필드·책갈피는 글자 축의 자리표일 뿐 개체가 아니다.
+                            *with_objects |= p.controls.iter().any(|c| {
+                                !matches!(
+                                    c,
+                                    Control::AutoNumber(_)
+                                        | Control::NewNumber(_)
+                                        | Control::Field(_)
+                                        | Control::Bookmark(_)
+                                )
+                            });
+                            p.text.hash(hasher);
+                            (p.para_shape_id, p.controls.len()).hash(hasher);
+                            for cs in &p.char_shapes {
+                                (cs.start_pos, cs.char_shape_id).hash(hasher);
+                            }
+                        }
+                    }
+                    Control::Table(table) => {
+                        for (cell_index, cell) in table.cells.iter().enumerate() {
+                            path.extend([pi, ci, cell_index]);
+                            walk(&cell.paragraphs, path, hasher, any, with_objects);
+                            path.truncate(path.len() - 3);
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+    }
+    if !matches!(
+        section.section_def.endnote_shape.placement,
+        crate::model::footnote::FootnotePlacement::EachColumn
+    ) {
+        return (None, false);
+    }
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    let (mut any, mut with_objects) = (false, false);
+    walk(
+        &section.paragraphs,
+        &mut Vec::new(),
+        &mut hasher,
+        &mut any,
+        &mut with_objects,
+    );
+    let signature = any.then(|| {
+        format!("{:?}", section.section_def.endnote_shape).hash(&mut hasher);
+        hasher.finish()
+    });
+    (signature, with_objects)
+}
