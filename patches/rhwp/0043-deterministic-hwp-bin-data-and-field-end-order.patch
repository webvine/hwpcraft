+    /// Each parse hashes the picture names with a new `HashMap` seed, so a list in map
+    /// order differs between parses; in id order it is the same every time.
+    #[test]
+    fn external_picture_links_are_listed_in_id_order() {
+        let path = concat!(env!("CARGO_MANIFEST_DIR"), "/samples/hwp3-sample10.hwp");
+        let Ok(data) = std::fs::read(path) else {
+            return;
+        };
+        let lists: Vec<Vec<(u16, Option<String>)>> = (0..8)
+            .map(|_| {
+                parse_hwp3(&data)
+                    .expect("hwp3-sample10 parses")
+                    .doc_info
+                    .bin_data_list
+                    .iter()
+                    .map(|b| (b.storage_id, b.rel_path.clone()))
+                    .collect()
+            })
+            .collect();
+        let links = lists[0].iter().filter(|(_, name)| name.is_some()).count();
+        assert!(links >= 2, "the sample links several pictures: {:?}", lists[0]);
+        for list in &lists {
+            assert_eq!(list, &lists[0]);
+            for (index, (id, _)) in list.iter().enumerate() {
+                assert_eq!(usize::from(*id), index + 1, "{list:?}");
+            }
+        }
+    }
