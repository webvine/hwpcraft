+#[cfg(test)]
+mod section_start_page_number_tests {
+    use crate::document_core::DocumentCore;
+
+    /// 구역 시작 쪽 번호는 그 구역 첫 쪽의 절대 번호다. 0인 구역은 앞 구역에서 잇는다.
+    #[test]
+    fn section_start_number_sets_the_first_page_and_later_sections_continue() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        let mut doc = core.document().clone();
+        let base = doc.sections[0].clone();
+        doc.sections = vec![base.clone(), base.clone(), base];
+        doc.sections[0].section_def.page_num = 65530;
+        doc.sections[2].section_def.page_num = 7;
+        core.set_document(doc);
+        let numbers: Vec<u32> = core
+            .pagination
+            .iter()
+            .flat_map(|r| r.pages.iter().map(|p| p.page_number))
+            .collect();
+        assert_eq!(numbers, [65530, 65531, 7]);
+    }
