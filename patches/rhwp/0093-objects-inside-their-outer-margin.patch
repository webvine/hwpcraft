+/// 왼쪽 정렬 **글 앞으로/글 뒤로** 표의 왼쪽 바깥여백 (HU).
+///
+/// 그림(#6596)과 같이 저장 오프셋은 바깥 여백 상자의 왼끝을 가리키고 표는 거기서
+/// `outMargin.left` 만큼 안쪽에 그려진다. 정본 실측(samples↔pdf 한컴 PDF, 10문서
+/// 표 53개): 문단(`issue4514` 141HU → +1.36pt, `issue7015` 140HU, `issue7500`)·단
+/// (`2025 행정업무운영 편람` 140HU → +1.05..1.13pt, `issue6969` 283HU → +2.62pt)·
+/// 용지(`issue2217` 852HU → +8.47pt) 기준 모두 같다. 쪽 기준과 가운데·오른쪽 정렬은
+/// 실측이 없어 열지 않는다.
+pub(crate) fn overlay_float_outer_margin_left_hu(table: &Table) -> Option<i32> {
+    if !matches!(
+        table.common.text_wrap,
+        TextWrap::BehindText | TextWrap::InFrontOfText
+    ) || table.common.treat_as_char
+        || !matches!(
+            table.common.horz_rel_to,
+            HorzRelTo::Para | HorzRelTo::Column | HorzRelTo::Paper
+        )
+        || !matches!(table.common.horz_align, HorzAlign::Left | HorzAlign::Inside)
+        || table.outer_margin_left <= 0
+    {
+        return None;
+    }
+    Some(i32::from(table.outer_margin_left))
+}
+
+/// 문단 기준 위 정렬 **글 앞으로/글 뒤로** 표의 위쪽 바깥여백 (HU).
+///
+/// 가로 [`overlay_float_outer_margin_left_hu`] 의 세로판이다. 같은 실측에서 표 위끝이
+/// 문단 기준 오프셋 아래 `outMargin.top` 만큼 내려와 있다(141HU → +1.0..1.34pt,
+/// 283HU → +2.68..2.77pt). 용지·쪽 기준은 `absolute_table_vertical_geometry` 가 이미
+/// 위 여백을 싣는다(`issue2217` 세로 차 0).
+pub(crate) fn overlay_float_outer_margin_top_hu(table: &Table) -> Option<i32> {
+    if !matches!(
+        table.common.text_wrap,
+        TextWrap::BehindText | TextWrap::InFrontOfText
+    ) || table.common.treat_as_char
+        || !matches!(table.common.vert_rel_to, VertRelTo::Para)
+        || !matches!(table.common.vert_align, VertAlign::Top | VertAlign::Inside)
+        || table.outer_margin_top <= 0
+    {
+        return None;
+    }
+    Some(i32::from(table.outer_margin_top))
+}
