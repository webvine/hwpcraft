+
+#[cfg(test)]
+mod outer_margin_box_tests {
+    //! 바깥 여백은 개체 상자의 일부다: 저장 오프셋은 여백을 포함한 상자를 가리키고,
+    //! 한글은 개체를 왼쪽·위 여백만큼 안쪽에 그린다(그림 #6596 과 같은 규칙).
+    use super::super::super::hwpunit_to_px;
+    use super::super::super::render_tree::{BoundingBox, RenderNode};
+    use crate::document_core::DocumentCore;
+    use crate::model::control::Control;
+
+    const DPI: f64 = 96.0;
+
+    fn first_box(node: &RenderNode, kind: &str) -> Option<BoundingBox> {
+        let name = serde_json::to_value(&node.node_type)
+            .ok()
+            .and_then(|v| v.as_object().and_then(|o| o.keys().next().cloned()));
+        if name.as_deref() == Some(kind) {
+            return Some(node.bbox);
+        }
+        node.children.iter().find_map(|c| first_box(c, kind))
+    }
+
+    fn page_box(core: &DocumentCore, kind: &str) -> BoundingBox {
+        let tree = core.build_page_render_tree(0).expect("render page");
+        first_box(&tree.root, kind).expect("object node")
+    }
+
+    fn ctrl_of(res: &str) -> (usize, usize) {
+        let field = |key: &str| {
+            res.split(key)
+                .nth(1)
+                .and_then(|s| {
+                    s.split(|c: char| !c.is_ascii_digit())
+                        .find(|t| !t.is_empty())
+                })
+                .and_then(|s| s.parse::<usize>().ok())
+                .expect("index in result")
+        };
+        (field("\"paraIdx\":"), field("\"controlIdx\":"))
+    }
+
+    fn margins(m: i16) -> String {
+        format!(
+            r#""outerMarginLeft":{m},"outerMarginTop":{m},"outerMarginRight":{m},"outerMarginBottom":{m}"#
+        )
+    }
+
+    fn core_with_text() -> DocumentCore {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        core.insert_text_native(0, 0, 0, "바깥 여백 상자 확인용 문단입니다.")
+            .unwrap();
+        core
+    }
+
+    #[test]
+    fn a_left_top_text_box_is_drawn_inside_its_outer_margin_in_every_wrap() {
+        let mut core = core_with_text();
+        let res = core
+            .create_shape_control_native(
+                0,
+                0,
+                0,
+                11339,
+                5669,
+                5000,
+                6000,
+                false,
+                "InFrontOfText",
+                "textbox",
+                false,
+                false,
+                &[],
+            )
+            .unwrap();
+        let (para, ctrl) = ctrl_of(&res);
+        for wrap in ["InFrontOfText", "BehindText", "Square", "TopAndBottom"] {
+            core.set_shape_properties_native(
+                0,
+                para,
+                ctrl,
+                &format!(r#"{{"textWrap":"{wrap}",{}}}"#, margins(0)),
+            )
+            .unwrap();
+            let bare = page_box(&core, "Rectangle");
+            assert!(
+                (bare.x - hwpunit_to_px(5000, DPI)).abs() < 0.01,
+                "{wrap}: {bare:?}"
+            );
+            assert!(
+                (bare.y - hwpunit_to_px(6000, DPI)).abs() < 0.01,
+                "{wrap}: {bare:?}"
+            );
+            core.set_shape_properties_native(0, para, ctrl, &format!("{{{}}}", margins(283)))
+                .unwrap();
+            let boxed = page_box(&core, "Rectangle");
+            assert!(
+                (boxed.x - bare.x - hwpunit_to_px(283, DPI)).abs() < 0.01,
+                "{wrap}: {bare:?} -> {boxed:?}"
+            );
+            assert!(
+                (boxed.y - bare.y - hwpunit_to_px(283, DPI)).abs() < 0.01,
+                "{wrap}: {bare:?} -> {boxed:?}"
+            );
+            assert_eq!((boxed.width, boxed.height), (bare.width, bare.height));
+        }
+    }
+
+    #[test]
+    fn a_shape_kept_in_the_column_keeps_its_bottom_margin_inside_too() {
+        // 쪽 영역 안으로 제한된 문단 기준 도형은 그림처럼 위·아래 여백을 포함한 상자가
+        // 단 안에 들어오도록 끌어올린다.
+        let mut core = core_with_text();
+        let res = core
+            .create_shape_control_native(
+                0,
+                0,
+                0,
+                11339,
+                5669,
+                5000,
+                6000,
+                false,
+                "InFrontOfText",
+                "textbox",
+                false,
+                false,
+                &[],
+            )
+            .unwrap();
+        let (para, ctrl) = ctrl_of(&res);
+        let props = |bottom: i16| {
+            format!(
+                r#"{{"vertRelTo":"Para","vertAlign":"Top","restrictInPage":true,"vertOffset":200000,"outerMarginLeft":283,"outerMarginTop":283,"outerMarginRight":283,"outerMarginBottom":{bottom}}}"#
+            )
+        };
+        core.set_shape_properties_native(0, para, ctrl, &props(0))
+            .unwrap();
+        let bare = page_box(&core, "Rectangle");
+        core.set_shape_properties_native(0, para, ctrl, &props(1000))
+            .unwrap();
+        let boxed = page_box(&core, "Rectangle");
+        assert!(
+            (bare.y - boxed.y - hwpunit_to_px(1000, DPI)).abs() < 0.01,
+            "{bare:?} -> {boxed:?}"
+        );
+    }
+
+    #[test]
+    fn right_and_bottom_aligned_shapes_keep_their_position() {
+        // 오른쪽·아래 정렬 도형은 한글 실측이 없어 종전 위치를 지킨다.
+        let mut core = core_with_text();
+        let res = core
+            .create_shape_control_native(
+                0,
+                0,
+                0,
+                11339,
+                5669,
+                5000,
+                6000,
+                false,
+                "InFrontOfText",
+                "rectangle",
+                false,
+                false,
+                &[],
+            )
+            .unwrap();
+        let (para, ctrl) = ctrl_of(&res);
+        core.set_shape_properties_native(
+            0,
+            para,
+            ctrl,
+            &format!(
+                r#"{{"horzAlign":"Right","vertAlign":"Bottom",{}}}"#,
+                margins(0)
+            ),
+        )
+        .unwrap();
+        let bare = page_box(&core, "Rectangle");
+        core.set_shape_properties_native(0, para, ctrl, &format!("{{{}}}", margins(283)))
+            .unwrap();
+        let boxed = page_box(&core, "Rectangle");
+        assert!((boxed.x - bare.x).abs() < 0.01 && (boxed.y - bare.y).abs() < 0.01);
+    }
+
+    #[test]
+    fn an_overlay_table_is_drawn_inside_its_outer_margin() {
+        for (wrap, rel) in [
+            ("InFrontOfText", "Para"),
+            ("BehindText", "Para"),
+            ("InFrontOfText", "Column"),
+        ] {
+            let mut core = core_with_text();
+            let res = core.create_table_native(0, 0, 0, 2, 2).unwrap();
+            let (para, ctrl) = ctrl_of(&res);
+            let props = format!(
+                r#"{{"treatAsChar":false,"textWrap":"{wrap}","vertRelTo":"Para","horzRelTo":"{rel}","horzAlign":"Left","vertAlign":"Top","horzOffset":2000,"vertOffset":1000}}"#
+            );
+            // 표 조판은 `outer_margin_*` 를 읽는다(`outerLeft` 속성은 공통 여백만 바꾼다).
+            let mut layout_with_margin = |m: i16| {
+                let Control::Table(t) =
+                    &mut core.document.sections[0].paragraphs[para].controls[ctrl]
+                else {
+                    panic!("table control");
+                };
+                t.outer_margin_left = m;
+                t.outer_margin_top = m;
+                t.outer_margin_right = m;
+                t.outer_margin_bottom = m;
+                core.set_table_properties_native(0, para, ctrl, &props)
+                    .unwrap();
+                page_box(&core, "Table")
+            };
+            let bare = layout_with_margin(0);
+            let boxed = layout_with_margin(283);
+            assert!(
+                (boxed.x - bare.x - hwpunit_to_px(283, DPI)).abs() < 0.01,
+                "{wrap}/{rel}: {bare:?} -> {boxed:?}"
+            );
+            assert!(
+                (boxed.y - bare.y - hwpunit_to_px(283, DPI)).abs() < 0.01,
+                "{wrap}/{rel}: {bare:?} -> {boxed:?}"
+            );
+        }
+    }
+}
