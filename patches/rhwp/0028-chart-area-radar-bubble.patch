+/// 방사형 (radarChart). 범주마다 바퀴살, 값 눈금마다 다각형 격자, 값 라벨은 위쪽
+/// 바퀴살 왼쪽. 첫 범주는 12시, 시계 방향. standard=선, marker=선+표식, filled=채움.
+fn render_radar(svg: &mut String, chart: &OoxmlChart, px: f64, py: f64, pw: f64, ph: f64) {
+    let n = chart.categories.len().max(
+        chart
+            .series
+            .iter()
+            .map(|s| s.values.len())
+            .max()
+            .unwrap_or(0),
+    );
+    if n == 0 {
+        return;
+    }
+    let font = label_font_px(chart);
+    let label_w = (0..n)
+        .map(|i| {
+            label_text_width(
+                chart.categories.get(i).map(String::as_str).unwrap_or(""),
+                font,
+            )
+        })
+        .fold(0.0_f64, f64::max);
+    // 방사형은 아래 범주 축 띠를 쓰지 않으므로 그 일부까지 그림 높이로 쓴다.
+    let avail_h = ph + font * hancom_default::BOTTOM_PAD_EM * 0.8;
+    let r = (avail_h / 2.0 - font * 1.8)
+        .min(pw / 2.0 - label_w - font * 0.6)
+        .max(10.0);
+    let (cx, cy) = (px + pw / 2.0, py + avail_h / 2.0);
+    let (dmin, dmax) = raw_value_bounds(chart.series.iter());
+    let (vmin, vmax, vstep) = nice_axis(
+        dmin.min(0.0),
+        dmax.max(dmin.min(0.0) + 1.0),
+        VERTICAL_AXIS_TICKS,
+    );
+    let angle =
+        |i: usize| -std::f64::consts::FRAC_PI_2 + std::f64::consts::TAU * i as f64 / n as f64;
+    let at = |i: usize, t: f64| (cx + r * t * angle(i).cos(), cy + r * t * angle(i).sin());
+    let t_of = |v: f64| {
+        if vmax > vmin {
+            ((v - vmin) / (vmax - vmin)).clamp(0.0, 1.0)
+        } else {
+            0.0
+        }
+    };
+    // 격자 다각형과 값 라벨
+    let ticks = if vstep > 0.0 {
+        (((vmax - vmin) / vstep).round() as usize).min(50)
+    } else {
+        0
+    };
+    for k in 0..=ticks {
+        let v = vmin + vstep * k as f64;
+        let t = t_of(v);
+        if k > 0 {
+            let ring: Vec<(f64, f64)> = (0..n).map(|i| at(i, t)).collect();
+            svg.push_str(&format!(
+                "<path class=\"hwp-chart-radar-grid\" d=\"{} Z\" fill=\"none\" {}/>\n",
+                polyline_path(&ring),
+                hancom_default::GRID_STYLE
+            ));
+        }
+        svg.push_str(&format!(
+            "<text x=\"{:.2}\" y=\"{:.2}\" font-family=\"sans-serif\" font-size=\"{:.2}\" fill=\"{}\" text-anchor=\"end\" dominant-baseline=\"central\">{}</text>\n",
+            cx - font * 0.4,
+            cy - r * t,
+            font,
+            hancom_default::TEXT_COLOR,
+            xml_escape(&radar_tick_label(v, vstep))
+        ));
+    }
+    // 바퀴살과 범주 라벨
+    for i in 0..n {
+        let (ex, ey) = at(i, 1.0);
+        svg.push_str(&format!(
+            "<line class=\"hwp-chart-radar-spoke\" x1=\"{cx:.2}\" y1=\"{cy:.2}\" x2=\"{ex:.2}\" y2=\"{ey:.2}\" {}/>\n",
+            hancom_default::GRID_STYLE
+        ));
+        // 위·아래 범주 라벨은 값 라벨과 겹치지 않게 조금 더 띄운다.
+        let gap = if angle(i).sin().abs() > 0.7 {
+            font * 1.1
+        } else {
+            font * 0.6
+        };
+        let (lx, ly) = (
+            cx + (r + gap) * angle(i).cos(),
+            cy + (r + gap) * angle(i).sin(),
+        );
+        let c = angle(i).cos();
+        let anchor = if c > 0.2 {
+            "start"
+        } else if c < -0.2 {
+            "end"
+        } else {
+            "middle"
+        };
+        let label = chart
+            .categories
+            .get(i)
+            .cloned()
+            .unwrap_or_else(|| format!("{}", i + 1));
+        svg.push_str(&format!(
+            "<text x=\"{lx:.2}\" y=\"{ly:.2}\" font-family=\"sans-serif\" font-size=\"{font:.2}\" fill=\"{}\" text-anchor=\"{anchor}\" dominant-baseline=\"central\">{}</text>\n",
+            hancom_default::TEXT_COLOR,
+            xml_escape(&label)
+        ));
+    }
+    // 계열
+    for (si, ser) in chart.series.iter().enumerate() {
+        if ser.values.is_empty() {
+            continue;
+        }
+        let color = series_color(ser, si);
+        let points: Vec<(f64, f64)> = ser
+            .values
+            .iter()
+            .enumerate()
+            .take(n)
+            .map(|(i, &v)| at(i, t_of(v)))
+            .collect();
+        let closed = points.len() == n && n > 2;
+        let d = format!(
+            "{}{}",
+            polyline_path(&points),
+            if closed { " Z" } else { "" }
+        );
+        if chart.radar_style == RadarStyle::Filled {
+            svg.push_str(&format!(
+                "<path class=\"hwp-chart-radar\" d=\"{d}\" fill=\"{color}\" stroke=\"{color}\" stroke-width=\"1\"/>\n"
+            ));
+        } else {
+            svg.push_str(&format!(
+                "<path class=\"hwp-chart-radar\" d=\"{d}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"{:.2}\"/>\n",
+                series_line_px(ser)
+            ));
+        }
+        if chart.radar_style == RadarStyle::Marker {
+            for &(mx, my) in &points {
+                push_line_marker(svg, si, mx, my, &color);
+            }
+        }
+    }
+}
