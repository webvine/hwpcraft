+/// 거품형 (bubbleChart). 축은 분산형과 같다(X값이 없으면 1, 2, …). 거품 넓이가 크기에
+/// 비례하고 가장 큰 거품의 지름은 플롯 짧은 변의 25 % × bubbleScale. 크기가 0 이하인
+/// 거품은 그리지 않는다(showNegBubbles 기본). 큰 거품을 먼저 그려 작은 거품이 보인다.
+fn render_bubble(svg: &mut String, chart: &OoxmlChart, px: f64, py: f64, pw: f64, ph: f64) {
+    let xs = |s: &OoxmlSeries| -> Vec<f64> {
+        if s.x_values.is_empty() {
+            (1..=s.values.len()).map(|i| i as f64).collect()
+        } else {
+            s.x_values.clone()
+        }
+    };
+    if chart.series.iter().all(|s| s.values.is_empty()) {
+        return;
+    }
+    let (xmin, xmax, xstep) = scatter_range(chart.series.iter().flat_map(|s| xs(s)));
+    let (ymin, ymax, ystep) =
+        scatter_range(chart.series.iter().flat_map(|s| s.values.iter().copied()));
+    let xspan = (xmax - xmin).max(1e-9);
+    let yspan = (ymax - ymin).max(1e-9);
+    svg.push_str(&plot_rect(chart, px, py, pw, ph));
+    render_value_grid(
+        svg, chart, px, py, pw, ph, xmin, xmax, xstep, None, true, false, false, true,
+    );
+    render_value_grid(
+        svg, chart, px, py, pw, ph, ymin, ymax, ystep, None, false, false, false, true,
+    );
+    let max_size = chart
+        .series
+        .iter()
+        .flat_map(|s| s.bubble_sizes.iter().copied())
+        .filter(|v| v.is_finite())
+        .fold(0.0_f64, f64::max);
+    let scale = chart.bubble_scale.unwrap_or(100.0).clamp(0.0, 300.0) / 100.0;
+    let r_max = pw.min(ph) * 0.125 * scale;
+    let mut bubbles: Vec<(f64, f64, f64, String)> = Vec::new();
+    for (si, ser) in chart.series.iter().enumerate() {
+        let color = series_color(ser, si);
+        for (i, (&x, &y)) in xs(ser).iter().zip(ser.values.iter()).enumerate() {
+            let size = ser.bubble_sizes.get(i).copied().unwrap_or(1.0);
+            if !size.is_finite() || size <= 0.0 {
+                continue;
+            }
+            let r = if max_size > 0.0 {
+                r_max * (size / max_size).sqrt()
+            } else {
+                r_max
+            };
+            bubbles.push((
+                px + pw * (x - xmin) / xspan,
+                py + ph - ph * (y - ymin) / yspan,
+                r,
+                color.clone(),
+            ));
+        }
+    }
+    bubbles.sort_by(|a, b| b.2.total_cmp(&a.2));
+    for (x, y, r, color) in bubbles {
+        svg.push_str(&format!(
+            "<circle class=\"hwp-chart-bubble\" cx=\"{x:.2}\" cy=\"{y:.2}\" r=\"{r:.2}\" fill=\"{color}\" fill-opacity=\"0.75\" stroke=\"#ffffff\" stroke-width=\"0.75\"/>\n"
+        ));
+    }
+}
