+// ---------------- Area / Radar / Bubble ----------------
+
+/// 영역형 (areaChart). 점은 꺾은선과 같은 카테고리 슬롯 중앙에 두고(범주 라벨과 같은
+/// 공식), 표준은 값과 0(값축 범위로 자름) 사이, 누적은 앞 계열 위를 채운다. 음수는 누적에서
+/// 0으로 자른다(막대·라인 누적과 같은 정책). 뒤 계열이 앞 계열 위에 그려진다.
+fn render_area(svg: &mut String, chart: &OoxmlChart, px: f64, py: f64, pw: f64, ph: f64) {
+    let stacked = matches!(
+        chart.area_grouping,
+        BarGrouping::Stacked | BarGrouping::PercentStacked
+    );
+    let percent = chart.area_grouping == BarGrouping::PercentStacked;
+    let max_len = chart
+        .series
+        .iter()
+        .map(|s| s.values.len())
+        .max()
+        .unwrap_or(0);
+    if max_len == 0 {
+        return;
+    }
+    let (vmin, vmax, vstep) = if percent {
+        (0.0, 100.0, 20.0)
+    } else if stacked {
+        let max_sum = (0..max_len)
+            .map(|ci| category_positive_sum(chart, ci))
+            .fold(0.0_f64, f64::max);
+        nice_axis(0.0, max_sum.max(1.0), VERTICAL_AXIS_TICKS)
+    } else {
+        value_range(chart, VERTICAL_AXIS_TICKS)
+    };
+    svg.push_str(&plot_rect(chart, px, py, pw, ph));
+    render_value_grid(
+        svg,
+        chart,
+        px,
+        py,
+        pw,
+        ph,
+        vmin,
+        vmax,
+        vstep,
+        chart.series.first().and_then(|s| s.format_code.as_deref()),
+        false,
+        false,
+        percent,
+        false,
+    );
+    let y_of = |v: f64| -> f64 {
+        let t = if vmax > vmin {
+            ((v - vmin) / (vmax - vmin)).clamp(0.0, 1.0)
+        } else {
+            0.0
+        };
+        py + ph - ph * t
+    };
+    let cat_span = pw / max_len as f64;
+    let base = 0.0_f64.clamp(vmin, vmax);
+    let mut cum = vec![0.0_f64; max_len];
+    let mut lower = vec![base; max_len];
+    for (si, ser) in chart.series.iter().enumerate() {
+        let n = ser.values.len();
+        if n == 0 {
+            continue;
+        }
+        let upper: Vec<f64> = (0..n)
+            .map(|i| {
+                let v = ser.values[i];
+                if !stacked {
+                    return v;
+                }
+                cum[i] += v.max(0.0);
+                if !percent {
+                    cum[i]
+                } else {
+                    let sum = category_positive_sum(chart, i);
+                    if sum > 0.0 {
+                        cum[i] / sum * 100.0
+                    } else {
+                        0.0
+                    }
+                }
+            })
+            .collect();
+        // 점 하나뿐이면 슬롯 절반 폭의 띠로 보인다.
+        let xs: Vec<f64> = if n == 1 {
+            vec![px + cat_span * 0.25, px + cat_span * 0.75]
+        } else {
+            (0..n).map(|i| px + cat_span * (i as f64 + 0.5)).collect()
+        };
+        let at = |k: usize| k.min(n - 1);
+        let mut points: Vec<(f64, f64)> = xs
+            .iter()
+            .enumerate()
+            .map(|(k, &x)| (x, y_of(upper[at(k)])))
+            .collect();
+        points.extend(
+            xs.iter()
+                .enumerate()
+                .rev()
+                .map(|(k, &x)| (x, y_of(if stacked { lower[at(k)] } else { base }))),
+        );
+        svg.push_str(&format!(
+            "<path class=\"hwp-chart-area\" d=\"{} Z\" fill=\"{}\" stroke=\"none\"/>\n",
+            polyline_path(&points),
+            series_color(ser, si)
+        ));
+        if stacked {
+            lower[..n].copy_from_slice(&upper);
+        }
+    }
+    render_category_labels(svg, chart, px, py, pw, ph, max_len, false);
+}
