+
+    fn chart(plot: &str) -> String {
+        format!(
+            r#"<?xml version="1.0"?><c:chartSpace xmlns:c="x" xmlns:a="y"><c:chart><c:plotArea>{plot}<c:catAx><c:axId val="100"/><c:axPos val="b"/></c:catAx><c:valAx><c:axId val="200"/><c:axPos val="l"/></c:valAx></c:plotArea><c:legend><c:legendPos val="r"/></c:legend></c:chart></c:chartSpace>"#
+        )
+    }
+
+    fn series(name: &str, values: &[f64]) -> String {
+        let pts: String = values
+            .iter()
+            .enumerate()
+            .map(|(i, v)| format!(r#"<c:pt idx="{i}"><c:v>{v}</c:v></c:pt>"#))
+            .collect();
+        format!(
+            r#"<c:ser><c:tx><c:v>{name}</c:v></c:tx><c:cat><c:strLit><c:pt idx="0"><c:v>가</c:v></c:pt><c:pt idx="1"><c:v>나</c:v></c:pt><c:pt idx="2"><c:v>다</c:v></c:pt></c:strLit></c:cat><c:val><c:numLit>{pts}</c:numLit></c:val></c:ser>"#
+        )
+    }
+
+    fn area(grouping: &str) -> OoxmlChart {
+        let xml = chart(&format!(
+            r#"<c:areaChart><c:grouping val="{grouping}"/>{}{}<c:axId val="100"/><c:axId val="200"/></c:areaChart>"#,
+            series("A", &[1.0, 3.0, 2.0]),
+            series("B", &[2.0, 1.0, 4.0])
+        ));
+        OoxmlChart::parse(xml.as_bytes()).expect("area parses")
+    }
+
+    #[test]
+    fn area_parses_grouping_and_fills_one_band_per_series() {
+        for (g, want) in [
+            ("standard", BarGrouping::Clustered),
+            ("stacked", BarGrouping::Stacked),
+            ("percentStacked", BarGrouping::PercentStacked),
+        ] {
+            let c = area(g);
+            assert_eq!(c.chart_type, OoxmlChartType::Area);
+            assert_eq!(c.area_grouping, want);
+            assert_eq!(c.grouping, BarGrouping::Clustered, "bar grouping untouched");
+            let svg = render_chart_svg(&c, 0.0, 0.0, 400.0, 300.0);
+            assert_eq!(svg.matches("hwp-chart-area").count(), 2, "{g}");
+            assert_eq!(svg, render_chart_svg(&c, 0.0, 0.0, 400.0, 300.0));
+        }
+        assert!(
+            render_chart_svg(&area("percentStacked"), 0.0, 0.0, 400.0, 300.0).contains(">100%<")
+        );
+        assert_ne!(
+            render_chart_svg(&area("standard"), 0.0, 0.0, 400.0, 300.0),
+            render_chart_svg(&area("stacked"), 0.0, 0.0, 400.0, 300.0)
+        );
+    }
+
