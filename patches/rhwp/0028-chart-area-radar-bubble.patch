+/// 축 눈금 라벨: 정수 간격이면 정수, 아니면 소수 한 자리까지.
+fn radar_tick_label(v: f64, step: f64) -> String {
+    if (step - step.round()).abs() < 1e-9 {
+        format!("{}", v.round() as i64)
+    } else {
+        let s = format!("{v:.2}");
+        s.trim_end_matches('0').trim_end_matches('.').to_string()
+    }
+}
