+/// rhwp: references at or above this number belong to the chunk written by
+/// [`SharedFonts::write`]; a chunk from [`to_chunk_with_shared_fonts`] refers to
+/// them and allocates its own objects below it. A merger must map these
+/// references the same way in every chunk.
+#[cfg(feature = "text")]
+pub const SHARED_FONT_REF_START: i32 = 1 << 30;
+
+/// rhwp: fonts subset once for several trees (the pages of one document) instead
+/// of once per tree. Glyphs are added tree by tree in the order `to_chunk` would
+/// meet them, so the result does not depend on how the trees were produced.
+#[cfg(feature = "text")]
+pub struct SharedFonts {
+    fonts: std::collections::HashMap<usvg::fontdb::ID, Option<render::text::Font>>,
+    allocator: util::allocate::RefAllocator,
+}
+
+#[cfg(feature = "text")]
+impl Default for SharedFonts {
+    fn default() -> Self {
+        Self {
+            fonts: Default::default(),
+            allocator: util::allocate::RefAllocator::starting_at(SHARED_FONT_REF_START),
+        }
+    }
+}
+
+#[cfg(feature = "text")]
+impl SharedFonts {
+    /// The glyphs `tree` draws: (font, glyph id, text), in drawing order. Cheap to
+    /// keep for many trees; reads no font data.
+    pub fn glyph_usage(tree: &Tree) -> Vec<(usvg::fontdb::ID, u16, String)> {
+        let mut out = Vec::new();
+        render::text::glyph_usage(tree.root(), &mut out);
+        out
+    }
+
+    /// Add one tree's glyphs (from [`SharedFonts::glyph_usage`]) after those of
+    /// the trees added before.
+    pub fn add(
+        &mut self,
+        fontdb: &usvg::fontdb::Database,
+        usage: Vec<(usvg::fontdb::ID, u16, String)>,
+    ) {
+        for glyph in usage {
+            render::text::add_glyph(&mut self.fonts, &mut self.allocator, fontdb, glyph);
+        }
+    }
+
+    /// Whether every glyph of `tree` is in these fonts.
+    pub fn covers(&self, tree: &Tree) -> bool {
+        Self::glyph_usage(tree).iter().all(|(id, glyph, _)| match self.fonts.get(id) {
+            Some(Some(font)) => font.glyph_remapper.get(*glyph).is_some(),
+            // A font that could not be read is skipped, as `to_chunk` does.
+            Some(None) => true,
+            None => false,
+        })
+    }
+
+    /// Write every font once (subset to the glyphs of all trees). Its references
+    /// start at [`SHARED_FONT_REF_START`].
+    pub fn write(&mut self) -> Result<Chunk> {
+        let mut chunk = Chunk::new();
+        let mut fonts: Vec<_> = self.fonts.values_mut().flatten().collect();
+        fonts.sort_by_key(|font| font.reference);
+        for font in fonts {
+            render::text::write_font(&mut chunk, &mut self.allocator, font)?;
+        }
+        Ok(chunk)
+    }
+}
+
+/// rhwp: like [`to_chunk`], but text refers to `fonts`, which the caller writes
+/// once with [`SharedFonts::write`]. Fails with `MissingGlyphs` when a glyph of
+/// `tree` was not added to `fonts`.
+#[cfg(feature = "text")]
+pub fn to_chunk_with_shared_fonts(
+    tree: &Tree,
+    conversion_options: ConversionOptions,
+    fonts: &SharedFonts,
+) -> Result<(Chunk, Ref)> {
+    if !fonts.covers(tree) {
+        return Err(ConversionError::MissingGlyphs);
+    }
+    let mut chunk = Chunk::new();
+    let mut ctx = Context::with_shared_fonts(conversion_options, fonts.fonts.clone());
+    let x_ref = tree_to_xobject(tree, &mut chunk, &mut ctx)?;
+    ctx.write_global_objects(&mut chunk)?;
+    Ok((chunk, x_ref))
+}
