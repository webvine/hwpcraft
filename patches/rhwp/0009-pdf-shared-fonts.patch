+/// Pages whose parsed trees are kept between the two passes of
+/// `convert_pages_with_shared_fonts`; longer documents parse every page twice so
+/// that only `threads` trees are alive at a time.
+#[cfg(not(target_arch = "wasm32"))]
+const SHARED_FONT_KEEP_TREES: usize = 64;
+
+/// Run `f` for every page on up to `threads` threads; results in page order, or
+/// `None` as soon as one page gives `None`.
+#[cfg(not(target_arch = "wasm32"))]
+fn map_pages_parallel<T: Send>(
+    pages: usize,
+    threads: usize,
+    f: impl Fn(usize) -> Option<T> + Sync,
+) -> Option<Vec<T>> {
+    use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+    let next = AtomicUsize::new(0);
+    let failed = AtomicBool::new(false);
+    let slots: Vec<std::sync::Mutex<Option<T>>> =
+        (0..pages).map(|_| std::sync::Mutex::new(None)).collect();
+    std::thread::scope(|scope| {
+        for _ in 0..threads.max(1) {
+            scope.spawn(|| loop {
+                if failed.load(Ordering::Acquire) {
+                    break;
+                }
+                let page_index = next.fetch_add(1, Ordering::AcqRel);
+                if page_index >= pages {
+                    break;
+                }
+                match f(page_index) {
+                    Some(value) => {
+                        if let Ok(mut slot) = slots[page_index].lock() {
+                            *slot = Some(value);
+                        }
+                    }
+                    None => failed.store(true, Ordering::Release),
+                }
+            });
+        }
+    });
+    if failed.load(Ordering::Acquire) {
+        return None;
+    }
+    slots
+        .into_iter()
+        .map(|slot| slot.into_inner().ok().flatten())
+        .collect()
 }
 
