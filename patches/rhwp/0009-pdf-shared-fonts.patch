+/// HwpCraft patch: subset each font once for the whole document.
+///
+/// `to_chunk` subsets every font per page, so a 381-page document carried 1,411
+/// subsets of the same few fonts (12.4 MB of a 24 MB file). Here every page is
+/// parsed once to list the glyphs it draws, the lists are added in page order
+/// (the same order a sequential `to_chunk` would meet them, whatever the thread
+/// count), the pages are converted against those fonts, and the fonts are written
+/// once. Any failure returns `None` and the caller uses the per-page path, which
+/// reports and isolates page errors as before. Documents of up to
+/// `SHARED_FONT_KEEP_TREES` pages keep their first parse instead of parsing again.
+#[cfg(not(target_arch = "wasm32"))]
+fn convert_pages_with_shared_fonts(
+    svg_pages: &[String],
+    export_options: &PdfExportOptions,
+    options: &usvg::Options<'_>,
+    threads: usize,
+) -> Option<(Vec<PdfPageData>, pdf_writer::Chunk)> {
+    let keep = svg_pages.len() <= SHARED_FONT_KEEP_TREES;
+    let first = map_pages_parallel(svg_pages.len(), threads, |page_index| {
+        let mut warnings = Vec::new();
+        let tree = pdf_page_tree(
+            page_index,
+            &svg_pages[page_index],
+            export_options,
+            options,
+            &mut warnings,
+        )
+        .ok()?;
+        let usage = svg2pdf::SharedFonts::glyph_usage(&tree);
+        Some((usage, keep.then_some((tree, warnings))))
+    })?;
+    let mut fonts = svg2pdf::SharedFonts::default();
+    let mut kept = Vec::with_capacity(if keep { svg_pages.len() } else { 0 });
+    for (usage, tree) in first {
+        fonts.add(&options.fontdb, usage);
+        kept.push(std::sync::Mutex::new(tree));
+    }
+    let pages = map_pages_parallel(svg_pages.len(), threads, |page_index| {
+        let parsed = kept
+            .get(page_index)
+            .and_then(|slot| slot.lock().ok().and_then(|mut tree| tree.take()));
+        let (tree, warnings) = match parsed {
+            Some(parsed) => parsed,
+            None => {
+                let mut warnings = Vec::new();
+                let tree = pdf_page_tree(
+                    page_index,
+                    &svg_pages[page_index],
+                    export_options,
+                    options,
+                    &mut warnings,
+                )
+                .ok()?;
+                (tree, warnings)
+            }
+        };
+        let mut conversion = svg2pdf::ConversionOptions::default();
+        conversion.embed_text = true;
+        let (chunk, svg_ref) =
+            svg2pdf::to_chunk_with_shared_fonts(&tree, conversion, &fonts).ok()?;
+        let dpi_ratio = 72.0 / 96.0; // 96 DPI → 72 pt
+        Some((
+            PdfPageData {
+                chunk,
+                svg_ref,
+                width: tree.size().width() * dpi_ratio,
+                height: tree.size().height() * dpi_ratio,
+                source_index: page_index,
+            },
