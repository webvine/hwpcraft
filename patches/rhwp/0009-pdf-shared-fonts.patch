+    let fonts_chunk = fonts.write().ok()?;
+    let mut page_datas = Vec::with_capacity(pages.len());
+    for (page, warnings) in pages {
+        for warning in warnings {
+            eprintln!("{warning}");
+        }
+        page_datas.push(page);
+    }
+    Some((page_datas, fonts_chunk))
