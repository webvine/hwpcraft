+/// rhwp: every glyph a group draws, in the order `fill_fonts` would meet them:
+/// (font, glyph id, text). Font data is not read.
+pub fn glyph_usage(group: &Group, out: &mut Vec<(fontdb::ID, u16, String)>) {
+    for child in group.children() {
+        match child {
+            Node::Text(t) => {
+                for span in t.layouted() {
+                    for g in &span.positioned_glyphs {
+                        out.push((g.font, g.id.0, g.text.clone()));
+                    }
+                }
+            }
+            Node::Group(group) => glyph_usage(group, out),
+            Node::Image(image) => {
+                if let ImageKind::SVG(svg) = image.kind() {
+                    glyph_usage(svg.root(), out);
+                }
+            }
+            _ => {}
+        }
+        child.subroots(|subroot| glyph_usage(subroot, out));
+    }
+}
+
+/// rhwp: add one glyph to `fonts` exactly as `fill_fonts` does, allocating the
+/// font's reference from `allocator` the first time the font is seen.
+pub fn add_glyph(
+    fonts: &mut HashMap<fontdb::ID, Option<Font>>,
+    allocator: &mut RefAllocator,
+    fontdb: &fontdb::Database,
+    (id, glyph, text): (fontdb::ID, u16, String),
+) {
+    let font = fonts.entry(id).or_insert_with(|| {
+        fontdb
+            .with_face_data(id, |data, face_index| {
+                let ttf = ttf_parser::Face::parse(data, face_index).ok()?;
+                Some(Font {
+                    id,
+                    reference: allocator.alloc_ref(),
+                    face_data: Arc::new(Vec::from(data)),
+                    units_per_em: ttf.units_per_em(),
+                    glyph_set: BTreeMap::new(),
+                    glyph_remapper: GlyphRemapper::new(),
+                    face_index,
+                })
+            })
+            .flatten()
+    });
+    if let Some(font) = font {
+        font.glyph_set.insert(glyph, text);
+        font.glyph_remapper.remap(glyph);
+    }
+}
