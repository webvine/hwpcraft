+/// 줄 번호 매기기를 HWP5 자리로 옮긴다 — flags bit 24(표시)와 확장 tail offset 10..19
+/// (재시작 u8, 간격 u16, 본문과의 거리 u32, 시작 번호 u16 — 한글 2024 저장본 실측).
+///
+/// HWP5 원본은 파서가 같은 자리에서 읽어 온 값이므로 같은 바이트가 다시 적힌다.
+/// 구 계약(10 byte tail)에는 자리가 없어 표시 비트만 옮긴다.
+fn materialize_section_def_line_numbers(section_def: &mut SectionDef) {
+    const SHOW_LINE_NUMBER_FLAG: u32 = 0x0100_0000;
+
+    if section_def.show_line_number {
+        section_def.flags |= SHOW_LINE_NUMBER_FLAG;
+    } else {
+        section_def.flags &= !SHOW_LINE_NUMBER_FLAG;
+    }
+    let Some(attrs) = &section_def.line_number_shape else {
+        return;
+    };
+    let Some(tail) = section_def.raw_ctrl_extra.get_mut(10..19) else {
+        return;
+    };
+    let value = |key: &str| {
+        attrs
+            .iter()
+            .find(|(k, _)| k == key)
+            .and_then(|(_, v)| v.parse::<u32>().ok())
+            .unwrap_or(0)
+    };
+    tail[0] = value("restartType") as u8;
+    tail[1..3].copy_from_slice(&(value("countBy") as u16).to_le_bytes());
+    tail[3..7].copy_from_slice(&value("distance").to_le_bytes());
+    tail[7..9].copy_from_slice(&(value("startNumber") as u16).to_le_bytes());
+}
