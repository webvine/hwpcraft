+#[cfg(test)]
+mod topbottom_table_next_paragraph_tests {
+    //! 문단 기준 자리차지 표(바깥 여백 283)와 그 캡션 뒤 문단은 표 상자(위·아래 바깥
+    //! 여백과 캡션 포함) 아래에서 시작한다 — 편집 중 화면, HWP 저장 후, 줄 캐시 없이
+    //! 쓴 HWPX(HwpCraft 의 새 문서) 저장 후 다시 연 화면이 모두 같아야 한다. 새 문서의
+    //! 줄은 HwpCraft 처럼 RHWP 의 것으로 표시한다(한글이 저장한 줄이 없는 구역).
+    use crate::document_core::DocumentCore;
+    use crate::model::control::Control;
+    use crate::model::paragraph::{LineSeg, Paragraph};
+    use crate::renderer::render_tree::{RenderNode, RenderNodeType};
+
+    /// (표 위끝, 표·캡션 상자 아래끝, 다음 문단 첫 줄 위끝)
+    fn geometry(core: &DocumentCore) -> (f64, f64, f64) {
+        fn walk(node: &RenderNode, out: &mut Vec<(String, f64, f64)>) {
+            match &node.node_type {
+                RenderNodeType::Table(_) => out.push((
+                    "<table>".into(),
+                    node.bbox.y,
+                    node.bbox.y + node.bbox.height,
+                )),
+                RenderNodeType::TextRun(run) if !run.text.trim().is_empty() => out.push((
+                    run.text.clone(),
+                    node.bbox.y,
+                    node.bbox.y + node.bbox.height,
+                )),
+                _ => {}
+            }
+            for child in &node.children {
+                walk(child, out);
+            }
+        }
+        let tree = core.build_page_render_tree(0).unwrap();
+        let mut items = Vec::new();
+        walk(&tree.root, &mut items);
+        let table = items
+            .iter()
+            .find(|i| i.0 == "<table>")
+            .expect("table")
+            .clone();
+        let next = items
+            .iter()
+            .find(|i| i.0.starts_with("다음"))
+            .expect("next")
+            .1;
+        // 표 안 글자와 캡션 글자: 제목과 다음 문단을 뺀 나머지.
+        let bottom = items
+            .iter()
+            .filter(|i| !i.0.starts_with("다음") && !i.0.starts_with("제목"))
+            .map(|i| i.2)
+            .fold(table.2, f64::max);
+        (table.1, bottom, next)
+    }
+
+    fn document(caption: Option<u8>) -> DocumentCore {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        mark_own(&mut core.document_mut().sections[0].paragraphs);
+        core.insert_text_native(0, 0, 0, "제목").unwrap();
+        core.split_paragraph_native(0, 0, 2, None).unwrap();
+        core.create_table_native(0, 1, 0, 3, 3).unwrap();
+        for cell in 0..9 {
+            core.insert_text_in_cell_native(0, 1, 0, cell, 0, 0, "가")
+                .unwrap();
+        }
+        if let Some(direction) = caption {
+            core.set_table_properties_native(
+                0,
+                1,
+                0,
+                &format!(r#"{{"hasCaption":true,"captionDirection":{direction}}}"#),
+            )
+            .unwrap();
+        }
+        core.insert_text_native(0, 2, 0, "다음 문단").unwrap();
+        core
+    }
+
+    fn mark_own(paragraphs: &mut [Paragraph]) {
+        for para in paragraphs {
+            for line in &mut para.line_segs {
+                line.tag |= LineSeg::TAG_IMPLEMENTATION_PROPERTY;
+            }
+            for ctrl in &mut para.controls {
+                if let Control::Table(table) = ctrl {
+                    for cell in &mut table.cells {
+                        mark_own(&mut cell.paragraphs);
+                    }
+                    if let Some(caption) = table.caption.as_mut() {
+                        mark_own(&mut caption.paragraphs);
+                    }
+                }
+            }
+        }
+    }
+
+    fn check(caption: Option<u8>) {
+        let core = document(caption);
+        let live = geometry(&core);
+        // HWP 는 줄 캐시를 쓴다.
+        let hwp = DocumentCore::from_bytes(&core.export_hwp_native().unwrap()).unwrap();
+        // 줄 캐시 없이 쓴 HWPX 는 다시 읽을 때 새로 조판한다.
+        let mut export = DocumentCore::new_empty();
+        *export.document_mut() = core.document().clone();
+        mark_own(&mut export.document_mut().sections[0].paragraphs);
+        let mut hwpx = DocumentCore::from_bytes(&export.export_hwpx_native().unwrap()).unwrap();
+        hwpx.reflow_linesegs_on_demand();
+        let margin = crate::renderer::hwpunit_to_px(283, 96.0);
+        for (name, (top, bottom, next)) in [
+            ("live", live),
+            ("hwp", geometry(&hwp)),
+            ("hwpx", geometry(&hwpx)),
+        ] {
+            eprintln!("{caption:?} {name}: top {top:.2} box bottom {bottom:.2} next {next:.2}");
+            assert!(
+                next >= bottom + margin - 0.5,
+                "{caption:?} {name}: top {top} box bottom {bottom} next {next}"
+            );
+            assert!(
+                (top - live.0).abs() < 0.5 && (next - live.2).abs() < 0.5,
+                "{caption:?} {name}: {:?} vs live {live:?}",
+                (top, bottom, next)
+            );
+        }
+    }
+
+    #[test]
+    fn the_paragraph_after_a_topbottom_table_starts_below_its_outer_margin() {
+        check(None);
+    }
+
+    #[test]
+    fn the_paragraph_after_a_captioned_topbottom_table_starts_below_the_caption() {
+        // 아래(3)·위(2)·왼쪽(0)·오른쪽(1) 캡션.
+        for direction in [3, 2, 0, 1] {
+            check(Some(direction));
+        }
+    }
+
+    /// 한글이 저장한 줄에서는 다음 문단이 표 상자 안쪽(host 줄 바로 아래)에 있을 수
+    /// 있다. host 앞에서 Enter 를 치면 host 와 다음 문단이 같이 내려가야 한다 — 상자
+    /// 끝을 리셋 기준으로 쓰면 다음 문단을 단 리셋으로 보고 제자리에 둔다.
+    #[test]
+    fn enter_before_a_host_with_hangul_rows_moves_the_next_paragraph_too() {
+        let mut core = document(None);
+        {
+            let paragraphs = &mut core.document_mut().sections[0].paragraphs;
+            let mut vpos = 0;
+            for para in paragraphs.iter_mut() {
+                for line in &mut para.line_segs {
+                    line.tag &= !LineSeg::TAG_IMPLEMENTATION_PROPERTY;
+                    line.vertical_pos = vpos;
+                    vpos += line.line_height + line.line_spacing;
+                }
+            }
+            let table_height = paragraphs[1]
+                .controls
+                .iter()
+                .find_map(|ctrl| match ctrl {
+                    Control::Table(table) => Some(table.common.height as i32),
+                    _ => None,
+                })
+                .unwrap();
+            assert!(
+                paragraphs[2].line_segs[0].vertical_pos
+                    < paragraphs[1].line_segs[0].vertical_pos + table_height
+            );
+        }
+        let first = |core: &DocumentCore, pi: usize| {
+            core.document().sections[0].paragraphs[pi].line_segs[0].vertical_pos
+        };
+        let (host, next) = (first(&core, 1), first(&core, 2));
+        core.split_paragraph_native(0, 0, 2, None).unwrap();
+        let (dh, dn) = (first(&core, 2) - host, first(&core, 3) - next);
+        assert!(dh > 0, "host moved {dh}");
+        assert_eq!(dn, dh, "next paragraph moved {dn}, host {dh}");
+    }
+}
