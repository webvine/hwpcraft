+/// 문단에 앵커된 문단 기준 위 정렬 자리차지 표들의 바깥 여백 상자 아래끝 — 문단
+/// 첫 줄 vpos 에서 잰 HWPUNIT. 음수 세로 오프셋은 0 으로 본다(한글 저장 줄 실측).
+/// 위·아래 캡션은 캡션 간격 + 캡션 줄 높이(마지막 줄간격 제외)를 더한다 — 한글 저장
+/// 줄 실측(캡션 있는 빈 host 86건 정확 일치).
+pub(crate) fn para_topbottom_table_box_end_hu(para: &Paragraph) -> Option<i32> {
+    use crate::model::shape::{TextWrap, VertAlign, VertRelTo};
+    para.controls
+        .iter()
+        .filter_map(|ctrl| match ctrl {
+            Control::Table(table)
+                if !table.common.treat_as_char
+                    && table.common.text_wrap == TextWrap::TopAndBottom
+                    && table.common.vert_rel_to == VertRelTo::Para
+                    && matches!(table.common.vert_align, VertAlign::Top | VertAlign::Inside) =>
+            {
+                let offset = (table.common.vertical_offset as i32).max(0);
+                let caption = table
+                    .caption
+                    .as_ref()
+                    .filter(|caption| {
+                        matches!(
+                            caption.direction,
+                            crate::model::shape::CaptionDirection::Top
+                                | crate::model::shape::CaptionDirection::Bottom
+                        )
+                    })
+                    .map_or(0, |caption| {
+                        let lines: Vec<&LineSeg> = caption
+                            .paragraphs
+                            .iter()
+                            .flat_map(|para| para.line_segs.iter())
+                            .collect();
+                        if lines.is_empty() {
+                            return 0;
+                        }
+                        let height: i32 = lines
+                            .iter()
+                            .map(|line| line.line_height.saturating_add(line.line_spacing))
+                            .sum();
+                        i32::from(caption.spacing)
+                            .saturating_add(height)
+                            .saturating_sub(lines.last().map_or(0, |line| line.line_spacing))
+                    });
+                Some(
+                    offset
+                        .saturating_add(i32::from(table.outer_margin_top))
+                        .saturating_add(table.common.height.min(i32::MAX as u32) as i32)
+                        .saturating_add(caption)
+                        .saturating_add(i32::from(table.outer_margin_bottom)),
+                )
+            }
+            _ => None,
+        })
+        .max()
+}
