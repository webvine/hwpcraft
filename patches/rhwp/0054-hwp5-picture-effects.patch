+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// aift.hwp 그림의 효과 정보(한글 저장본): 그림자 OUTSIDE, alpha 0.8, radius 400,
+    /// direction 45, distance 1000, TOP_LEFT, 검정 RGB.
+    const AIFT: &str = "0100000000000000cdcc4c3f0000c8430000344200007a440000000000000000000000000000803f0000803f00000000000000000000000000000000";
+
+    fn hex(s: &str) -> Vec<u8> {
+        (0..s.len())
+            .step_by(2)
+            .map(|i| u8::from_str_radix(&s[i..i + 2], 16).unwrap())
+            .collect()
+    }
+
+    #[test]
+    fn a_hangul_shadow_reads_and_writes_back_byte_for_byte() {
+        let bytes = hex(AIFT);
+        let (effects, used) = decode(&bytes).expect("decode");
+        assert_eq!(used, bytes.len());
+        let shadow = effects.shadow.as_ref().unwrap();
+        assert_eq!(shadow.alpha.as_deref(), Some("0.8"));
+        assert_eq!(shadow.radius.as_deref(), Some("400"));
+        assert_eq!(shadow.align_style.as_deref(), Some("TOP_LEFT"));
+        assert_eq!(encode(&effects), bytes);
+    }
+
+    #[test]
+    fn every_effect_with_colours_round_trips() {
+        let color = |r: &str, g: &str, b: &str| EffectColor {
+            color_type: Some("RGB".into()),
+            scheme_idx: Some("-1".into()),
+            system_idx: Some("-1".into()),
+            preset_idx: Some("-1".into()),
+            rgb: Some(EffectRgb {
+                r: Some(r.into()),
+                g: Some(g.into()),
+                b: Some(b.into()),
+            }),
+            transforms: Vec::new(),
+        };
+        let mut glow_color = color("255", "0", "0");
+        glow_color.transforms.push(EffectColorTransform {
+            kind: "ALPHA".into(),
+            value: "0.5".into(),
+        });
+        let effects = PictureEffects {
+            shadow: Some(PictureShadow {
+                style: Some("INSIDE".into()),
+                alpha: Some("0.3".into()),
+                radius: Some("100".into()),
+                direction: Some("90".into()),
+                distance: Some("200".into()),
+                align_style: Some("CENTER".into()),
+                rotation_style: Some("1".into()),
+                skew: None,
+                scale: None,
+                color: Some(color("0", "128", "255")),
+            }),
+            glow: Some(PictureGlow {
+                alpha: Some("0.5".into()),
+                radius: Some("500".into()),
+                color: Some(glow_color),
+            }),
+            soft_edge: Some(PictureSoftEdge {
+                radius: Some("300".into()),
+            }),
+            reflection: Some(PictureReflection {
+                align_style: Some("BOTTOM_LEFT".into()),
+                radius: Some("50".into()),
+                direction: Some("90".into()),
+                distance: Some("0".into()),
+                rotation_style: Some("0".into()),
+                fade_direction: Some("90".into()),
+                skew: None,
+                scale: None,
+                alpha: Some(EffectRange {
+                    start: Some("0.5".into()),
+                    end: Some("1".into()),
+                }),
+                pos: Some(EffectRange {
+                    start: Some("0".into()),
+                    end: Some("0.5".into()),
+                }),
+            }),
+        };
+        let bytes = encode(&effects);
+        assert_eq!(bytes.len(), 4 + (44 + 12) + (8 + 12 + 8) + 4 + 56);
+        let (back, used) = decode(&bytes).expect("decode");
+        assert_eq!(used, bytes.len());
+        assert_eq!(encode(&back), bytes);
+        let rgb = back.shadow.unwrap().color.unwrap().rgb.unwrap();
+        assert_eq!(
+            (rgb.r.as_deref(), rgb.g.as_deref(), rgb.b.as_deref()),
+            (Some("0"), Some("128"), Some("255"))
+        );
+        assert_eq!(
+            back.glow.unwrap().color.unwrap().transforms[0].kind,
+            "ALPHA"
+        );
+    }
+
+    fn pictures(doc: &crate::model::document::Document) -> Vec<&crate::model::image::Picture> {
+        use crate::model::control::Control;
+        use crate::model::paragraph::Paragraph;
+        use crate::model::shape::ShapeObject;
+        fn shape<'a>(s: &'a ShapeObject, out: &mut Vec<&'a crate::model::image::Picture>) {
+            match s {
+                ShapeObject::Picture(p) => out.push(p),
+                ShapeObject::Group(g) => g.children.iter().for_each(|c| shape(c, out)),
+                _ => {}
+            }
+        }
+        fn walk<'a>(ps: &'a [Paragraph], out: &mut Vec<&'a crate::model::image::Picture>) {
+            for p in ps {
+                for c in &p.controls {
+                    match c {
+                        Control::Picture(pic) => out.push(pic),
+                        Control::Shape(s) => shape(s, out),
+                        Control::Table(t) => t.cells.iter().for_each(|c| walk(&c.paragraphs, out)),
+                        _ => {}
+                    }
+                }
+            }
+        }
+        let mut out = Vec::new();
+        for s in &doc.sections {
+            walk(&s.paragraphs, &mut out);
+        }
+        out
+    }
+
+    /// 한글이 저장한 aift.hwp 그림자가 모델로 읽히고, HWP 저장·재열기 뒤 같은 바이트로 남는다.
+    /// 모델에 넣은 네 효과도 HWP 저장·재열기로 그대로 돌아온다.
+    #[test]
+    fn hwp_saves_keep_picture_effects() {
+        use crate::document_core::DocumentCore;
+        let bytes = std::fs::read("samples/aift.hwp").expect("samples/aift.hwp");
+        let mut core = DocumentCore::from_bytes(&bytes).expect("open");
+        let tails: Vec<Vec<u8>> = pictures(core.document())
+            .iter()
+            .map(|p| p.raw_picture_extra.clone())
+            .collect();
+        let shadowed = pictures(core.document())
+            .iter()
+            .filter(|p| p.effects.shadow.is_some())
+            .count();
+        assert!(shadowed > 0);
+        let saved = core.export_hwp_native().expect("save");
+        let back = DocumentCore::from_bytes(&saved).expect("reopen");
+        let again: Vec<Vec<u8>> = pictures(back.document())
+            .iter()
+            .map(|p| p.raw_picture_extra.clone())
+            .collect();
+        assert_eq!(again, tails, "unchanged effects keep their bytes");
+
+        let full = {
+            let mut glow = super::super::image::PictureGlow::default();
+            glow.alpha = Some("0.5".into());
+            glow.radius = Some("500".into());
+            glow.color = Some(EffectColor {
+                color_type: Some("RGB".into()),
+                rgb: Some(EffectRgb {
+                    r: Some("255".into()),
+                    g: Some("200".into()),
+                    b: Some("0".into()),
+                }),
+                ..Default::default()
+            });
+            PictureEffects {
+                glow: Some(glow),
+                soft_edge: Some(PictureSoftEdge {
+                    radius: Some("300".into()),
+                }),
+                ..Default::default()
+            }
+        };
+        let expected = encode(&full);
+        {
+            use crate::model::control::Control;
+            use crate::model::paragraph::Paragraph;
+            use crate::model::shape::ShapeObject;
+            fn first(ps: &mut [Paragraph]) -> Option<&mut crate::model::image::Picture> {
+                for p in ps {
+                    for c in &mut p.controls {
+                        let found = match c {
+                            Control::Picture(pic) => Some(pic.as_mut()),
+                            Control::Shape(s) => match s.as_mut() {
+                                ShapeObject::Picture(pic) => Some(pic.as_mut()),
+                                _ => None,
+                            },
+                            Control::Table(t) => {
+                                t.cells.iter_mut().find_map(|c| first(&mut c.paragraphs))
+                            }
+                            _ => None,
+                        };
+                        if found.is_some() {
+                            return found;
+                        }
+                    }
+                }
+                None
+            }
+            let doc = core.document_mut();
+            let pic = doc
+                .sections
+                .iter_mut()
+                .find_map(|s| first(&mut s.paragraphs))
+                .expect("a picture");
+            pic.effects = full;
+        }
+        let saved = core.export_hwp_native().expect("save with effects");
+        let back = DocumentCore::from_bytes(&saved).expect("reopen with effects");
+        assert_eq!(encode(&pictures(back.document())[0].effects), expected);
+    }
+
+    #[test]
+    fn no_effect_is_a_zero_word() {
+        assert_eq!(encode(&PictureEffects::default()), vec![0, 0, 0, 0]);
+        assert_eq!(decode(&[0, 0, 0, 0]).map(|(_, n)| n), Some(4));
+    }
+}
