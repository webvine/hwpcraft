+//! HWP5 그림 효과 정보 (한글문서파일형식 5.0 표 108–115)와 [`PictureEffects`] 사이 변환.
+//!
+//! `SHAPE_COMPONENT_PICTURE` 의 instance ID 뒤에 온다: UINT32 효과 비트(1 그림자, 2 네온,
+//! 4 부드러운 가장자리, 8 반사) 다음에 있는 효과만 그 순서로 이어진다. 색상은 종류(INT32)
+//! 다음 값 하나(RGB 0x00rrggbb 또는 CMYK)와 색상 효과 수·(종류, 값) 목록이다. 한글 저장본
+//! (aift.hwp 그림자)의 바이트로 확인한 것은 그림자와 RGB 색이고, 네온·부드러운 가장자리·
+//! 반사는 명세의 필드 순서를 따른다. 반사는 명세 표의 필드 14개(56바이트)로 쓴다.
+
+use super::image::{
+    EffectColor, EffectColorTransform, EffectPoint, EffectRange, EffectRgb, PictureEffects,
+    PictureGlow, PictureReflection, PictureShadow, PictureSoftEdge,
+};
+
+const SHADOW: u32 = 1;
+const GLOW: u32 = 2;
+const SOFT_EDGE: u32 = 4;
+const REFLECTION: u32 = 8;
+
+const ALIGN_STYLES: [&str; 9] = [
+    "TOP_LEFT",
+    "TOP",
+    "TOP_RIGHT",
+    "LEFT",
+    "CENTER",
+    "RIGHT",
+    "BOTTOM_LEFT",
+    "BOTTOM",
+    "BOTTOM_RIGHT",
+];
+
+/// HWPX 색상 효과 종류 ↔ HWP5 표 115 값.
+const COLOR_EFFECTS: [(&str, i32); 6] = [
+    ("ALPHA", 0),
+    ("GRAY", 23),
+    ("COMP", 24),
+    ("GAMMA", 25),
+    ("INV_GAMMA", 26),
+    ("INV", 27),
+];
+
+fn float(value: &Option<String>, default: f32) -> f32 {
+    value
+        .as_deref()
+        .and_then(|v| v.trim().parse::<f32>().ok())
+        .unwrap_or(default)
+}
+
+fn flag(value: &Option<String>) -> i32 {
+    matches!(value.as_deref().map(str::trim), Some("1" | "true")) as i32
+}
+
+fn align(value: &Option<String>) -> i32 {
+    value
+        .as_deref()
+        .and_then(|v| ALIGN_STYLES.iter().position(|s| *s == v))
+        .unwrap_or(0) as i32
+}
+
+fn text(value: f32) -> Option<String> {
+    Some(value.to_string())
+}
+
+/// HSL(0–255 범위)을 RGB 로.
+fn hsl_to_rgb(h: f32, s: f32, l: f32) -> (u8, u8, u8) {
+    let (h, s, l) = (h / 255.0 * 360.0, s / 255.0, l / 255.0);
+    let c = (1.0 - (2.0 * l - 1.0).abs()) * s;
+    let x = c * (1.0 - ((h / 60.0) % 2.0 - 1.0).abs());
+    let m = l - c / 2.0;
+    let (r, g, b) = match (h / 60.0) as u32 {
+        0 => (c, x, 0.0),
+        1 => (x, c, 0.0),
+        2 => (0.0, c, x),
+        3 => (0.0, x, c),
+        4 => (x, 0.0, c),
+        _ => (c, 0.0, x),
+    };
+    let byte = |v: f32| ((v + m) * 255.0).round().clamp(0.0, 255.0) as u8;
+    (byte(r), byte(g), byte(b))
+}
+
+fn push_color(out: &mut Vec<u8>, color: Option<&EffectColor>) {
+    let channel = |v: &Option<String>| {
+        v.as_deref()
+            .and_then(|v| v.trim().parse::<f32>().ok())
+            .unwrap_or(0.0)
+    };
+    let rgb = color.and_then(|c| c.rgb.as_ref());
+    let (r, g, b) = match (color.and_then(|c| c.color_type.as_deref()), rgb) {
+        // SYSTEM 색은 h·s·l 을 r·g·b 칸에 담아 읽는다(`hp:system`).
+        (Some("SYSTEM"), Some(v)) => hsl_to_rgb(channel(&v.r), channel(&v.g), channel(&v.b)),
+        (_, Some(v)) => (
+            channel(&v.r).clamp(0.0, 255.0) as u8,
+            channel(&v.g).clamp(0.0, 255.0) as u8,
+            channel(&v.b).clamp(0.0, 255.0) as u8,
+        ),
+        _ => (0, 0, 0),
+    };
+    // RGB 만 쓴다: SCHEME·SYSTEM 은 그 값을 RGB 로 바꾼 것이다.
+    out.extend_from_slice(&0i32.to_le_bytes());
+    let value = (u32::from(r) << 16) | (u32::from(g) << 8) | u32::from(b);
+    out.extend_from_slice(&value.to_le_bytes());
+    let effects: Vec<(i32, f32)> = color
+        .map(|c| {
+            c.transforms
+                .iter()
+                .filter_map(|t| {
+                    let kind = COLOR_EFFECTS.iter().find(|(name, _)| *name == t.kind)?.1;
+                    Some((kind, t.value.trim().parse::<f32>().unwrap_or(0.0)))
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    out.extend_from_slice(&(effects.len() as u32).to_le_bytes());
+    for (kind, value) in effects {
+        out.extend_from_slice(&kind.to_le_bytes());
+        out.extend_from_slice(&value.to_le_bytes());
+    }
+}
+
+/// [`PictureEffects`] 를 HWP5 그림 효과 정보로. 효과가 없으면 효과 비트 0 하나(4바이트).
+pub fn encode(effects: &PictureEffects) -> Vec<u8> {
+    let mut bits = 0u32;
+    let mut body = Vec::new();
+    let f = |out: &mut Vec<u8>, v: f32| out.extend_from_slice(&v.to_le_bytes());
+    let i = |out: &mut Vec<u8>, v: i32| out.extend_from_slice(&v.to_le_bytes());
+    if let Some(s) = &effects.shadow {
+        bits |= SHADOW;
+        i(&mut body, (s.style.as_deref() == Some("INSIDE")) as i32);
+        f(&mut body, float(&s.alpha, 0.0));
+        f(&mut body, float(&s.radius, 0.0));
+        f(&mut body, float(&s.direction, 0.0));
+        f(&mut body, float(&s.distance, 0.0));
+        i(&mut body, align(&s.align_style));
+        let skew = s.skew.clone().unwrap_or_default();
+        f(&mut body, float(&skew.x, 0.0));
+        f(&mut body, float(&skew.y, 0.0));
+        let scale = s.scale.clone().unwrap_or_default();
+        f(&mut body, float(&scale.x, 1.0));
+        f(&mut body, float(&scale.y, 1.0));
+        i(&mut body, flag(&s.rotation_style));
+        push_color(&mut body, s.color.as_ref());
+    }
+    if let Some(g) = &effects.glow {
+        bits |= GLOW;
+        f(&mut body, float(&g.alpha, 0.0));
+        f(&mut body, float(&g.radius, 0.0));
+        push_color(&mut body, g.color.as_ref());
+    }
+    if let Some(e) = &effects.soft_edge {
+        bits |= SOFT_EDGE;
+        f(&mut body, float(&e.radius, 0.0));
+    }
+    if let Some(r) = &effects.reflection {
+        bits |= REFLECTION;
+        i(&mut body, align(&r.align_style));
+        f(&mut body, float(&r.radius, 0.0));
+        f(&mut body, float(&r.direction, 0.0));
+        f(&mut body, float(&r.distance, 0.0));
+        let skew = r.skew.clone().unwrap_or_default();
+        f(&mut body, float(&skew.x, 0.0));
+        f(&mut body, float(&skew.y, 0.0));
+        let scale = r.scale.clone().unwrap_or_default();
+        f(&mut body, float(&scale.x, 1.0));
+        f(&mut body, float(&scale.y, 1.0));
+        i(&mut body, flag(&r.rotation_style));
+        let alpha = r.alpha.clone().unwrap_or_default();
+        let pos = r.pos.clone().unwrap_or_default();
+        f(&mut body, float(&alpha.start, 0.0));
+        f(&mut body, float(&pos.start, 0.0));
+        f(&mut body, float(&alpha.end, 0.0));
+        f(&mut body, float(&pos.end, 0.0));
+        f(&mut body, float(&r.fade_direction, 0.0));
+    }
+    let mut out = bits.to_le_bytes().to_vec();
+    out.extend_from_slice(&body);
+    out
+}
+
+struct Reader<'a> {
+    bytes: &'a [u8],
+    at: usize,
+}
+
+impl Reader<'_> {
+    fn u32(&mut self) -> Option<u32> {
+        let v = self.bytes.get(self.at..self.at + 4)?;
+        self.at += 4;
+        Some(u32::from_le_bytes(v.try_into().ok()?))
+    }
+    fn i32(&mut self) -> Option<i32> {
+        self.u32().map(|v| v as i32)
+    }
+    fn f32(&mut self) -> Option<f32> {
+        self.u32().map(f32::from_bits)
+    }
+    fn color(&mut self) -> Option<EffectColor> {
+        // RGB(0)·CMYK(1) 밖의 색상 종류는 값의 길이를 확인하지 못했다.
+        let kind = self.i32()?;
+        let value = self.u32()?;
+        let count = self.u32()?;
+        if !(0..=1).contains(&kind) || count > 64 {
+            return None;
+        }
+        let mut transforms = Vec::new();
+        for _ in 0..count {
+            let k = self.i32()?;
+            let v = self.f32()?;
+            let name = COLOR_EFFECTS.iter().find(|(_, n)| *n == k)?.0;
+            transforms.push(EffectColorTransform {
+                kind: name.to_owned(),
+                value: v.to_string(),
+            });
+        }
+        if kind == 1 {
+            return None;
+        }
+        Some(EffectColor {
+            color_type: Some("RGB".to_owned()),
+            scheme_idx: Some("-1".to_owned()),
+            system_idx: Some("-1".to_owned()),
+            preset_idx: Some("-1".to_owned()),
+            rgb: Some(EffectRgb {
+                r: Some(((value >> 16) & 0xff).to_string()),
+                g: Some(((value >> 8) & 0xff).to_string()),
+                b: Some((value & 0xff).to_string()),
+            }),
+            transforms,
+        })
+    }
+}
+
+/// HWP5 그림 효과 정보를 읽는다. (효과, 읽은 바이트 수). 모르는 효과 비트나 색상 종류가
+/// 있으면 `None`: 호출자는 원본 바이트를 그대로 둔다.
+pub fn decode(bytes: &[u8]) -> Option<(PictureEffects, usize)> {
+    let mut r = Reader { bytes, at: 0 };
+    let bits = r.u32()?;
+    if bits & !(SHADOW | GLOW | SOFT_EDGE | REFLECTION) != 0 {
+        return None;
+    }
+    let mut effects = PictureEffects::default();
+    let align_name = |v: i32| ALIGN_STYLES.get(v as usize).map(|s| (*s).to_owned());
+    if bits & SHADOW != 0 {
+        let style = r.i32()?;
+        let alpha = r.f32()?;
+        let radius = r.f32()?;
+        let direction = r.f32()?;
+        let distance = r.f32()?;
+        let align_style = r.i32()?;
+        let (skew_x, skew_y, scale_x, scale_y) = (r.f32()?, r.f32()?, r.f32()?, r.f32()?);
+        let rotation = r.i32()?;
+        let color = r.color()?;
+        effects.shadow = Some(PictureShadow {
+            style: Some(if style == 1 { "INSIDE" } else { "OUTSIDE" }.to_owned()),
+            alpha: text(alpha),
+            radius: text(radius),
+            direction: text(direction),
+            distance: text(distance),
+            align_style: align_name(align_style),
+            rotation_style: Some(rotation.to_string()),
+            skew: Some(EffectPoint {
+                x: text(skew_x),
+                y: text(skew_y),
+            }),
+            scale: Some(EffectPoint {
+                x: text(scale_x),
+                y: text(scale_y),
+            }),
+            color: Some(color),
+        });
+    }
+    if bits & GLOW != 0 {
+        let alpha = r.f32()?;
+        let radius = r.f32()?;
+        let color = r.color()?;
+        effects.glow = Some(PictureGlow {
+            alpha: text(alpha),
+            radius: text(radius),
+            color: Some(color),
+        });
+    }
+    if bits & SOFT_EDGE != 0 {
+        effects.soft_edge = Some(PictureSoftEdge {
+            radius: text(r.f32()?),
+        });
+    }
+    if bits & REFLECTION != 0 {
+        let align_style = r.i32()?;
+        let (radius, direction, distance) = (r.f32()?, r.f32()?, r.f32()?);
+        let (skew_x, skew_y, scale_x, scale_y) = (r.f32()?, r.f32()?, r.f32()?, r.f32()?);
+        let rotation = r.i32()?;
+        let (alpha_start, pos_start, alpha_end, pos_end) = (r.f32()?, r.f32()?, r.f32()?, r.f32()?);
+        let fade = r.f32()?;
+        effects.reflection = Some(PictureReflection {
+            align_style: align_name(align_style),
+            radius: text(radius),
+            direction: text(direction),
+            distance: text(distance),
+            rotation_style: Some(rotation.to_string()),
+            fade_direction: text(fade),
+            skew: Some(EffectPoint {
+                x: text(skew_x),
+                y: text(skew_y),
+            }),
+            scale: Some(EffectPoint {
+                x: text(scale_x),
+                y: text(scale_y),
+            }),
+            alpha: Some(EffectRange {
+                start: text(alpha_start),
+                end: text(alpha_end),
+            }),
+            pos: Some(EffectRange {
+                start: text(pos_start),
+                end: text(pos_end),
+            }),
+        });
+    }
+    Some((effects, r.at))
+}
