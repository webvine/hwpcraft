+    /// `2025 행정업무운영 편람(최종).hwp` 는 `.hwpx` 와 같은 형제 문단 관계로 빈 쪽을
+    /// 소유한다. 한글 2024 PDF(두 형식 모두)는 부록 표지 뒤 310쪽을 빈 쪽으로 두고,
+    /// 별표 4 설계 기준 표 뒤에는 빈 쪽 없이 다음 서식을 375쪽에 놓는다.
+    #[test]
+    fn handbook_hwp_blank_page_owners_follow_hwpx_contract() {
+        let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+            .join("samples/2025 행정업무운영 편람(최종).hwp");
+        let Ok(bytes) = std::fs::read(&path) else {
+            eprintln!("skip: {} 없음", path.display());
+            return;
+        };
+        let core = crate::document_core::DocumentCore::from_bytes(&bytes).expect("parse handbook");
+        let page_with_only = |section: usize, para: usize| {
+            core.pagination[section].pages.iter().any(|page| {
+                let items: Vec<&PageItem> = page
+                    .column_contents
+                    .iter()
+                    .flat_map(|column| &column.items)
+                    .collect();
+                matches!(
+                    items.as_slice(),
+                    [PageItem::FullParagraph { para_index }] if *para_index == para
+                )
+            })
+        };
+        // 구역 11: 부록 표지(Group + PageHide) 뒤 PageHide 문단 p2 가 빈 쪽을 소유한다.
+        assert!(
+            page_with_only(11, 2),
+            "구역 11 p2 의 빈 쪽이 없다 (한글 PDF 310쪽)"
+        );
+        // 구역 12: 빈 ColumnBreak p17 은 다음 PageBreak 표의 carrier 이지 별도 쪽이 아니다.
+        assert!(
+            !page_with_only(12, 17),
+            "구역 12 p17 이 빈 쪽을 만든다 (한글 PDF에는 없음)"
+        );
+    }
 }
