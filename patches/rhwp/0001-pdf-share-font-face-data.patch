+/// 파일 글꼴을 한 번만 메모리 매핑해 모든 면이 공유하게 한다.
+///
+/// usvg는 글리프마다 `with_face_data`를 부르고, `Source::File` 면은 그때마다
+/// 파일을 다시 매핑·파싱한다. 큰 문서(텍스트 20만 개)에서는 PDF 내보내기 시간의
+/// 대부분이 여기에 든다. 매핑에 실패한 면은 기존처럼 파일 면으로 남는다.
+#[cfg(not(target_arch = "wasm32"))]
+fn share_face_data(fontdb: &mut usvg::fontdb::Database) {
+    let ids: Vec<_> = fontdb.faces().map(|face| face.id).collect();
+    for id in ids {
+        // SAFETY: 매핑은 내보내기 동안만 쓰이는 이 DB가 소유한다. 내보내기 도중
+        // 다른 프로세스가 같은 글꼴 파일을 바꾸거나 지우면 잘못된 데이터를 읽을 수
+        // 있다는 위험은 fontdb 문서에 적힌 그대로 받아들인다(시스템 글꼴 폴더).
+        unsafe {
+            fontdb.make_shared_face_data(id);
+        }
+    }
+}
