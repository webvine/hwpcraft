+#[cfg(test)]
+mod hwpcraft_paragraph_restore_tests {
+    use crate::document_core::DocumentCore;
+
+    /// A height the measurer never gives; a kept measurement shows it after a restore.
+    const MARK: f64 = -12345.0;
+
+    /// One section of `count` paragraphs, 1 to 25 short words long.
+    fn report(count: usize) -> DocumentCore {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        for i in 0..count {
+            let text = "가나다라 마바사 ".repeat(i % 5 * 6 + 1);
+            core.insert_text_native(0, i, 0, &text).unwrap();
+            if i + 1 < count {
+                core.split_paragraph_native(0, i, text.chars().count(), None)
+                    .unwrap();
+            }
+        }
+        core
+    }
+
+    fn mark_measured(core: &mut DocumentCore) {
+        for para in &mut core.measured_sections[0].fallback_paragraphs {
+            para.total_height = MARK;
+        }
+    }
+
+    /// The paragraphs whose measurement the restore kept.
+    fn kept(core: &DocumentCore) -> Vec<usize> {
+        core.measured_sections[0]
+            .fallback_paragraphs
+            .iter()
+            .enumerate()
+            .filter_map(|(i, p)| (p.total_height == MARK).then_some(i))
+            .collect()
+    }
+
+    fn pages(core: &DocumentCore) -> Vec<String> {
+        (0..core.page_count())
+            .map(|page| core.render_page_svg_native(page).expect("svg"))
+            .collect()
+    }
+
+    fn rebuilt(core: &DocumentCore) -> Vec<String> {
+        let mut fresh = DocumentCore::new_empty();
+        fresh.create_blank_document_native().unwrap();
+        fresh.set_document(core.document().clone());
+        pages(&fresh)
+    }
+
+    /// Undo and redo of typing lay out only the typed paragraph again; every page
+    /// equals a full rebuild of the same document.
+    #[test]
+    fn undo_of_typing_rebuilds_only_the_typed_paragraph() {
+        let mut core = report(40);
+        let before = core.save_snapshot_native();
+        core.insert_text_native(0, 20, 1, "가").unwrap();
+        let after = core.save_snapshot_native();
+        mark_measured(&mut core);
+        core.restore_snapshot_native(before).unwrap();
+        let others: Vec<usize> = (0..40).filter(|&i| i != 20).collect();
+        assert_eq!(kept(&core), others);
+        assert_eq!(pages(&core), rebuilt(&core));
+        mark_measured(&mut core);
+        core.restore_snapshot_native(after).unwrap();
+        assert_eq!(kept(&core), others);
+        assert_eq!(pages(&core), rebuilt(&core));
+    }
+
+    /// Undo of a split and of a merge keep the paragraphs before the change. The ones
+    /// after it here carry shifted stored vertical positions, so they are laid out
+    /// again too.
+    #[test]
+    fn undo_of_split_and_merge_keeps_the_paragraphs_before_them() {
+        let mut core = report(40);
+        let before = core.save_snapshot_native();
+        core.split_paragraph_native(0, 10, 2, None).unwrap();
+        mark_measured(&mut core);
+        core.restore_snapshot_native(before).unwrap();
+        assert_eq!(kept(&core), (0..10).collect::<Vec<_>>());
+        assert_eq!(pages(&core), rebuilt(&core));
+
+        let before = core.save_snapshot_native();
+        core.merge_paragraph_native(0, 30).unwrap();
+        mark_measured(&mut core);
+        core.restore_snapshot_native(before).unwrap();
+        assert_eq!(kept(&core), (0..29).collect::<Vec<_>>());
+        assert_eq!(pages(&core), rebuilt(&core));
+    }
+
+    /// In a stored document the paragraphs on later pages keep their stored vertical
+    /// positions: undo and redo of a split keep them at their shifted places.
+    #[test]
+    fn undo_of_a_split_keeps_the_paragraphs_on_later_pages() {
+        let mut core =
+            DocumentCore::from_bytes(include_bytes!("../../../samples/20250130-hongbo.hwp"))
+                .expect("open");
+        let count = core.document().sections[0].paragraphs.len();
+        let para = (0..count)
+            .find(|&i| {
+                core.document().sections[0].paragraphs[i]
+                    .text
+                    .chars()
+                    .count()
+                    >= 2
+            })
+            .expect("text");
+        let before = core.save_snapshot_native();
+        core.split_paragraph_native(0, para, 1, None).unwrap();
+        let after = core.save_snapshot_native();
+        mark_measured(&mut core);
+        core.restore_snapshot_native(before).unwrap();
+        assert!(kept(&core).iter().any(|&i| i > para), "{:?}", kept(&core));
+        assert_eq!(pages(&core), rebuilt(&core));
+        mark_measured(&mut core);
+        core.restore_snapshot_native(after).unwrap();
+        assert!(
+            kept(&core).iter().any(|&i| i > para + 1),
+            "{:?}",
+            kept(&core)
+        );
+        assert_eq!(pages(&core), rebuilt(&core));
+    }
+
+    /// A paragraph that differs only in its session-edit mark is laid out again: the
+    /// mark is not serialized but changes the paragraph's layout rules.
+    #[test]
+    fn a_paragraph_differing_only_in_its_edit_mark_is_laid_out_again() {
+        let mut core = report(10);
+        let before = core.save_snapshot_native();
+        let para = &mut core.document.sections[0].paragraphs[4];
+        para.edited_in_session = !para.edited_in_session;
+        core.stamp_section_changed(0);
+        core.paginate();
+        mark_measured(&mut core);
+        core.restore_snapshot_native(before).unwrap();
+        assert!(!kept(&core).contains(&4));
+        assert_eq!(pages(&core), rebuilt(&core));
+    }
+
