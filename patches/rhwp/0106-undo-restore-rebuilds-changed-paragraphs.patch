+        assert!(core.pagination[0]
+            .pre_emitted_host_heights
+            .contains_key(&usize::MAX));
+    }
+
+    /// Undo and redo of typing in a table cell of a stored document lay out only the
+    /// table's paragraph again and equal a full rebuild. The edit marks the table as
+    /// reflowed (`text_reflowed_tables`, keyed by address): only paragraphs whose
+    /// tables differ in that mark are laid out again.
+    #[test]
+    fn undo_of_a_cell_edit_equals_a_full_rebuild() {
+        let mut core =
+            DocumentCore::from_bytes(include_bytes!("../../../samples/20250130-hongbo.hwp"))
+                .expect("open");
+        let (para, ctrl) = core.document().sections[0]
+            .paragraphs
+            .iter()
+            .enumerate()
+            .find_map(|(i, p)| {
+                p.controls
+                    .iter()
+                    .position(|c| matches!(c, crate::model::control::Control::Table(_)))
+                    .map(|c| (i, c))
+            })
+            .expect("table");
+        let opened = pages(&core);
+        let before = core.save_snapshot_native();
+        core.insert_text_in_cell_native(0, para, ctrl, 0, 0, 0, "가")
+            .unwrap();
+        let after = core.save_snapshot_native();
+        let count = core.document().sections[0].paragraphs.len();
+        let others: Vec<usize> = (0..count).filter(|&i| i != para).collect();
+        mark_measured(&mut core);
+        core.restore_snapshot_native(before).unwrap();
+        assert_eq!(kept(&core), others);
+        assert_eq!(pages(&core), opened);
+        assert_eq!(pages(&core), rebuilt(&core));
+        mark_measured(&mut core);
+        core.restore_snapshot_native(after).unwrap();
+        assert_eq!(kept(&core), others);
+        assert_eq!(pages(&core), rebuilt(&core));
+    }
+}
