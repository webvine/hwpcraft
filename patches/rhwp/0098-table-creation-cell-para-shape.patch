+    #[test]
+    fn a_cell_para_shape_option_sets_every_cell_and_keeps_the_host() {
+        use crate::document_core::TableCreationOptions;
+        let mut core = core_with_shaped_paragraph();
+        let options = TableCreationOptions {
+            cell_para_shape_id: Some(0),
+            ..Default::default()
+        };
+        core.create_table_with_options_native(0, 0, 0, 2, 3, &options)
+            .unwrap();
+        let table = table_of(&core);
+        for cell in &table.cells {
+            assert_eq!(
+                cell.paragraphs[0].para_shape_id, 0,
+                "셀 ({},{})",
+                cell.row, cell.col
+            );
+            assert_eq!(
+                cell.paragraphs[0]
+                    .char_shapes
+                    .first()
+                    .map(|cs| cs.char_shape_id),
+                Some(7)
+            );
+        }
+        let host = core.document.sections[0]
+            .paragraphs
+            .iter()
+            .find(|p| p.controls.iter().any(|c| matches!(c, Control::Table(_))))
+            .unwrap();
+        assert_eq!(host.para_shape_id, 12, "표를 담은 문단은 커서 문단 상속");
+
+        let mut core = core_with_shaped_paragraph();
