+            cell_para_shape_id: Some(u16::MAX),
+            ..Default::default()
+        };
+        assert!(core
+            .create_table_with_options_native(0, 0, 0, 2, 3, &options)
+            .is_err());
+        assert_eq!(core.document.sections[0].paragraphs.len(), before);
+        assert_eq!(
+            core.document.doc_info.border_fills.len(),
+            fills,
+            "DocInfo 그대로"
+        );
+    }
