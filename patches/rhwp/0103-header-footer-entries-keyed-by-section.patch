+#[cfg(test)]
+mod hwpcraft_header_footer_entries_tests {
+    use super::*;
+
+    /// [HwpCraft 0103] The kept list is keyed by the section index too: the same
+    /// paragraph list seen at another index (a section inserted or removed before it)
+    /// is collected again, so its references name the index it is at now.
+    #[test]
+    fn a_section_seen_at_another_index_is_collected_again() {
+        let core = crate::document_core::DocumentCore::from_bytes(include_bytes!(
+            "../../../samples/issue5802/hf_cross_section_inherit.hwp"
+        ))
+        .expect("open");
+        let doc = core.document();
+        let (idx, section) = doc
+            .sections
+            .iter()
+            .enumerate()
+            .find(|(i, s)| !collect_header_footer_entries(*i, s).is_empty())
+            .expect("a section with a header or footer");
+        let mut cache = None;
+        let at = |cache: &mut Option<HeaderFooterEntries>, i: usize| {
+            header_footer_entries_cached(i, section, cache, false)
+                .entries
+                .iter()
+                .map(|e| e.1.source_section_index)
+                .collect::<Vec<_>>()
+        };
+        assert!(at(&mut cache, idx).iter().all(|&i| i == idx));
+        let other = idx + 7;
+        assert!(at(&mut cache, other).iter().all(|&i| i == other));
+    }
+}
