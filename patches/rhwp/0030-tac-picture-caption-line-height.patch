+/// 글자처럼 그림의 위·아래 캡션이 차지하는 세로 길이(HWPUNIT) — 간격 + 캡션 문단 높이.
+/// 렌더러는 그림·캡션 상자(`tac_object_box_height_px`)를 줄 baseline 에 앉히므로 줄
+/// 높이도 같은 상자로 세야 다음 줄이 캡션을 덮지 않는다. 좌·우 캡션은 높이를 늘리지 않는다.
+fn tac_picture_caption_extent_hwp(pic: &crate::model::image::Picture) -> i32 {
+    use crate::model::shape::CaptionDirection;
+    let Some(cap) = &pic.caption else {
+        return 0;
+    };
+    if !matches!(
+        cap.direction,
+        CaptionDirection::Top | CaptionDirection::Bottom
+    ) || cap.paragraphs.is_empty()
+    {
+        return 0;
+    }
+    // 7200 dpi 의 px 는 HWPUNIT 과 같다.
+    let height = crate::renderer::composer::caption_height_px(&pic.caption, 7200.0).round() as i32;
+    if height <= 0 {
+        return 0;
+    }
+    i32::from(cap.spacing).saturating_add(height)
+}
