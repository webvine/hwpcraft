+/// 쪽마다 `start`부터 각주 번호를 다시 매긴다. 앞 쪽에서 이어진 각주 조각(번호를 그리지
+/// 않는 조각)은 앞 쪽에서 받은 번호를 그대로 쓰고 새 번호를 쓰지 않는다.
+fn renumber_footnotes_per_page(result: &mut PaginationResult, start: u16) {
+    let mut previous: Vec<(crate::renderer::pagination::FootnoteSource, u16)> = Vec::new();
+    for page in &mut result.pages {
+        let mut current = Vec::with_capacity(page.footnotes.len());
+        let mut next = start.max(1);
+        for footnote in &mut page.footnotes {
+            let continued = footnote.fragment.is_some_and(|f| !f.draw_number);
+            let carried = continued
+                .then(|| previous.iter().find(|(s, _)| *s == footnote.source))
+                .flatten()
+                .map(|(_, n)| *n);
+            footnote.number = carried.unwrap_or_else(|| {
+                let n = next;
+                next = next.saturating_add(1);
+                n
+            });
+            current.push((footnote.source.clone(), footnote.number));
+        }
+        previous = current;
+    }
+}
