+
+/// 한 쪽을 조판하는 동안 본문 각주 표시가 그 쪽의 각주 번호를 쓰게 한다. 놓으면 이전
+/// 상태로 돌아간다.
+pub(super) struct PageFootnoteNumbers(Vec<(usize, u16)>);
+
+impl PageFootnoteNumbers {
+    pub(super) fn install(footnotes: &[FootnoteRef], paragraphs: &[Paragraph]) -> Self {
+        let numbers: Vec<(usize, u16)> = footnotes
+            .iter()
+            .filter_map(|fn_ref| {
+                let control = footnote_control(fn_ref, paragraphs)?;
+                (control.number != fn_ref.number)
+                    .then(|| (control as *const Footnote as usize, fn_ref.number))
+            })
+            .collect();
+        Self(PAGE_FOOTNOTE_NUMBERS.with(|cell| cell.replace(numbers)))
+    }
+}
+
+impl Drop for PageFootnoteNumbers {
+    fn drop(&mut self) {
+        let previous = std::mem::take(&mut self.0);
+        PAGE_FOOTNOTE_NUMBERS.with(|cell| *cell.borrow_mut() = previous);
+    }
+}
+
+/// 이 쪽에서 `footnote`에 매긴 번호(저장 번호와 같으면 `None`).
+pub(super) fn page_footnote_number(footnote: &Footnote) -> Option<u16> {
+    let key = footnote as *const Footnote as usize;
+    PAGE_FOOTNOTE_NUMBERS.with(|cell| {
+        cell.borrow()
+            .iter()
+            .find(|(k, _)| *k == key)
+            .map(|(_, n)| *n)
+    })
+}
