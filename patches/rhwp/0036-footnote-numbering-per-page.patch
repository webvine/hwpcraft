+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        let result = &mut core.pagination[0];
+        let page = result.pages[0].clone();
+        result.pages = vec![page.clone(), page.clone(), page];
+        let split = |draw_number| {
+            Some(FootnoteFragment {
+                start_line: 0,
+                end_line: 1,
+                draw_separator: true,
+                draw_number,
+            })
+        };
+        result.pages[0].footnotes = vec![note(0, None), note(1, None), note(2, split(true))];
+        result.pages[1].footnotes = vec![note(2, split(false)), note(3, None)];
+        result.pages[2].footnotes = vec![note(4, None)];
+        renumber_footnotes_per_page(result, 1);
+        let numbers: Vec<Vec<u16>> = result
+            .pages
+            .iter()
+            .map(|p| p.footnotes.iter().map(|f| f.number).collect())
+            .collect();
+        assert_eq!(numbers, [vec![1, 2, 3], vec![3, 1], vec![1]]);
+    }
+}
