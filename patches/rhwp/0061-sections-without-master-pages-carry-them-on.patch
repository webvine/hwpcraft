+#[cfg(test)]
+mod master_page_carry_tests {
+    use crate::document_core::DocumentCore;
+    use crate::model::header_footer::{HeaderFooterApply, MasterPage};
+
+    /// 바탕쪽이 없는 뒤 구역은 앞 구역의 바탕쪽을 쓴다(HwpCraft 패치 0061).
+    #[test]
+    fn a_section_without_master_pages_carries_the_previous_ones_on() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        let mut doc = core.document().clone();
+        let mut first = doc.sections[0].clone();
+        let second = first.clone();
+        first.section_def.master_pages = vec![MasterPage {
+            apply_to: HeaderFooterApply::Both,
+            ..Default::default()
+        }];
+        doc.sections = vec![first, second];
+        core.set_document(doc);
+        let refs: Vec<Option<(usize, usize)>> = core
+            .pagination
+            .iter()
+            .flat_map(|r| r.pages.iter())
+            .map(|p| {
+                p.active_master_page
+                    .as_ref()
+                    .map(|m| (m.section_index, m.master_page_index))
+            })
+            .collect();
+        assert_eq!(refs, [Some((0, 0)), Some((0, 0))]);
+    }
+}
