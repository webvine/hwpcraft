+/// 조판 진단(`LAYOUT_OVERFLOW`, `LAYOUT_OVERFLOW_CELL`, `LAYOUT_OVERFLOW_DRAW`,
+/// `LAYOUT_TABLE_OVERLAP`)을 stderr 에 출력할지.
+/// 0 = 끔, 1 = 켬, 2 = 아직 정하지 않음(처음 쓸 때 `RHWP_LAYOUT_DIAG` 로 정한다).
+static LAYOUT_DIAGNOSTICS: std::sync::atomic::AtomicU8 = std::sync::atomic::AtomicU8::new(2);
+
+/// 조판 진단의 stderr 출력을 켜거나 끈다. 기본은 켬이며 `RHWP_LAYOUT_DIAG=0` 이면 끈 채로
+/// 시작한다. 진단 값은 출력과 상관없이 [`LayoutEngine::take_overflows`] ·
+/// [`LayoutEngine::take_table_overlaps`] 로 계속 모은다. stderr 를 로그로 넘기는
+/// 프로그램(예: stdio MCP 서버)이 시작할 때 끄려는 용도다.
+pub fn set_layout_diagnostics(enabled: bool) {
+    LAYOUT_DIAGNOSTICS.store(u8::from(enabled), std::sync::atomic::Ordering::Relaxed);
+}
+
+fn layout_diagnostics_enabled() -> bool {
+    use std::sync::atomic::Ordering;
+    match LAYOUT_DIAGNOSTICS.load(Ordering::Relaxed) {
+        0 => false,
+        1 => true,
+        _ => {
+            let enabled = std::env::var_os("RHWP_LAYOUT_DIAG").is_none_or(|value| value != "0");
+            // 그 사이 set_layout_diagnostics 가 정했다면 그 값을 따른다.
+            let _ = LAYOUT_DIAGNOSTICS.compare_exchange(
+                2,
+                u8::from(enabled),
+                Ordering::Relaxed,
+                Ordering::Relaxed,
+            );
+            LAYOUT_DIAGNOSTICS.load(Ordering::Relaxed) == 1
+        }
+    }
+}
+
 /// 레이아웃 엔진
