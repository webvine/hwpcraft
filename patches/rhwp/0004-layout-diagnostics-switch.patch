     }
 
@@ -3991,7 +4025,9 @@ impl LayoutEngine {
 
     /// [#4515] 최상위 표 y 겹침 기록
     fn record_table_overlap(&self, overlap: LayoutTableOverlap) {
-        eprintln!("{}", overlap);
+        if layout_diagnostics_enabled() {
