+#[test]
+fn insert_column_copies_the_reference_columns_vertical_merge() {
+    // 3×3, c1 r0-1 합침: 오른쪽에 넣으면 새 c2는 r0에 [2x1], r2는 1×1.
+    let mut t = merged(3, 3, &[(0, 1, 1, 1)]);
+    t.insert_column(1, true).unwrap();
+    let l = layout(&t);
+    assert!(
+        l.contains(&(0, 2, 2, 1)) && l.contains(&(2, 2, 1, 1)),
+        "{l:?}"
+    );
+    assert_eq!(t.cell_at(0, 2).unwrap().height, 2000, "두 줄 높이");
+    assert_grid_covered(&t);
+    // 첫 칸 왼쪽: c0 r0-1 합침 → 새 c0도 r0에 [2x1].
+    let mut t = merged(3, 3, &[(0, 0, 1, 0)]);
+    t.insert_column(0, false).unwrap();
+    let l = layout(&t);
+    assert!(
+        l.contains(&(0, 0, 2, 1)) && l.contains(&(0, 1, 2, 1)),
+        "{l:?}"
+    );
+    assert_grid_covered(&t);
+    // 마지막 칸 전체 합침, 오른쪽에 넣으면 새 칸도 [3x1].
+    let mut t = merged(3, 3, &[(0, 2, 2, 2)]);
+    t.insert_column(2, true).unwrap();
+    assert!(layout(&t).contains(&(0, 3, 3, 1)));
+    assert_grid_covered(&t);
+    // 2×2 합침의 오른쪽 끝 칸 오른쪽: 새 칸은 r1에 [2x1].
+    let mut t = merged(4, 4, &[(1, 1, 2, 2)]);
+    t.insert_column(2, true).unwrap();
+    let l = layout(&t);
+    assert!(
+        l.contains(&(1, 1, 2, 2)) && l.contains(&(1, 3, 2, 1)),
+        "{l:?}"
+    );
+    assert_grid_covered(&t);
+}
