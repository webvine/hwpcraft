+#[test]
+fn insert_row_below_a_2x2_merge_copies_its_column_span() {
+    // 4×4, r1-2 c1-2 합침: 마지막 줄(r2) 아래에 넣으면 새 r3은 c1에 [1x2],
+    // 첫 줄(r1) 위에 넣어도 새 r1은 c1에 [1x2]. 병합 셀 자체는 그대로.
+    let mut t = merged(4, 4, &[(1, 1, 2, 2)]);
+    t.insert_row(2, true).unwrap();
+    let l = layout(&t);
+    assert!(l.contains(&(1, 1, 2, 2)), "{l:?}");
+    assert!(l.contains(&(3, 1, 1, 2)), "{l:?}");
+    assert_grid_covered(&t);
+
+    let mut t = merged(4, 4, &[(1, 1, 2, 2)]);
+    t.insert_row(1, false).unwrap();
+    let l = layout(&t);
+    assert!(l.contains(&(1, 1, 1, 2)), "{l:?}");
+    assert!(l.contains(&(2, 1, 2, 2)), "{l:?}");
+    assert_grid_covered(&t);
+}
