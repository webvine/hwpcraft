+/// [HwpCraft 0111] 새 줄(칸)의 `at` 자리에 놓을 셀의 병합 폭: 기준 줄의 폭을
+/// 쓰되, 그 폭 안에 이미 다른 병합 셀이 덮는 자리가 있으면(손상된 표) 1.
+fn copied_span(reference_spans: &[u16], covered: &[bool], at: u16) -> u16 {
+    let span = reference_spans
+        .get(at as usize)
+        .copied()
+        .unwrap_or(1)
+        .max(1);
+    let end = (at as usize + span as usize).min(covered.len());
+    if covered[at as usize..end].iter().any(|c| *c) || end - (at as usize) != span as usize {
+        1
+    } else {
+        span
+    }
+}
