+// === [HwpCraft 0111] 줄/칸 추가가 기준 줄(칸)의 병합을 복사 (한글 2024 실측) ===
+
+/// 셀 배치를 (row, col, row_span, col_span) 목록으로, 행 우선 순서.
+fn layout(table: &Table) -> Vec<(u16, u16, u16, u16)> {
+    let mut v: Vec<_> = table
+        .cells
+        .iter()
+        .map(|c| (c.row, c.col, c.row_span, c.col_span))
+        .collect();
+    v.sort();
+    v
+}
+
+/// 표 격자가 빈틈·겹침 없이 모든 칸을 정확히 한 번 덮는지.
+fn assert_grid_covered(table: &Table) {
+    let mut seen = vec![0u8; table.row_count as usize * table.col_count as usize];
+    for c in &table.cells {
+        for r in c.row..c.row + c.row_span {
+            for k in c.col..c.col + c.col_span {
+                seen[r as usize * table.col_count as usize + k as usize] += 1;
+            }
+        }
+    }
+    assert!(
+        seen.iter().all(|n| *n == 1),
+        "격자 덮기: {:?}",
+        layout(table)
+    );
+    let counts: Vec<i16> = (0..table.row_count)
+        .map(|r| table.cells.iter().filter(|c| c.row == r).count() as i16)
+        .collect();
+    assert_eq!(table.row_sizes, counts);
+}
+
+fn merged(rows: u16, cols: u16, merges: &[(u16, u16, u16, u16)]) -> Table {
+    let mut t = make_table(rows, cols);
+    for (r0, c0, r1, c1) in merges {
+        t.merge_cells(*r0, *c0, *r1, *c1).unwrap();
+    }
+    t
+}
+
+#[test]
+fn insert_row_copies_the_reference_rows_horizontal_merge() {
+    // 3×3, r1 c0-1 합침. 아래·위 어느 쪽에 넣어도 새 줄은 c0에 [1x2].
+    for below in [true, false] {
+        let mut t = merged(3, 3, &[(1, 0, 1, 1)]);
+        t.insert_row(1, below).unwrap();
+        let new_row = if below { 2 } else { 1 };
+        let old_row = if below { 1 } else { 2 };
+        let l = layout(&t);
+        assert!(l.contains(&(new_row, 0, 1, 2)), "below={below}: {l:?}");
+        assert!(l.contains(&(new_row, 2, 1, 1)), "below={below}: {l:?}");
+        assert!(l.contains(&(old_row, 0, 1, 2)), "below={below}: {l:?}");
+        let cell = t.cell_at(new_row, 0).unwrap();
+        assert_eq!(cell.width, 7200, "두 칸 너비");
+        assert_eq!(cell.paragraphs.len(), 1);
+        assert!(cell.paragraphs[0].text.is_empty());
+        assert_eq!(t.row_count, 4);
+        assert_grid_covered(&t);
+    }
+}
