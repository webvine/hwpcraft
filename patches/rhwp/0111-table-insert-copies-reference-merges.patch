+#[test]
+fn copied_merge_inherits_like_a_plain_new_cell() {
+    // 병합을 복사한 셀도 1×1 새 셀과 같은 템플릿(테두리·여백·문단 모양)을 쓴다.
+    let mut t = merged(3, 3, &[(1, 0, 1, 1)]);
+    for c in t.cells.iter_mut() {
+        c.border_fill_id = 5;
+        c.padding.left = 141;
+        c.vertical_align = VerticalAlign::Bottom;
+        c.paragraphs[0].para_shape_id = 12;
+    }
+    t.insert_row(1, true).unwrap();
+    let copied = t.cell_at(2, 0).unwrap();
+    let plain = t.cell_at(2, 2).unwrap();
+    assert_eq!((copied.row_span, copied.col_span), (1, 2));
+    assert_eq!(copied.border_fill_id, plain.border_fill_id);
+    assert_eq!(copied.border_fill_id, 5);
+    assert_eq!(copied.padding.left, 141);
+    assert_eq!(copied.vertical_align, plain.vertical_align);
+    assert_eq!(copied.paragraphs[0].para_shape_id, 12);
+    assert_eq!(copied.height, plain.height);
+}
