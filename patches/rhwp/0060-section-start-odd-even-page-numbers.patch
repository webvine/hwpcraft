+
+    /// 구역 시작 쪽 번호 종류 홀수·짝수: 이어지는 번호가 그 홀짝이 되도록 하나 건너뛴다.
+    /// 빈 쪽은 넣지 않는다(한글 2024 실측, HwpCraft 패치 0060).
+    #[test]
+    fn odd_or_even_section_start_skips_one_number_without_a_blank_page() {
+        let numbers = |kinds: [u8; 3]| -> Vec<u32> {
+            let mut core = DocumentCore::new_empty();
+            core.create_blank_document_native().unwrap();
+            let mut doc = core.document().clone();
+            let base = doc.sections[0].clone();
+            doc.sections = vec![base.clone(), base.clone(), base];
+            for (section, kind) in doc.sections.iter_mut().zip(kinds) {
+                section.section_def.page_num_type = kind;
+            }
+            core.set_document(doc);
+            core.pagination
+                .iter()
+                .flat_map(|r| r.pages.iter().map(|p| p.page_number))
+                .collect()
+        };
+        assert_eq!(numbers([0, 0, 0]), [1, 2, 3], "이어서");
+        assert_eq!(numbers([0, 1, 0]), [1, 3, 4], "둘째 구역 홀수: 2 → 3");
+        assert_eq!(numbers([0, 2, 0]), [1, 2, 3], "둘째 구역 짝수: 이미 짝수");
+        assert_eq!(numbers([0, 0, 2]), [1, 2, 4], "셋째 구역 짝수: 3 → 4");
+        assert_eq!(numbers([2, 0, 0]), [2, 3, 4], "첫 구역 짝수: 1 → 2");
+    }
 }
 
