+#[cfg(test)]
+mod document_end_endnote_tests {
+    use crate::document_core::DocumentCore;
+    use crate::model::control::Control;
+
+    /// Two sections of 20 paragraphs each, endnotes placed at the end of the document.
+    fn two_sections() -> DocumentCore {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        for i in 0..20 {
+            let text = "가나다라 마바사 ".repeat(i % 5 * 6 + 1);
+            core.insert_text_native(0, i, 0, &text).unwrap();
+            if i + 1 < 20 {
+                core.split_paragraph_native(0, i, text.chars().count(), None)
+                    .unwrap();
+            }
+        }
+        let mut doc = core.document().clone();
+        let second = doc.sections[0].clone();
+        doc.sections.push(second);
+        core.set_document(doc);
+        core
+    }
+
+    fn pages(core: &DocumentCore) -> Vec<String> {
+        core.pagination
+            .iter()
+            .map(|section| {
+                format!(
+                    "{:?}",
+                    section
+                        .pages
+                        .iter()
+                        .map(|p| &p.column_contents)
+                        .collect::<Vec<_>>()
+                )
+            })
+            .collect()
+    }
+
+    fn fresh_pages(core: &DocumentCore) -> Vec<String> {
+        let mut fresh = DocumentCore::new_empty();
+        fresh.create_blank_document_native().unwrap();
+        fresh.set_document(core.document().clone());
+        pages(&fresh)
+    }
+
+    fn endnote_index(core: &DocumentCore) -> usize {
+        core.document().sections[0].paragraphs[3]
+            .controls
+            .iter()
+            .position(|c| matches!(c, Control::Endnote(_)))
+            .expect("endnote")
+    }
+
+    /// An endnote inserted, edited or deleted in an earlier section is laid out
+    /// again in the last section, which collects the document's endnotes.
+    #[test]
+    fn the_last_section_lays_out_again_when_an_earlier_endnote_changes() {
+        let mut core = two_sections();
+        let _ = core.page_count();
+        core.insert_endnote_native(0, 3, 0).unwrap();
+        assert!(pages(&core)[1].contains("EndnoteSeparator"));
+        assert_eq!(pages(&core), fresh_pages(&core), "insert");
+        let ci = endnote_index(&core);
+        core.insert_text_in_footnote_native(0, 3, ci, 0, 0, &"미주 본문 ".repeat(40))
+            .unwrap();
+        assert_eq!(pages(&core), fresh_pages(&core), "edit");
+        for (name, bytes) in [
+            ("hwp", core.export_hwp_native().unwrap()),
+            ("hwpx", core.export_hwpx_native().unwrap()),
+        ] {
+            let reopened = DocumentCore::from_bytes(&bytes).unwrap();
+            assert_eq!(pages(&reopened), pages(&core), "{name} reopened");
+        }
+        core.delete_control_native(0, 3, ci).unwrap();
+        assert!(!pages(&core)[1].contains("EndnoteSeparator"));
+        assert_eq!(pages(&core), fresh_pages(&core), "delete");
+    }
+}
